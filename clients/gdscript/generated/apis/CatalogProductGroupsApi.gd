		error.message = "Invalid length for `adAccountId`, must be smaller than or equal to 18."
		on_failure.call(error)
		return
	var bzz_adAccountId_regex := RegEx.new()
	bzz_adAccountId_regex.compile("/^\\d+$/".trim_prefix('/').trim_suffix('/'))
