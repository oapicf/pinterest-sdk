"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AdPinAnalytics"
package     = openapi_server
version     = "1.0"
description = "Defines a AdPinAnalytics"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  AdPinAnalytics {
    title = AdPinAnalytics
    description = AdPinAnalytics
    derivedFrom = Root
    properties {
        _date {
          type =  string
          description = "Current metrics date. Only returned when granularity is a time-based value (&#x60;DAY&#x60;, &#x60;HOUR&#x60;, &#x60;WEEK&#x60;, &#x60;MONTH&#x60;)"
          optional = false
        }
        pin_id {
          type =  string
          description = "The ID of the pin that the metric belongs to."
          optional = true
        }
    }
  }
}

serviceTemplates {

  AdPinAnalytics {
    title = AdPinAnalytics
    description = AdPinAnalytics
    implements = openapi_server.resourceTypes.AdPinAnalytics

  }
}
