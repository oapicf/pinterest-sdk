"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server OrderLineMutationResult"
package     = openapi_server
version     = "1.0"
description = "Defines a OrderLineMutationResult"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  OrderLine = openapi_server.resourceTypes.OrderLine
  OrderLineMutationError = openapi_server.resourceTypes.OrderLineMutationError
}
resourceTypes {

  OrderLineMutationResult {
    title = OrderLineMutationResult
    description = OrderLineMutationResult
    derivedFrom = Root
    properties {
        errors {
          type = array
          items.type = OrderLineMutationError
          description = "Error list if update(s) fail."
          optional = false
        }
        order_line {
          type = array
          items.type = OrderLine
          description = "Order Line object array."
          optional = false
        }
    }
  }
}

serviceTemplates {

  OrderLineMutationResult {
    title = OrderLineMutationResult
    description = OrderLineMutationResult
    implements = openapi_server.resourceTypes.OrderLineMutationResult

  }
}
