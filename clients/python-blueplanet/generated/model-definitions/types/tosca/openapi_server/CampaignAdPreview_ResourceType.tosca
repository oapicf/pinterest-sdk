"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CampaignAdPreview"
package     = openapi_server
version     = "1.0"
description = "Defines a CampaignAdPreview"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CampaignAdPreview {
    title = CampaignAdPreview
    description = CampaignAdPreview
    derivedFrom = Root
    properties {
        ad_account_id {
          type =  string
          description = "Advertiser ID for this preview."
          optional = true
        }
        ad_group_id {
          type =  string
          description = "Ad group ID to create a preview record for."
          optional = true
        }
        client_id {
          type =  integer
          description = "Client ID that created preview."
          optional = false
        }
        expires_at {
          type =  integer
          description = "Unix timestamp in milliseconds for preview expiration."
          optional = true
        }
        is_active {
          type =  boolean
          description = "Whether preview link is active."
          optional = true
        }
        pin_id {
          type =  integer
          description = "Pin ID for pin promotion preview."
          optional = false
        }
        pin_promotion_id {
          type =  integer
          description = "Pin promotion ID for this preview."
          optional = false
        }
        promoted_product_group_id {
          type =  integer
          description = "Promoted product group ID for catalog previews."
          optional = false
        }
        url {
          type =  string
          description = "Campaign ad preview URL."
          optional = true
        }
        user_id {
          type =  integer
          description = "User ID that created preview."
          optional = true
        }
        uuid {
          type =  string
          description = "Pin promotion preview key."
          optional = true
        }
    }
  }
}

serviceTemplates {

  CampaignAdPreview {
    title = CampaignAdPreview
    description = CampaignAdPreview
    implements = openapi_server.resourceTypes.CampaignAdPreview

  }
}
