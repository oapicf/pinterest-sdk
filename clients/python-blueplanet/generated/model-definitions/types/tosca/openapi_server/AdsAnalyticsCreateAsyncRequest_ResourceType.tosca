"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AdsAnalyticsCreateAsyncRequest"
package     = openapi_server
version     = "1.0"
description = "Defines a AdsAnalyticsCreateAsyncRequest"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  AdAdsAnalyticsAsyncTargetingTypes = openapi_server.resourceTypes.AdAdsAnalyticsAsyncTargetingTypes
  AdGroupSummaryStatus = openapi_server.resourceTypes.AdGroupSummaryStatus
  AdsAnalyticsMetricsFilter = openapi_server.resourceTypes.AdsAnalyticsMetricsFilter
  CampaignObjectiveType = openapi_server.resourceTypes.CampaignObjectiveType
  CampaignSummaryStatus = openapi_server.resourceTypes.CampaignSummaryStatus
  ConversionAttributionWindowDays = openapi_server.resourceTypes.ConversionAttributionWindowDays
  ConversionReportAttributionType = openapi_server.resourceTypes.ConversionReportAttributionType
  ConversionReportTimeType = openapi_server.resourceTypes.ConversionReportTimeType
  CustomConversionEventMetrics = openapi_server.resourceTypes.CustomConversionEventMetrics
  DataOutputFormat = openapi_server.resourceTypes.DataOutputFormat
  Granularity = openapi_server.resourceTypes.Granularity
  MetricsReportingLevel = openapi_server.resourceTypes.MetricsReportingLevel
  PinPromotionSummaryStatus = openapi_server.resourceTypes.PinPromotionSummaryStatus
  PrimarySort = openapi_server.resourceTypes.PrimarySort
  ProductGroupSummaryStatus = openapi_server.resourceTypes.ProductGroupSummaryStatus
  ReportingColumnAsync = openapi_server.resourceTypes.ReportingColumnAsync
  ReportingTimeZone = openapi_server.resourceTypes.ReportingTimeZone
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  AdsAnalyticsCreateAsyncRequest {
    title = AdsAnalyticsCreateAsyncRequest
    description = AdsAnalyticsCreateAsyncRequest
    derivedFrom = Root
    properties {
        ad_group_ids {
          type = array
          items.type =  string
          description = "List of ad group ids"
          optional = false
        }
        ad_group_statuses {
          type = array
          items.type = AdGroupSummaryStatus
          description = "List of values for filtering"
          optional = false
        }
        ad_ids {
          type = array
          items.type =  string
          description = "List of ad ids. This parameter is not supported for Product Item level reports."
          optional = false
        }
        ad_statuses {
          type = array
          items.type = PinPromotionSummaryStatus
          description = "List of values for filtering. This parameter is not supported for Product Item level reports."
          optional = false
        }
        attribution_types {
          type = array
          items.type = ConversionReportAttributionType
          description = "List of attribution types for the conversion report."
          optional = false
        }
        campaign_brand_label {
          type =  string
          description = "Campaign brand label for filtering."
          optional = false
        }
        campaign_custom_label {
          type =  string
          description = "Campaign custom label for filtering."
          optional = false
        }
        campaign_ids {
          type = array
          items.type =  string
          description = "List of campaign ids"
          optional = false
        }
        campaign_objective_types {
          type = array
          items.type = CampaignObjectiveType
          description = "List of values for filtering. [\&quot;WEB_SESSIONS\&quot;] is in BETA."
          optional = false
        }
        campaign_statuses {
          type = array
          items.type = CampaignSummaryStatus
          description = "List of status values for filtering"
          optional = false
        }
        click_window_days {
          type = ConversionAttributionWindowDays
          description = "Number of days to use as the conversion attribution window for a pin click action."
          optional = false
        }
        columns {
          type = array
          items.type = ReportingColumnAsync
          description = "Metric and entity columns. Pin promotion and ad related columns are not supported for Product Item level reports."
          optional = false
        }
        combine_targeting_types {
          type =  boolean
          description = "Determines if the targeting types included in the request should be consolidated into a single breakdown."
          optional = false
        }
        conversion_report_time {
          type = ConversionReportTimeType
          description = "Date dimension for conversion metrics."
          optional = false
        }
        custom_conversion_event_metrics {
          type = array
          items.type = CustomConversionEventMetrics
          description = "List of advertiser-defined custom conversion event metrics to include in the report"
          optional = false
        }
        end_date {
          type =  string
          description = "Metric report end date (UTC). Format: YYYY-MM-DD"
          optional = true
        }
        end_hour {
          type =  integer
          description = "Which hour of the end date to stop the report (inclusive). Only allowed for hourly reports."
          optional = false
        }
        engagement_window_days {
          type = ConversionAttributionWindowDays
          description = "Number of days to use as the conversion attribution window for an engagement action."
          optional = false
        }
        granularity {
          type = Granularity
          description = "  TOTAL - metrics are aggregated over the specified date range.   DAY - metrics are broken down daily.   HOUR - metrics are broken down hourly.   WEEKLY - metrics are broken down weekly.   MONTHLY - metrics are broken down monthly."
          optional = true
        }
        level {
          type = MetricsReportingLevel
          description = "Level of the report"
          optional = false
        }
        metrics_filters {
          type = array
          items.type = AdsAnalyticsMetricsFilter
          description = "List of metrics filters"
          optional = false
        }
        primary_sort {
          type = PrimarySort
          description = ""
          optional = false
        }
        product_group_ids {
          type = array
          items.type =  string
          description = "List of product group ids"
          optional = false
        }
        product_group_statuses {
          type = array
          items.type = ProductGroupSummaryStatus
          description = "List of values for filtering"
          optional = false
        }
        product_item_ids {
          type = array
          items.type =  string
          description = "List of product item ids"
          optional = false
        }
        report_format {
          type = DataOutputFormat
          description = ""
          optional = false
        }
        reporting_timezone {
          type = ReportingTimeZone
          description = "Specify the timezone to be applied for the reporting."
          optional = false
        }
        start_date {
          type =  string
          description = "Metric report start date (UTC). Format: YYYY-MM-DD"
          optional = true
        }
        start_hour {
          type =  integer
          description = "Which hour of the start date to begin the report. Only allowed for hourly reports."
          optional = false
        }
        targeting_types {
          type = array
          items.type = AdAdsAnalyticsAsyncTargetingTypes
          description = "List of targeting types. Requires &#x60;level&#x60; to be a value ending in &#x60;_TARGETING&#x60;."
          optional = false
        }
        view_window_days {
          type = ConversionAttributionWindowDays
          description = "Number of days to use as the conversion attribution window for a view action."
          optional = false
        }
    }
  }
}

serviceTemplates {

  AdsAnalyticsCreateAsyncRequest {
    title = AdsAnalyticsCreateAsyncRequest
    description = AdsAnalyticsCreateAsyncRequest
    implements = openapi_server.resourceTypes.AdsAnalyticsCreateAsyncRequest

  }
}
