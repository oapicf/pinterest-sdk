"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AdAccountsAudience"
package     = openapi_server
version     = "1.0"
description = "Defines a AdAccountsAudience"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  AdAccountsAudienceRule = openapi_server.resourceTypes.AdAccountsAudienceRule
  AudienceStatus = openapi_server.resourceTypes.AudienceStatus
  AudienceType = openapi_server.resourceTypes.AudienceType
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  AdAccountsAudience {
    title = AdAccountsAudience
    description = AdAccountsAudience
    derivedFrom = Root
    properties {
        ad_account_id {
          type =  string
          description = "Ad account ID."
          optional = false
        }
        audience_type {
          type = AudienceType
          description = "[Audience types](/docs/reference/glossary/#Audience Types): ACTALIKE, ENGAGEMENT, CUSTOMER_LIST and VISITOR"
          optional = false
        }
        created_by_company_name {
          type =  string
          description = "The company that created this audience."
          optional = false
        }
        created_timestamp {
          type =  integer
          description = "Creation time. Unix timestamp in seconds."
          optional = false
        }
        description {
          type =  string
          description = "Audience description."
          optional = false
        }
        id {
          type =  string
          description = "Audience ID."
          optional = true
        }
        is_nca {
          type =  boolean
          description = "Whether the audience derives from a new customer acquisition (expanded matching) customer list. Read-only."
          optional = false
        }
        name {
          type =  string
          description = "Audience name."
          optional = false
        }
        rule {
          type = AdAccountsAudienceRule
          description = ""
          optional = false
        }
        size {
          type =  integer
          description = "Audience size."
          optional = false
        }
        status {
          type = AudienceStatus
          description = "Audience status. READY, INITIALIZING, TOO_SMALL - Each audience list needs to have at least 100 people with Pinterest accounts before you can start using it."
          optional = false
        }
        type {
          type =  string
          description = "Always \&quot;audience\&quot;."
          optional = false
        }
        updated_timestamp {
          type =  integer
          description = "Last update time. Unix timestamp in seconds."
          optional = false
        }
    }
  }
}

serviceTemplates {

  AdAccountsAudience {
    title = AdAccountsAudience
    description = AdAccountsAudience
    implements = openapi_server.resourceTypes.AdAccountsAudience

  }
}
