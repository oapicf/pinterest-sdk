"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LeadSubscriptionPostParams"
package     = openapi_server
version     = "1.0"
description = "Defines a LeadSubscriptionPostParams"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  PartnerMetadata = openapi_server.resourceTypes.PartnerMetadata
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  LeadSubscriptionPostParams {
    title = LeadSubscriptionPostParams
    description = LeadSubscriptionPostParams
    derivedFrom = Root
    properties {
        ad_account_id {
          type =  string
          description = "The Ad Account ID that this lead form belongs to."
          optional = false
        }
        api_version {
          type =  string
          description = "API version."
          optional = false
        }
        created_time {
          type =  integer
          description = "Subscription creation time. Unix timestamp in milliseconds."
          optional = false
        }
        cryptographic_algorithm {
          type =  string
          description = "Lead data encryption algorithm."
          optional = false
        }
        cryptographic_key {
          type =  string
          description = "Base64 encoded key for client to decrypt lead data."
          optional = false
        }
        id {
          type =  string
          description = "Subscription ID."
          optional = false
        }
        lead_form_id {
          type =  string
          description = "Lead form ID."
          optional = false
        }
        user_account_id {
          type =  string
          description = "User account used to subscribe lead data."
          optional = false
        }
        webhook_url {
          type =  string
          description = "Standard HTTPS webhook URL."
          optional = false
        }
        partner_access_token {
          type =  string
          description = "Partner access token. Only for clients that requires authentication. We recommend to avoid this param."
          optional = false
        }
        partner_metadata {
          type = PartnerMetadata
          description = "Partner metadata. Only for clients that requires special handling. We recommend to avoid this param."
          optional = false
        }
        partner_refresh_token {
          type =  string
          description = "Partner refresh token. Only for clients that requires authentication. We recommend to avoid this param."
          optional = false
        }
    }
  }
}

serviceTemplates {

  LeadSubscriptionPostParams {
    title = LeadSubscriptionPostParams
    description = LeadSubscriptionPostParams
    implements = openapi_server.resourceTypes.LeadSubscriptionPostParams

  }
}
