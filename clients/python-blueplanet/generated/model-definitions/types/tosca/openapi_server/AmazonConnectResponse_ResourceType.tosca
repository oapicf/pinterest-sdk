"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AmazonConnectResponse"
package     = openapi_server
version     = "1.0"
description = "Defines a AmazonConnectResponse"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  AmazonConnectResponse {
    title = AmazonConnectResponse
    description = AmazonConnectResponse
    derivedFrom = Root
    properties {
        message {
          type =  string
          description = "Amazon connect response message"
          optional = false
        }
    }
  }
}

serviceTemplates {

  AmazonConnectResponse {
    title = AmazonConnectResponse
    description = AmazonConnectResponse
    implements = openapi_server.resourceTypes.AmazonConnectResponse

  }
}
