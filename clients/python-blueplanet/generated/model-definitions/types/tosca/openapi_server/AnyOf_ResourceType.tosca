"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AnyOf"
package     = openapi_server
version     = "1.0"
description = "Defines a AnyOf"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsProductGroupFilterKeys = openapi_server.resourceTypes.CatalogsProductGroupFilterKeys
}
resourceTypes {

  AnyOf {
    title = AnyOf
    description = AnyOf
    derivedFrom = Root
    properties {
        any_of {
          type = array
          items.type = CatalogsProductGroupFilterKeys
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  AnyOf {
    title = AnyOf
    description = AnyOf
    implements = openapi_server.resourceTypes.AnyOf

  }
}
