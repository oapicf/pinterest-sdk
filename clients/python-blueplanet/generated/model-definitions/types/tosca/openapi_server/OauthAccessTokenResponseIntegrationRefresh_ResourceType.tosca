        refresh_token {
          type =  string
          description = ""
          optional = true
        }
        refresh_token_expires_in {
          type =  integer
          description = ""
          optional = true
        }
        access_token {
          type =  string
          description = ""
          optional = true
        }
        expires_in {
          type =  integer
          description = ""
          optional = true
        }
        response_type {
          type =  string
          description = ""
          enum = ["authorization_code", "refresh_token", "client_credentials"]
          optional = false
        }
        scope {
          type =  string
          description = ""
          optional = true
        }
        token_type {
          type =  string
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  OauthAccessTokenResponseIntegrationRefresh {
    title = OauthAccessTokenResponseIntegrationRefresh
