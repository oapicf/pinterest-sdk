"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server BusinessAccessError"
package     = openapi_server
version     = "1.0"
description = "Defines a BusinessAccessError"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  BusinessAccessError {
    title = BusinessAccessError
    description = BusinessAccessError
    derivedFrom = Root
    properties {
        code {
          type =  integer
          description = ""
          optional = true
        }
        message {
          type =  string
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  BusinessAccessError {
    title = BusinessAccessError
    description = BusinessAccessError
    implements = openapi_server.resourceTypes.BusinessAccessError

  }
}
