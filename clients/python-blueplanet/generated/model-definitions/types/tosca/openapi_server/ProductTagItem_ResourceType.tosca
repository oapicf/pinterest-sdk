"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ProductTagItem"
package     = openapi_server
version     = "1.0"
description = "Defines a ProductTagItem"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  ProductTagItem {
    title = ProductTagItem
    description = ProductTagItem
    derivedFrom = Root
    properties {
        pin_id {
          type =  string
          description = "Pin ID of the product pin to tag onto the hero pin."
          optional = true
        }
    }
  }
}

serviceTemplates {

  ProductTagItem {
    title = ProductTagItem
    description = ProductTagItem
    implements = openapi_server.resourceTypes.ProductTagItem

  }
}
