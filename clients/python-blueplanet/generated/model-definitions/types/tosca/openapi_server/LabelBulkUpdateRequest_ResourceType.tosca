"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LabelBulkUpdateRequest"
package     = openapi_server
version     = "1.0"
description = "Defines a LabelBulkUpdateRequest"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  LabelStatusBulkUpdate = openapi_server.resourceTypes.LabelStatusBulkUpdate
}
resourceTypes {

  LabelBulkUpdateRequest {
    title = LabelBulkUpdateRequest
    description = LabelBulkUpdateRequest
    derivedFrom = Root
    properties {
        id {
          type =  string
          description = "Label ID."
          optional = true
        }
        parent_id {
          type =  string
          description = "Unique identifier of the asset you are labelling. Currently, you can only label campaigns."
          optional = true
        }
        status {
          type = LabelStatusBulkUpdate
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  LabelBulkUpdateRequest {
    title = LabelBulkUpdateRequest
    description = LabelBulkUpdateRequest
    implements = openapi_server.resourceTypes.LabelBulkUpdateRequest

  }
}
