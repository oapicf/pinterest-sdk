"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LeadFormTestRequest"
package     = openapi_server
version     = "1.0"
description = "Defines a LeadFormTestRequest"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  LeadFormTestRequest {
    title = LeadFormTestRequest
    description = LeadFormTestRequest
    derivedFrom = Root
    properties {
        answers {
          type = array
          items.type =  string
          description = "Test lead answers. Should follow the creation order."
          optional = true
        }
    }
  }
}

serviceTemplates {

  LeadFormTestRequest {
    title = LeadFormTestRequest
    description = LeadFormTestRequest
    implements = openapi_server.resourceTypes.LeadFormTestRequest

  }
}
