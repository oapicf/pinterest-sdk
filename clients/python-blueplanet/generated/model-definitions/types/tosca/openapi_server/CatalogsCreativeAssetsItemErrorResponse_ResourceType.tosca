"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsCreativeAssetsItemErrorResponse"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsCreativeAssetsItemErrorResponse"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsType = openapi_server.resourceTypes.CatalogsType
  ItemValidationEvent = openapi_server.resourceTypes.ItemValidationEvent
}
resourceTypes {

  CatalogsCreativeAssetsItemErrorResponse {
    title = CatalogsCreativeAssetsItemErrorResponse
    description = CatalogsCreativeAssetsItemErrorResponse
    derivedFrom = Root
    properties {
        catalog_type {
          type = CatalogsType
          description = ""
          optional = true
        }
        creative_assets_id {
          type =  string
          description = "The catalog creative assets id in the merchant namespace"
          optional = false
        }
        errors {
          type = array
          items.type = ItemValidationEvent
          description = "Array with the errors for the item id requested"
          optional = true
        }
    }
  }
}

serviceTemplates {

  CatalogsCreativeAssetsItemErrorResponse {
    title = CatalogsCreativeAssetsItemErrorResponse
    description = CatalogsCreativeAssetsItemErrorResponse
    implements = openapi_server.resourceTypes.CatalogsCreativeAssetsItemErrorResponse

  }
}
