"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsRetailProductMetadata"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsRetailProductMetadata"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  NonNullableCatalogsCurrency = openapi_server.resourceTypes.NonNullableCatalogsCurrency
  ProductAvailability = openapi_server.resourceTypes.ProductAvailability
}
resourceTypes {

  CatalogsRetailProductMetadata {
    title = CatalogsRetailProductMetadata
    description = CatalogsRetailProductMetadata
    derivedFrom = Root
    properties {
        availability {
          type = ProductAvailability
          description = ""
          optional = true
        }
        currency {
          type = NonNullableCatalogsCurrency
          description = ""
          optional = true
        }
        item_group_id {
          type =  string
          description = "The parent ID of the product."
          optional = true
        }
        item_id {
          type =  string
          description = "The user-created unique ID that represents the product."
          optional = true
        }
        price {
          type =  
          description = "The price of the product."
          optional = true
        }
        sale_price {
          type =  
          description = "The discounted price of the product."
          optional = true
        }
    }
  }
}

serviceTemplates {

  CatalogsRetailProductMetadata {
    title = CatalogsRetailProductMetadata
    description = CatalogsRetailProductMetadata
    implements = openapi_server.resourceTypes.CatalogsRetailProductMetadata

  }
}
