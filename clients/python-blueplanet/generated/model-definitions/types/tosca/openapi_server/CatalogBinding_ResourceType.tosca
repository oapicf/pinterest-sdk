"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogBinding"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogBinding"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CatalogBinding {
    title = CatalogBinding
    description = CatalogBinding
    derivedFrom = Root
    properties {
        catalog_type {
          type =  string
          description = "Catalog type"
          optional = false
        }
        id {
          type =  string
          description = "Catalog ID."
          optional = false
        }
        name {
          type =  string
          description = "Catalog name"
          optional = false
        }
    }
  }
}

serviceTemplates {

  CatalogBinding {
    title = CatalogBinding
    description = CatalogBinding
    implements = openapi_server.resourceTypes.CatalogBinding

  }
}
