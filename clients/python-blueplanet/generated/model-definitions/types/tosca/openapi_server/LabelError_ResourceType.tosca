"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LabelError"
package     = openapi_server
version     = "1.0"
description = "Defines a LabelError"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  LabelErrorData = openapi_server.resourceTypes.LabelErrorData
}
resourceTypes {

  LabelError {
    title = LabelError
    description = LabelError
    derivedFrom = Root
    properties {
        data {
          type = LabelErrorData
          description = ""
          optional = false
        }
        error_messages {
          type = array
          items.type =  string
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  LabelError {
    title = LabelError
    description = LabelError
    implements = openapi_server.resourceTypes.LabelError

  }
}
