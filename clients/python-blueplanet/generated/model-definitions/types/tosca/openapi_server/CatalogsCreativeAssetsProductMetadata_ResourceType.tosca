          optional = true
        }
        visibility {
          type = CreativeAssetsVisibilityType
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  CatalogsCreativeAssetsProductMetadata {
    title = CatalogsCreativeAssetsProductMetadata
