description = "Defines a CatalogsCreativeAssetsProductMetadata"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CreativeAssetsVisibilityType = openapi_server.resourceTypes.CreativeAssetsVisibilityType
}
resourceTypes {

  CatalogsCreativeAssetsProductMetadata {
    title = CatalogsCreativeAssetsProductMetadata
