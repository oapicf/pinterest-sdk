"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AdAccountToAdAccountSharedAudience"
package     = openapi_server
version     = "1.0"
description = "Defines a AdAccountToAdAccountSharedAudience"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  Role = openapi_server.resourceTypes.Role
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  AdAccountToAdAccountSharedAudience {
    title = AdAccountToAdAccountSharedAudience
    description = AdAccountToAdAccountSharedAudience
    derivedFrom = Root
    properties {
        audience_id {
          type =  string
          description = "Unique identifier of an audience"
          optional = true
        }
        permissions {
          type = array
          items.type = Role
          description = "Permissions granted to the recipients."
          optional = false
        }
        recipient_account_ids {
          type = array
          items.type =  string
          description = "Ad account IDs to share with or revoke from (request) / that received the audience (response)."
          optional = true
        }
    }
  }
}

serviceTemplates {

  AdAccountToAdAccountSharedAudience {
    title = AdAccountToAdAccountSharedAudience
    description = AdAccountToAdAccountSharedAudience
    implements = openapi_server.resourceTypes.AdAccountToAdAccountSharedAudience

  }
}
