"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ConversionMSOTEventsCreate"
package     = openapi_server
version     = "1.0"
description = "Defines a ConversionMSOTEventsCreate"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  AttributionModel = openapi_server.resourceTypes.AttributionModel
  AttributionScope = openapi_server.resourceTypes.AttributionScope
  Currency = openapi_server.resourceTypes.Currency
  MsotEventName = openapi_server.resourceTypes.MsotEventName
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  ConversionMSOTEventsCreate {
    title = ConversionMSOTEventsCreate
    description = ConversionMSOTEventsCreate
    derivedFrom = Root
    properties {
        action_timestamps {
          type = array
          items.type =  integer
          description = "Timestamp(s) when the ad action(s) happened. Unix timestamp in seconds."
          optional = false
        }
        ad_group_id {
          type =  string
          description = "The ID of the ad group that was attributed to the conversion event."
          optional = true
        }
        attribution_model {
          type = AttributionModel
          description = "The attribution model used to attribute the conversion event."
          optional = false
        }
        attribution_scope {
          type = AttributionScope
          description = "Ad event type."
          optional = false
        }
        attribution_score {
          type =  integer
          description = "Credit given to the attributed ad actions. Allowed values are &gt; 0 and &lt;&#x3D; 1."
          optional = false
        }
        campaign_id {
          type =  string
          description = "The ID of the campaign that was attributed to the conversion event."
          optional = false
        }
        click_window {
          type =  string
          description = "Click window used for attribution (for example, &#x60;1d&#x60;, &#x60;7d&#x60;, &#x60;30d&#x60;, &#x60;lifetime&#x60;)."
          optional = false
        }
        currency {
          type = Currency
          description = "Currency code for the &#x60;value&#x60; field, required if &#x60;value&#x60; is present. Currency Codes should be in ISO 4217 standard."
          optional = false
        }
        event_id {
          type =  string
          description = "A unique id string that identifies this event. If you are already sending us events through Conversions API, then this id should match the event_id sent through Conversions API."
          optional = true
        }
        event_name {
          type = MsotEventName
          description = "Type of user event."
          optional = true
        }
        event_timestamp {
          type =  integer
          description = "The time when the event occurred. Unix timestamp in seconds."
          optional = true
        }
        total_event_touchpoints {
          type =  integer
          description = "Total number of ad events including other non-Pinterest ad platforms."
          optional = false
        }
        total_events {
          type =  integer
          description = "Deprecated: use &#x60;total_events_fractional&#x60; instead to avoid rounding errors. Total number of conversion events that are reported in one API call.  If you are sending one API request for one attributed conversion event then this value should be 1. If you are sending multiple attributed conversion events in one API request then this value should be the total number of attributed conversion events in the request."
          optional = false
        }
        total_events_fractional {
          type =  integer
          description = "Total number of conversion events that are reported in one API call. Use this field instead of &#x60;total_events&#x60; to send precise fractional values.  If you are sending one API request for one attributed conversion event with full credit, this value should be 1.0. For partial attribution, send the exact fractional value (e.g., 0.5 for half credit)."
          optional = false
        }
        value {
          type =  integer
          description = "Order value of the conversion event. Required if &#x60;event_name&#x60; is &#x60;add_to_cart&#x60; or &#x60;checkout&#x60;."
          optional = false
        }
        view_window {
          type =  string
          description = "View window used for attribution (for example, &#x60;1d&#x60;, &#x60;7d&#x60;, &#x60;30d&#x60;)."
          optional = false
        }
    }
  }
}

serviceTemplates {

  ConversionMSOTEventsCreate {
    title = ConversionMSOTEventsCreate
    description = ConversionMSOTEventsCreate
    implements = openapi_server.resourceTypes.ConversionMSOTEventsCreate

  }
}
