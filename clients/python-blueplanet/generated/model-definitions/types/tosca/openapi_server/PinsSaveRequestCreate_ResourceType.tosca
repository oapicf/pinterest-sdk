"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server PinsSaveRequestCreate"
package     = openapi_server
version     = "1.0"
description = "Defines a PinsSaveRequestCreate"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  PinsSaveRequestCreate {
    title = PinsSaveRequestCreate
    description = PinsSaveRequestCreate
    derivedFrom = Root
    properties {
        board_id {
          type =  string
          description = "Unique identifier of the board to which the pin will be saved."
          optional = false
        }
        board_section_id {
          type =  string
          description = "Unique identifier of the board section to which the pin will be saved."
          optional = false
        }
    }
  }
}

serviceTemplates {

  PinsSaveRequestCreate {
    title = PinsSaveRequestCreate
    description = PinsSaveRequestCreate
    implements = openapi_server.resourceTypes.PinsSaveRequestCreate

  }
}
