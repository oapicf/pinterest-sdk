"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LabelCreateRequest"
package     = openapi_server
version     = "1.0"
description = "Defines a LabelCreateRequest"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  LabelCreateItem = openapi_server.resourceTypes.LabelCreateItem
}
resourceTypes {

  LabelCreateRequest {
    title = LabelCreateRequest
    description = LabelCreateRequest
    derivedFrom = Root
    properties {
        labels {
          type = array
          items.type = LabelCreateItem
          description = "Labels that you are applying to the campaign."
          optional = true
        }
    }
  }
}

serviceTemplates {

  LabelCreateRequest {
    title = LabelCreateRequest
    description = LabelCreateRequest
    implements = openapi_server.resourceTypes.LabelCreateRequest

  }
}
