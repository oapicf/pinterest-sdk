"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsCreativeAssetsFeedsCreateRequest"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsCreativeAssetsFeedsCreateRequest"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsFeedCredentials = openapi_server.resourceTypes.CatalogsFeedCredentials
  CatalogsFeedProcessingSchedule = openapi_server.resourceTypes.CatalogsFeedProcessingSchedule
  CatalogsFeedsCreateRequestDefaultLocale = openapi_server.resourceTypes.CatalogsFeedsCreateRequestDefaultLocale
  CatalogsFormat = openapi_server.resourceTypes.CatalogsFormat
  CatalogsStatus = openapi_server.resourceTypes.CatalogsStatus
  CatalogsType = openapi_server.resourceTypes.CatalogsType
  Country = openapi_server.resourceTypes.Country
  NullableCurrency = openapi_server.resourceTypes.NullableCurrency
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CatalogsCreativeAssetsFeedsCreateRequest {
    title = CatalogsCreativeAssetsFeedsCreateRequest
    description = CatalogsCreativeAssetsFeedsCreateRequest
    derivedFrom = Root
    properties {
        catalog_id {
          type =  string
          description = "Catalog id pertaining to the feed. If not provided, feed will use a default catalog based on type. At the moment a catalog can not have multiple creative assets feeds but this will change in the future."
          optional = false
        }
        catalog_type {
          type = CatalogsType
          description = ""
          optional = true
        }
        credentials {
          type = CatalogsFeedCredentials
          description = ""
          optional = false
        }
        default_country {
          type = Country
          description = ""
          optional = true
        }
        default_currency {
          type = NullableCurrency
          description = ""
          optional = false
        }
        default_locale {
          type = CatalogsFeedsCreateRequestDefaultLocale
          description = ""
          optional = true
        }
        format {
          type = CatalogsFormat
          description = ""
          optional = true
        }
        location {
          type =  string
          description = "The URL where a feed is available for download. This URL is what Pinterest will use to download a feed for processing."
          optional = true
        }
        name {
          type =  string
          description = "A human-friendly name associated to a given feed."
          optional = true
        }
        preferred_processing_schedule {
          type = CatalogsFeedProcessingSchedule
          description = ""
          optional = false
        }
        status {
          type = CatalogsStatus
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  CatalogsCreativeAssetsFeedsCreateRequest {
    title = CatalogsCreativeAssetsFeedsCreateRequest
    description = CatalogsCreativeAssetsFeedsCreateRequest
    implements = openapi_server.resourceTypes.CatalogsCreativeAssetsFeedsCreateRequest

  }
}
