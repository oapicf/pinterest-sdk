"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsFeedIngestion"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsFeedIngestion"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsFeedProcessingStatus = openapi_server.resourceTypes.CatalogsFeedProcessingStatus
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CatalogsFeedIngestion {
    title = CatalogsFeedIngestion
    description = CatalogsFeedIngestion
    derivedFrom = Root
    properties {
        created_at {
          type =  string
          description = "Timestamp of the feed ingestion."
          optional = true
        }
        feed_id {
          type =  string
          description = "Catalog Feed id pertaining to the feed ingestion."
          optional = true
        }
        id {
          type =  string
          description = "Unique identifier of a feed ingestion."
          optional = true
        }
        status {
          type = CatalogsFeedProcessingStatus
          description = "Status of the feed ingestion."
          optional = true
        }
    }
  }
}

serviceTemplates {

  CatalogsFeedIngestion {
    title = CatalogsFeedIngestion
    description = CatalogsFeedIngestion
    implements = openapi_server.resourceTypes.CatalogsFeedIngestion

  }
}
