"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CreateAssetGroupBody"
package     = openapi_server
version     = "1.0"
description = "Defines a CreateAssetGroupBody"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  AssetGroupType = openapi_server.resourceTypes.AssetGroupType
}
resourceTypes {

  CreateAssetGroupBody {
    title = CreateAssetGroupBody
    description = CreateAssetGroupBody
    derivedFrom = Root
    properties {
        asset_group_description {
          type =  string
          description = "Asset group description"
          optional = true
        }
        asset_group_name {
          type =  string
          description = "Asset Group name"
          optional = true
        }
        asset_group_types {
          type = array
          items.type = AssetGroupType
          description = "Asset Group Types. Note: The asset group types are used for user reference and categorization purposes only and do not impact the functionality of the asset group."
          optional = true
        }
    }
  }
}

serviceTemplates {

  CreateAssetGroupBody {
    title = CreateAssetGroupBody
    description = CreateAssetGroupBody
    implements = openapi_server.resourceTypes.CreateAssetGroupBody

  }
}
