"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CampaignUpdateRequestAllOf2"
package     = openapi_server
version     = "1.0"
description = "Defines a CampaignUpdateRequestAllOf2"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CampaignBidOptionsUpdate = openapi_server.resourceTypes.CampaignBidOptionsUpdate
  IntendedPromotionType = openapi_server.resourceTypes.IntendedPromotionType
  ObjectiveType = openapi_server.resourceTypes.ObjectiveType
}
resourceTypes {

  CampaignUpdateRequestAllOf2 {
    title = CampaignUpdateRequestAllOf2
    description = CampaignUpdateRequestAllOf2
    derivedFrom = Root
    properties {
        bid_options {
          type = CampaignBidOptionsUpdate
          description = ""
          optional = false
        }
        intended_promotion_type {
          type = IntendedPromotionType
          description = ""
          optional = false
        }
        is_ltv_optimized {
          type =  boolean
          description = "Specifies whether the campaign is optimized for Lifetime Value (LTV). Only available for eligible advertisers."
          optional = false
        }
        is_performance_plus {
          type =  boolean
          description = "Enable Pinterest Performance+ for your campaign. To learn more, see &lt;a href&#x3D;\&quot;https://developers.pinterest.com/docs/api-features/pinterest-performance-plus-setup/\&quot;&gt;Pinterest Performance+ Setup&lt;/a&gt;. This field is immutable, except only for campaigns in draft status which may update this field."
          optional = false
        }
        is_top_of_search {
          type =  boolean
          description = "Enable Top Of Search for your campaign. This field is immutable, except only for campaigns in draft status which may update this field."
          optional = false
        }
        objective_type {
          type = ObjectiveType
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  CampaignUpdateRequestAllOf2 {
    title = CampaignUpdateRequestAllOf2
