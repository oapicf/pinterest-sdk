"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CampaignAudienceMultipliers"
package     = openapi_server
version     = "1.0"
description = "Defines a CampaignAudienceMultipliers"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CampaignAudienceMultipliers {
    title = CampaignAudienceMultipliers
    description = CampaignAudienceMultipliers
    derivedFrom = Root
    properties {
        audience_id {
          type =  string
          description = "Audience ID for the multiplier."
          optional = false
        }
    }
  }
}

serviceTemplates {

  CampaignAudienceMultipliers {
    title = CampaignAudienceMultipliers
    description = CampaignAudienceMultipliers
    implements = openapi_server.resourceTypes.CampaignAudienceMultipliers

  }
}
