"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ProductGroupPromotionsCreate"
package     = openapi_server
version     = "1.0"
description = "Defines a ProductGroupPromotionsCreate"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  ProductGroupPromotion = openapi_server.resourceTypes.ProductGroupPromotion
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  ProductGroupPromotionsCreate {
    title = ProductGroupPromotionsCreate
    description = ProductGroupPromotionsCreate
    derivedFrom = Root
    properties {
        ad_group_id {
          type =  string
          description = "ID of the ad group the product group promotion belongs to."
          optional = true
        }
        product_group_promotion {
          type = array
          items.type = ProductGroupPromotion
          description = "List of product group promotions to create or update."
          optional = true
        }
    }
  }
}

serviceTemplates {

  ProductGroupPromotionsCreate {
    title = ProductGroupPromotionsCreate
    description = ProductGroupPromotionsCreate
    implements = openapi_server.resourceTypes.ProductGroupPromotionsCreate

  }
}
