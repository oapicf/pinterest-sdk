    derivedFrom = Root
    properties {
        item_id {
          type =  string
          description = "The catalog item id in the merchant namespace"
          optional = false
        }
    }
  }
}

serviceTemplates {

  ItemDeleteBatchRecord {
    title = ItemDeleteBatchRecord
