          optional = false
        }
        adult {
          type =  boolean
          description = "Set this attribute to TRUE if you&#39;re submitting items that are considered “adult”. These will not be shown on Pinterest."
          optional = false
        }
        age_group {
          type =  string
          description = "The age group to apply a demographic range to the product. Must be one of the following values (upper or lowercased): ‘newborn’, ‘infant’, ‘toddler’, ‘kids’, or ‘adult’."
          optional = false
        }
        android_deep_link {
          type =  string
          description = "The deep link to the product on the Android app."
          optional = false
        }
        availability {
          type =  string
          description = "The availability of the product. Must be one of the following values (upper or lowercased): ‘in stock’, ‘out of stock’, ‘preorder’."
          optional = false
        }
        average_review_rating {
          type =  
          description = "Average reviews for the item. Can be a number from 1-5."
          optional = false
        }
        brand {
          type =  string
          description = "The brand of the product."
          optional = false
        }
        checkout_enabled {
          type =  boolean
          description = "This attribute is not supported anymore."
          optional = false
        }
        color {
          type =  string
          description = "The primary color of the product."
          optional = false
        }
        condition {
          type =  string
          description = "The condition of the product. Must be one of the following values (upper or lowercased): ‘new’, ‘used’, or ‘refurbished’."
          optional = false
        }
        custom_label_0 {
          type =  string
          description = "&lt;p&gt;&lt;&#x3D; 511 characters for retail and creative asset catalogs, &lt;&#x3D; 127 characters for hotel catalogs&lt;/p&gt; &lt;p&gt;Custom grouping of products.&lt;/p&gt;"
          optional = false
        }
        custom_label_1 {
          type =  string
          description = "&lt;p&gt;&lt;&#x3D; 511 characters for retail and creative asset catalogs, &lt;&#x3D; 127 characters for hotel catalogs&lt;/p&gt; &lt;p&gt;Custom grouping of products.&lt;/p&gt;"
          optional = false
        }
        custom_label_2 {
          type =  string
          description = "&lt;p&gt;&lt;&#x3D; 511 characters for retail and creative asset catalogs, &lt;&#x3D; 127 characters for hotel catalogs&lt;/p&gt; &lt;p&gt;Custom grouping of products.&lt;/p&gt;"
          optional = false
        }
        custom_label_3 {
          type =  string
          description = "&lt;p&gt;&lt;&#x3D; 511 characters for retail and creative asset catalogs, &lt;&#x3D; 127 characters for hotel catalogs&lt;/p&gt; &lt;p&gt;Custom grouping of products.&lt;/p&gt;"
          optional = false
        }
        custom_label_4 {
          type =  string
          description = "&lt;p&gt;&lt;&#x3D; 511 characters for retail and creative asset catalogs, &lt;&#x3D; 127 characters for hotel catalogs&lt;/p&gt; &lt;p&gt;Custom grouping of products.&lt;/p&gt;"
          optional = false
        }
        custom_number_0 {
          type =  integer
          description = "an attribute for any integer information ranging from 0 to 4,294,967,295, which can be used to group items."
          optional = false
        }
        custom_number_1 {
          type =  integer
          description = "an attribute for any integer information ranging from 0 to 4,294,967,295, which can be used to group items."
          optional = false
        }
        custom_number_2 {
          type =  integer
          description = "an attribute for any integer information ranging from 0 to 4,294,967,295, which can be used to group items."
          optional = false
        }
        custom_number_3 {
          type =  integer
          description = "an attribute for any integer information ranging from 0 to 4,294,967,295, which can be used to group items."
          optional = false
        }
        custom_number_4 {
          type =  integer
          description = "an attribute for any integer information ranging from 0 to 4,294,967,295, which can be used to group items."
          optional = false
        }
        description {
          type =  string
          description = "&lt;p&gt;&lt;&#x3D; 10000 characters&lt;/p&gt; &lt;p&gt;The description of the product.&lt;/p&gt;"
          optional = false
        }
        free_shipping_label {
          type =  boolean
          description = "The item is free to ship."
          optional = false
        }
        free_shipping_limit {
          type =  string
          description = "The minimum order purchase necessary for the customer to get free shipping. Only relevant if free shipping is offered."
          optional = false
        }
        gender {
          type =  string
          description = "The gender associated with the product. Must be one of the following values (upper or lowercased): ‘male’, ‘female’, or ‘unisex’."
          optional = false
        }
        google_product_category {
          type =  string
          description = "The categorization of the product based on the standardized Google Product Taxonomy. This is a set taxonomy. Both the text values and numeric codes are accepted."
          optional = false
        }
        gtin {
          type = UpdatableItemAttributesGtin
          description = ""
          optional = false
        }
        id {
          type =  string
          description = "&lt;p&gt;&lt;&#x3D; 127 characters&lt;/p&gt; &lt;p&gt;The user-created unique ID that represents the product. Only Unicode characters are accepted.&lt;/p&gt;"
          optional = false
        }
        installment_price {
          type =  string
          description = "Installment price of the product. This data will only be shown to pinners in the enabled countries. Expected format: &lt;payment_count&gt;:&lt;payment_amount&gt; &lt;currency&gt;"
          optional = false
        }
        ios_deep_link {
          type =  string
          description = "The deep link to the product on the iOS app."
          optional = false
        }
        item_group_id {
          type =  string
          description = "&lt;p&gt;&lt;&#x3D; 127 characters&lt;/p&gt; &lt;p&gt;The parent ID of the product.&lt;/p&gt;"
          optional = false
        }
        last_updated_time {
          type =  integer
          description = "The millisecond timestamp when the item was lastly modified by the merchant."
          optional = false
        }
        link {
          type =  string
          description = "&lt;p&gt;&lt;&#x3D; 511 characters&lt;/p&gt; &lt;p&gt;The landing page for the product.&lt;/p&gt;"
          optional = false
        }
        material {
          type =  string
          description = "The material used to make the product."
          optional = false
        }
        min_ad_price {
          type =  string
          description = "The minimum advertised price of the product. It supports the following formats, \&quot;19.99 USD\&quot;, \&quot;19.99USD\&quot; and \&quot;19.99\&quot;. If the currency is not included, we default to US dollars."
          optional = false
        }
        mobile_link {
          type =  string
          description = "The mobile-optimized version of your landing page. Must begin with http:// or https://."
          optional = false
        }
        mpn {
          type =  string
          description = "Manufacturer Part Number are alpha-numeric codes created by the manufacturer of a product to uniquely identify it among all products from the same manufacturer."
          optional = false
        }
        number_of_ratings {
          type =  integer
          description = "The number of ratings for the item."
          optional = false
        }
        number_of_reviews {
          type =  integer
          description = "The number of reviews available for the item."
          optional = false
        }
        pattern {
          type =  string
          description = "The description of the pattern used for the product."
          optional = false
        }
        price {
          type =  string
          description = "The price of the product. It supports the following formats, \&quot;24.99 USD\&quot;, \&quot;24.99USD\&quot; and \&quot;24.99\&quot;. If the currency is not included, we default to US dollars."
          optional = false
        }
        product_type {
          type =  string
          description = "&lt;p&gt;&lt;&#x3D; 1000 characters&lt;/p&gt; &lt;p&gt;The categorization of your product based on your custom product taxonomy. Subcategories must be sent separated by “ &gt; “. The &gt; must be wrapped by spaces. We do not recognize any other delimiters such as comma or pipe.&lt;/p&gt;"
          optional = false
        }
        promotion_id {
          type =  string
          description = "A unique identifier referencing the promotion associated with this catalog item."
          optional = false
        }
        sale_price {
          type =  string
          description = "The discounted price of the product. The sale_price must be lower than the price. It supports the following formats, \&quot;14.99 USD\&quot;, \&quot;14.99USD\&quot; and \&quot;14.99\&quot;. If the currency is not included, we default to US dollars."
          optional = false
        }
        sale_price_effective_date {
          type =  string
          description = "Sale price effective date. Expected format: &lt;start_date&gt;/&lt;end_date&gt; (ISO 8601 format)"
          optional = false
        }
        shipping {
          type =  string
          description = "Shipping consists of one group of up to four elements, country, region, service (all optional) and price (required). All colons, even for blank values, are required."
          optional = false
        }
        shipping_height {
          type =  string
          description = "The height of the package needed to ship the product. Ensure there is a space between the numeric string and the metric."
          optional = false
        }
        shipping_weight {
          type =  string
          description = "The weight of the product. Ensure there is a space between the numeric string and the metric."
          optional = false
        }
        shipping_width {
          type =  string
          description = "The width of the package needed to ship the product. Ensure there is a space between the numeric string and the metric."
          optional = false
        }
        size {
          type =  string
          description = "The size of the product."
          optional = false
        }
        size_system {
          type =  string
          description = "Indicates the country’s sizing system in which you are submitting your product. Must be one of the following values (upper or lowercased): ‘US’, ‘UK’, ‘EU’, ‘DE’, ‘FR’, ‘JP’, ‘CN’, ‘IT’, ‘BR’, ‘MEX’, or ‘AU’."
          optional = false
        }
        size_type {
          type =  string
          description = "Additional description for the size. Must be one of the following values (upper or lowercased): ‘regular’, ‘petite’, ‘plus’, ‘big_and_tall’, or ‘maternity’."
          optional = false
        }
        tax {
          type =  string
          description = "Tax consists of one group of up to four elements, country, region, rate (all required) and tax_ship (optional). All colons, even for blank values, are required."
          optional = false
        }
        title {
          type =  string
          description = "&lt;p&gt;&lt;&#x3D; 500 characters&lt;/p&gt; &lt;p&gt;The name of the product.&lt;/p&gt;"
          optional = false
        }
        unit_pricing_base_measure {
          type =  string
          description = "Unit pricing base measure of the product. This data will only be shown to pinners in the enabled countries. Expected format: &lt;base_measure&gt; &lt;unit_type&gt;"
          optional = false
        }
        unit_pricing_measure {
          type =  string
          description = "Unit pricing total measure of the product. This data will only be shown to pinners in the enabled countries. Expected format: &lt;total_units&gt; &lt;unit_type&gt;"
          optional = false
        }
        variant_names {
          type = array
          items.type =  string
          description = "Options for this variant. People will see these options next to your Pin and can select the one they want. List them in the order you want them displayed."
          optional = false
        }
        variant_values {
          type = array
          items.type =  string
          description = "Option values for this variant. People will see these options next to your Pin and can select the one they want. List them in the order you want them displayed. The order of the variant values must be consistent with the order of the variant names."
          optional = false
        }
        additional_image_link {
          type = array
          items.type =  string
          description = "&lt;p&gt;&lt;&#x3D; 2000 characters&lt;/p&gt; &lt;p&gt;The links to additional images for your product. Up to ten additional images can be used to show a product from different angles or to show different stages. Must begin with http:// or https://.&lt;/p&gt;"
          optional = false
        }
        image_link {
          type = array
          items.type =  string
          description = "&lt;p&gt;&lt;&#x3D; 2000 characters&lt;/p&gt; &lt;p&gt;The link to the main product images. Images should be at least 75x75 pixels to avoid errors. Use the additional_image_link field to add more images of your product. The URL of your image_link must be accessible by the Pinterest user-agent, and send the accurate images. Please make sure there are no template or placeholder images at the link. Must start with http:// or https://.&lt;/p&gt;"
          optional = false
        }
        video_link {
          type =  string
          description = "&lt;p&gt;&lt;&#x3D; 2,000 characters&lt;/p&gt; &lt;p&gt;Hosted link to the product video.&lt;/p&gt; &lt;p&gt;File types for linked videos must be .mp4, .mov or .m4v.&lt;/p&gt; &lt;p&gt;File size cannot exceed 2GB.&lt;/p&gt;"
          optional = false
        }
    }
  }
}

