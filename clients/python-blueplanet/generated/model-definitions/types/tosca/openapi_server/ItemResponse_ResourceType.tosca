"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ItemResponse"
package     = openapi_server
version     = "1.0"
description = "Defines a ItemResponse"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsCreativeAssetsAttributes = openapi_server.resourceTypes.CatalogsCreativeAssetsAttributes
  CatalogsCreativeAssetsItemErrorResponse = openapi_server.resourceTypes.CatalogsCreativeAssetsItemErrorResponse
  CatalogsCreativeAssetsItemResponse = openapi_server.resourceTypes.CatalogsCreativeAssetsItemResponse
  CatalogsHotelItemErrorResponse = openapi_server.resourceTypes.CatalogsHotelItemErrorResponse
  CatalogsHotelItemResponse = openapi_server.resourceTypes.CatalogsHotelItemResponse
  CatalogsRetailItemErrorResponse = openapi_server.resourceTypes.CatalogsRetailItemErrorResponse
  CatalogsRetailItemResponse = openapi_server.resourceTypes.CatalogsRetailItemResponse
  ItemValidationEvent = openapi_server.resourceTypes.ItemValidationEvent
  Pin = openapi_server.resourceTypes.Pin
}
resourceTypes {

  ItemResponse {
    title = ItemResponse
    description = ItemResponse
    derivedFrom = Root
    properties {
        attributes {
          type = CatalogsCreativeAssetsAttributes
          description = ""
          optional = false
        }
        catalog_type {
          type =  string
          description = ""
          enum = ["CREATIVE_ASSETS"]
          optional = true
        }
        item_id {
          type =  string
          description = "The catalog item id in the merchant namespace"
          optional = false
        }
        item_response_kind {
          type =  string
          description = "Discriminator literal identifying this leaf inside an &#x60;ItemResponse&#x60; payload."
          enum = ["creative_assets_item_error"]
          optional = true
        }
        pins {
          type = array
          items.type = Pin
          description = "The pins mapped to the item"
          optional = false
        }
        hotel_id {
          type =  string
          description = "The catalog hotel id in the merchant namespace"
          optional = false
        }
        creative_assets_id {
          type =  string
          description = "The catalog creative assets id in the merchant namespace"
          optional = false
        }
        errors {
          type = array
          items.type = ItemValidationEvent
          description = "Array with the errors for the item id requested"
          optional = true
        }
    }
  }
}

serviceTemplates {

  ItemResponse {
    title = ItemResponse
    description = ItemResponse
    implements = openapi_server.resourceTypes.ItemResponse

  }
}
