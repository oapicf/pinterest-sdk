"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CustomerListRecordRow"
package     = openapi_server
version     = "1.0"
description = "Defines a CustomerListRecordRow"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  CustomerListRecordRow {
    title = CustomerListRecordRow
    description = CustomerListRecordRow
    derivedFrom = Root
    properties {
        email {
          type =  string
          description = "Email address (plain or hashed with SHA1, SHA256, or MD5)."
          optional = false
        }
        external_id {
          type =  string
          description = "External ID identifier (not hashed)."
          optional = false
        }
        hashed_phone_number {
          type =  string
          description = "Hashed phone number (hashed with SHA1, SHA256, or MD5)."
          optional = false
        }
        hashed_pinner_id {
          type =  string
          description = "Hashed pinner ID (hashed with SHA1, SHA256, or MD5)."
          optional = false
        }
        ip_address {
          type =  string
          description = "IP address (not hashed)."
          optional = false
        }
        liveramp_envelope {
          type =  string
          description = "LiveRamp envelope identifier (Base64-encoded, not hashed)."
          optional = false
        }
        maid {
          type =  string
          description = "Mobile advertising ID (plain or hashed with SHA1, SHA256, or MD5)."
          optional = false
        }
        user_agent {
          type =  string
          description = "User agent string (not hashed)."
          optional = false
        }
    }
  }
}

serviceTemplates {

  CustomerListRecordRow {
    title = CustomerListRecordRow
    description = CustomerListRecordRow
    implements = openapi_server.resourceTypes.CustomerListRecordRow

  }
}
