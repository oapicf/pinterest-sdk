"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server Label"
package     = openapi_server
version     = "1.0"
description = "Defines a Label"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  NullableLabelStatus = openapi_server.resourceTypes.NullableLabelStatus
  NullableLabelType = openapi_server.resourceTypes.NullableLabelType
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  Label {
    title = Label
    description = Label
    derivedFrom = Root
    properties {
        id {
          type =  string
          description = "Label ID."
          optional = true
        }
        label_type {
          type = NullableLabelType
          description = ""
          optional = true
        }
        status {
          type = NullableLabelStatus
          description = ""
          optional = false
        }
        value {
          type =  string
          description = "Label name. 100-character limit."
          optional = true
        }
    }
  }
}

serviceTemplates {

  Label {
    title = Label
    description = Label
    implements = openapi_server.resourceTypes.Label

  }
}
