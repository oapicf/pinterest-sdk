version     = "1.0"
description = "Defines a LocalInventoryItemsGet"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  LocalInventoryItemResponse = openapi_server.resourceTypes.LocalInventoryItemResponse
}
resourceTypes {

  LocalInventoryItemsGet {
    title = LocalInventoryItemsGet
