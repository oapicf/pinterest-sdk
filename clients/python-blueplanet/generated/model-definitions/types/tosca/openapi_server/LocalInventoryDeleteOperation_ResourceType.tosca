"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LocalInventoryDeleteOperation"
package     = openapi_server
version     = "1.0"
description = "Defines a LocalInventoryDeleteOperation"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  LocalInventoryDeleteOperation {
    title = LocalInventoryDeleteOperation
    description = LocalInventoryDeleteOperation
    derivedFrom = Root
    properties {
        item_id {
          type =  string
          description = "Catalog item id in the merchant namespace"
          optional = true
        }
        operation {
          type =  string
          description = ""
          enum = ["DELETE"]
          optional = true
        }
        store_code {
          type =  string
          description = "Store code for the local inventory item"
          optional = true
        }
    }
  }
}

serviceTemplates {

  LocalInventoryDeleteOperation {
    title = LocalInventoryDeleteOperation
    description = LocalInventoryDeleteOperation
    implements = openapi_server.resourceTypes.LocalInventoryDeleteOperation

  }
}
