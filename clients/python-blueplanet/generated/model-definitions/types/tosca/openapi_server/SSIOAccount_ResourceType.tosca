"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server SSIOAccount"
package     = openapi_server
version     = "1.0"
description = "Defines a SSIOAccount"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  SSIOAccountItem = openapi_server.resourceTypes.SSIOAccountItem
  SSIOAccountPMPName = openapi_server.resourceTypes.SSIOAccountPMPName
}
resourceTypes {

  SSIOAccount {
    title = SSIOAccount
    description = SSIOAccount
    derivedFrom = Root
    properties {
        billto_infos {
          type = array
          items.type = SSIOAccountItem
          description = "An array of Salesforce account information that includes address, io terms, etc."
          optional = false
        }
        can_edit {
          type =  boolean
          description = "Advertiser eligible to update order lines"
          optional = false
        }
        currency {
          type =  string
          description = ""
          optional = false
        }
        eligible {
          type =  boolean
          description = "Advertiser eligible to create order lines"
          optional = false
        }
        error {
          type =  string
          description = "Error indicator from Salesforce which could be \&quot;No Error\&quot;"
          optional = false
        }
        pmp_names {
          type = array
          items.type = SSIOAccountPMPName
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  SSIOAccount {
    title = SSIOAccount
    description = SSIOAccount
    implements = openapi_server.resourceTypes.SSIOAccount

  }
}
