authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  TrendingKeywordDemographicsAgeDistribution {
    title = TrendingKeywordDemographicsAgeDistribution
