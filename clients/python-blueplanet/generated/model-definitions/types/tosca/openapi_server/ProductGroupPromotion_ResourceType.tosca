"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ProductGroupPromotion"
package     = openapi_server
version     = "1.0"
description = "Defines a ProductGroupPromotion"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CollectionsHeaderType = openapi_server.resourceTypes.CollectionsHeaderType
  CreativeType = openapi_server.resourceTypes.CreativeType
  EntityStatus = openapi_server.resourceTypes.EntityStatus
  GridClickType = openapi_server.resourceTypes.GridClickType
  PreferredMediaType = openapi_server.resourceTypes.PreferredMediaType
  ProductGroupPromotionCustomizableCTAType = openapi_server.resourceTypes.ProductGroupPromotionCustomizableCTAType
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  ProductGroupPromotion {
    title = ProductGroupPromotion
    description = ProductGroupPromotion
    derivedFrom = Root
    properties {
        ad_group_id {
          type =  string
          description = "ID of the ad group the product group belongs to."
          optional = false
        }
        bid_in_micro_currency {
          type =  integer
          description = "The bid in micro currency."
          optional = false
        }
        catalog_product_group_id {
          type =  string
          description = "ID of the catalogs product group that this product group promotion references (required for create operations)"
          optional = false
        }
        catalog_product_group_name {
          type =  string
          description = "Catalogs product group name"
          optional = false
        }
        collections_header_type {
          type = CollectionsHeaderType
          description = ""
          optional = false
        }
        collections_hero_destination_url {
          type =  string
          description = "Collections Hero Destination Url"
          optional = false
        }
        collections_hero_pin_id {
          type =  string
          description = "Hero Pin ID if this PG is promoted as a Collection"
          optional = false
        }
        creative_type {
          type = CreativeType
          description = ""
          optional = false
        }
        customizable_cta_type {
          type = ProductGroupPromotionCustomizableCTAType
          description = ""
          optional = false
        }
        definition {
          type =  string
          description = "The full product group definition path"
          optional = false
        }
        grid_click_type {
          type = GridClickType
          description = ""
          optional = false
        }
        id {
          type =  string
          description = "ID of the product group promotion (required for update operations)."
          optional = false
        }
        included {
          type =  boolean
          description = "True if the group is BIDDABLE, false if it should be EXCLUDED from serving ads."
          optional = false
        }
        is_generate_background {
          type =  boolean
          description = "Enable generate backgrounds for the product group, default value is FALSE. When enabled, Pinterest will use generative AI to apply backgrounds for your product images that help drive user inspiration and engagement."
          optional = false
        }
        is_image_auto_resizing {
          type =  boolean
          description = "Set to &#x60;TRUE&#x60; to automatically resize your product images with generative AI. This ensures that images have optimal appearance for better performance."
          optional = false
        }
        is_mdl {
          type =  boolean
          description = "If set to true products promoted in this product group will use the Mobile Deep Link specified in your catalog"
          optional = false
        }
        parent_id {
          type =  string
          description = "The parent Product Group ID of this Product Group"
          optional = false
        }
        preferred_media_type {
          type = PreferredMediaType
          description = ""
          optional = false
        }
        relative_definition {
          type =  string
          description = "The definition of the product group, relative to its parent - an attribute name/value pair"
          optional = false
        }
        selected_image_tag {
          type =  string
          description = "The ad image tag selected for the product group promotion."
          optional = false
        }
        selected_video_tag {
          type =  string
          description = "The ad video tag selected for the product group promotion."
          optional = false
        }
        slideshow_collections_description {
          type =  string
          description = "Slideshow Collections Description"
          optional = false
        }
        slideshow_collections_title {
          type =  string
          description = "Slideshow Collections Title"
          optional = false
        }
        status {
          type = EntityStatus
          description = ""
          optional = false
        }
        tracking_url {
          type =  string
          description = "Tracking template for proudct group promotions. 4000 limit"
          optional = false
        }
    }
  }
}

serviceTemplates {

  ProductGroupPromotion {
    title = ProductGroupPromotion
    description = ProductGroupPromotion
    implements = openapi_server.resourceTypes.ProductGroupPromotion

  }
}
