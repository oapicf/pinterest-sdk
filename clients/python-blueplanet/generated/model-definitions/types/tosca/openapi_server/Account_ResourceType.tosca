"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server Account"
package     = openapi_server
version     = "1.0"
description = "Defines a Account"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  UserAccountType = openapi_server.resourceTypes.UserAccountType
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  Account {
    title = Account
    description = Account
    derivedFrom = Root
    properties {
        about {
          type =  string
          description = "Profile about description."
          optional = false
        }
        account_type {
          type = UserAccountType
          description = "Type of account"
          optional = false
        }
        board_count {
          type =  integer
          description = "  User account board count.   **Note**: Board count on user account level may differ from counts found elsewhere due to attribution of collaborative Boards."
          optional = false
        }
        business_name {
          type =  string
          description = ""
          optional = false
        }
        follower_count {
          type =  integer
          description = "User account follower count."
          optional = false
        }
        following_count {
          type =  integer
          description = "User account following count."
          optional = false
        }
        id {
          type =  string
          description = "User account ID."
          optional = false
        }
        monthly_views {
          type =  integer
          description = "User account monthly views."
          optional = false
        }
        pin_count {
          type =  integer
          description = "User account pin count. This includes both created and saved pins."
          optional = false
        }
        profile_image {
          type =  string
          description = ""
          optional = false
        }
        username {
          type =  string
          description = ""
          optional = false
        }
        website_url {
          type =  string
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  Account {
    title = Account
    description = Account
    implements = openapi_server.resourceTypes.Account

  }
}
