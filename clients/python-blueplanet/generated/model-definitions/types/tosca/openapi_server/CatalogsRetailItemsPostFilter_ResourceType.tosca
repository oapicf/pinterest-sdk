"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsRetailItemsPostFilter"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsRetailItemsPostFilter"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CatalogsRetailItemsPostFilter {
    title = CatalogsRetailItemsPostFilter
    description = CatalogsRetailItemsPostFilter
    derivedFrom = Root
    properties {
        catalog_id {
          type =  string
          description = "Catalog id pertaining to the retail item. If not provided, default to oldest retail catalog"
          optional = false
        }
        catalog_type {
          type =  string
          description = ""
          enum = ["RETAIL"]
          optional = true
        }
        item_ids {
          type = array
          items.type =  string
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  CatalogsRetailItemsPostFilter {
    title = CatalogsRetailItemsPostFilter
    description = CatalogsRetailItemsPostFilter
    implements = openapi_server.resourceTypes.CatalogsRetailItemsPostFilter

  }
}
