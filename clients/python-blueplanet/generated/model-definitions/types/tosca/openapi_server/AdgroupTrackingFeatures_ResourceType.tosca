"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AdgroupTrackingFeatures"
package     = openapi_server
version     = "1.0"
description = "Defines a AdgroupTrackingFeatures"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  AdgroupTrackingFeatureType = openapi_server.resourceTypes.AdgroupTrackingFeatureType
}
resourceTypes {

  AdgroupTrackingFeatures {
    title = AdgroupTrackingFeatures
    description = AdgroupTrackingFeatures
    derivedFrom = Root
    properties {
        enabled {
          type = array
          items.type = AdgroupTrackingFeatureType
          description = "Tracking features. To clear this field, set to null."
          optional = false
        }
    }
  }
}

serviceTemplates {

  AdgroupTrackingFeatures {
    title = AdgroupTrackingFeatures
    description = AdgroupTrackingFeatures
    implements = openapi_server.resourceTypes.AdgroupTrackingFeatures

  }
}
