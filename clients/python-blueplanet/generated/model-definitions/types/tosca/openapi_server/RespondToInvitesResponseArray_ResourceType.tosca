"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server RespondToInvitesResponseArray"
package     = openapi_server
version     = "1.0"
description = "Defines a RespondToInvitesResponseArray"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  RespondToInvitesResponseArrayItemsInner = openapi_server.resourceTypes.RespondToInvitesResponseArrayItemsInner
}
resourceTypes {

  RespondToInvitesResponseArray {
    title = RespondToInvitesResponseArray
    description = RespondToInvitesResponseArray
    derivedFrom = Root
    properties {
        items {
          type = array
          items.type = RespondToInvitesResponseArrayItemsInner
          description = "List of invite/request accept/decline status. If there is an error, an exception object will be returned. If the invite/request was successfully accepted/declined, an invite object will be returned."
          optional = false
        }
    }
  }
}

serviceTemplates {

