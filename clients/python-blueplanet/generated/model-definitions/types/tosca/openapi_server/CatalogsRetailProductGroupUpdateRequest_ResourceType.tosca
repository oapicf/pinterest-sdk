"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsRetailProductGroupUpdateRequest"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsRetailProductGroupUpdateRequest"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsLocale = openapi_server.resourceTypes.CatalogsLocale
  CatalogsProductGroupFiltersRequest = openapi_server.resourceTypes.CatalogsProductGroupFiltersRequest
  Country = openapi_server.resourceTypes.Country
}
resourceTypes {

  CatalogsRetailProductGroupUpdateRequest {
    title = CatalogsRetailProductGroupUpdateRequest
    description = CatalogsRetailProductGroupUpdateRequest
    derivedFrom = Root
    properties {
        catalog_type {
          type =  string
          description = "Retail catalog based product group is available only for selected partners at the moment. If you are not eligible, please use feed based one."
          enum = ["RETAIL"]
          optional = false
        }
        country {
          type = Country
          description = ""
          optional = false
        }
        description {
          type =  string
          description = ""
          optional = false
        }
        filters {
          type = CatalogsProductGroupFiltersRequest
          description = ""
          optional = false
        }
        locale {
          type = CatalogsLocale
          description = ""
          optional = false
        }
        name {
          type =  string
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  CatalogsRetailProductGroupUpdateRequest {
    title = CatalogsRetailProductGroupUpdateRequest
    description = CatalogsRetailProductGroupUpdateRequest
    implements = openapi_server.resourceTypes.CatalogsRetailProductGroupUpdateRequest

  }
}
