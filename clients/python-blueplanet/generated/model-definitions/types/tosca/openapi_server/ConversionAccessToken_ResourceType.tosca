"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ConversionAccessToken"
package     = openapi_server
version     = "1.0"
description = "Defines a ConversionAccessToken"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  ConversionAccessToken {
    title = ConversionAccessToken
    description = ConversionAccessToken
    derivedFrom = Root
    properties {
        access_token {
          type =  string
          description = ""
          optional = true
        }
        token_type {
          type =  string
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  ConversionAccessToken {
    title = ConversionAccessToken
    description = ConversionAccessToken
    implements = openapi_server.resourceTypes.ConversionAccessToken

  }
}
