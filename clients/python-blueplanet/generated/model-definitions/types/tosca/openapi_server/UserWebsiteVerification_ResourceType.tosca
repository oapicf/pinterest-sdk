"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server UserWebsiteVerification"
package     = openapi_server
version     = "1.0"
description = "Defines a UserWebsiteVerification"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  UserWebsiteVerification {
    title = UserWebsiteVerification
    description = UserWebsiteVerification
    derivedFrom = Root
    properties {
        dns_txt_record {
          type =  string
          description = "DNS TXT record to check against for the website to be claimed"
          optional = false
        }
        file_content {
          type =  string
          description = "A full html file to upload to the website in order for it to be claimed"
          optional = false
        }
        filename {
          type =  string
          description = "File expected to find on the website being claimed"
          optional = false
        }
        metatag {
          type =  string
          description = "Metatag the verification process searchs for the website to be claimed"
          optional = false
        }
        verification_code {
          type =  string
          description = "Code to check against the user claiming the website"
          optional = false
        }
    }
  }
}

serviceTemplates {

  UserWebsiteVerification {
    title = UserWebsiteVerification
    description = UserWebsiteVerification
    implements = openapi_server.resourceTypes.UserWebsiteVerification

  }
}
