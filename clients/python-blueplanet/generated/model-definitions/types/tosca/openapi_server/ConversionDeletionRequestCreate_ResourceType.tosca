"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ConversionDeletionRequestCreate"
package     = openapi_server
version     = "1.0"
description = "Defines a ConversionDeletionRequestCreate"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  ConversionDeletionRequestTargets = openapi_server.resourceTypes.ConversionDeletionRequestTargets
}
resourceTypes {

  ConversionDeletionRequestCreate {
    title = ConversionDeletionRequestCreate
    description = ConversionDeletionRequestCreate
    derivedFrom = Root
    properties {
        deletion_targets {
          type = ConversionDeletionRequestTargets
          description = "Object containing the targets of the conversion deletion request. Users can be identified with user_emails, epiks, or both within the same request."
          optional = true
        }
    }
  }
}

serviceTemplates {

  ConversionDeletionRequestCreate {
    title = ConversionDeletionRequestCreate
    description = ConversionDeletionRequestCreate
    implements = openapi_server.resourceTypes.ConversionDeletionRequestCreate

