"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AgeBucketMultipliers"
package     = openapi_server
version     = "1.0"
description = "Defines a AgeBucketMultipliers"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  TargetingSpecAgeBucket = openapi_server.resourceTypes.TargetingSpecAgeBucket
}
resourceTypes {

  AgeBucketMultipliers {
    title = AgeBucketMultipliers
    description = AgeBucketMultipliers
    derivedFrom = Root
    properties {
        age_bucket {
          type = TargetingSpecAgeBucket
          description = "Age bucket identifier."
          optional = false
        }
    }
  }
}

serviceTemplates {

  AgeBucketMultipliers {
    title = AgeBucketMultipliers
    description = AgeBucketMultipliers
    implements = openapi_server.resourceTypes.AgeBucketMultipliers

  }
}
