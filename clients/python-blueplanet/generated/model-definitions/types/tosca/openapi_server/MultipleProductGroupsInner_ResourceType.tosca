"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server MultipleProductGroupsInner"
package     = openapi_server
version     = "1.0"
description = "Defines a MultipleProductGroupsInner"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsCreativeAssetsProductGroupFilters = openapi_server.resourceTypes.CatalogsCreativeAssetsProductGroupFilters
  CatalogsLocale = openapi_server.resourceTypes.CatalogsLocale
  CatalogsProductGroupCreateRequest = openapi_server.resourceTypes.CatalogsProductGroupCreateRequest
  CatalogsVerticalProductGroupCreateRequest = openapi_server.resourceTypes.CatalogsVerticalProductGroupCreateRequest
  Country = openapi_server.resourceTypes.Country
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  MultipleProductGroupsInner {
    title = MultipleProductGroupsInner
    description = MultipleProductGroupsInner
    derivedFrom = Root
    properties {
        description {
          type =  string
          description = ""
          optional = false
        }
        feed_id {
          type =  string
          description = "Catalog Feed id pertaining to the catalog product group."
          optional = true
        }
        filters {
          type = CatalogsCreativeAssetsProductGroupFilters
          description = ""
          optional = true
        }
        is_featured {
          type =  boolean
          description = "boolean indicator of whether the product group is being featured or not"
          optional = false
        }
        name {
          type =  string
          description = ""
          optional = true
        }
        catalog_id {
          type =  string
          description = "Catalog id pertaining to the creative assets product group."
          optional = true
        }
        catalog_type {
          type =  string
          description = ""
          enum = ["CREATIVE_ASSETS"]
          optional = true
        }
        country {
          type = Country
          description = ""
          optional = false
        }
        locale {
          type = CatalogsLocale
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  MultipleProductGroupsInner {
    title = MultipleProductGroupsInner
    description = MultipleProductGroupsInner
    implements = openapi_server.resourceTypes.MultipleProductGroupsInner

  }
}
