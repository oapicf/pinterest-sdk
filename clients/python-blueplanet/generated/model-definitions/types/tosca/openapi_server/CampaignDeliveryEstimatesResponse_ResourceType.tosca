"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CampaignDeliveryEstimatesResponse"
package     = openapi_server
version     = "1.0"
description = "Defines a CampaignDeliveryEstimatesResponse"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CampaignDeliveryEstimatesDerivedMetrics = openapi_server.resourceTypes.CampaignDeliveryEstimatesDerivedMetrics
  CampaignPlanningCurveEstimate = openapi_server.resourceTypes.CampaignPlanningCurveEstimate
}
resourceTypes {

  CampaignDeliveryEstimatesResponse {
    title = CampaignDeliveryEstimatesResponse
    description = CampaignDeliveryEstimatesResponse
    derivedFrom = Root
    properties {
        curves {
          type = array
          items.type = CampaignPlanningCurveEstimate
          description = "Estimated curves. Each curve will pertain to a single estimation type."
          optional = false
        }
        derived_metrics {
          type = CampaignDeliveryEstimatesDerivedMetrics
          description = ""
          optional = false
        }
        max_potential_spend {
          type =  integer
          description = "Maximum potential spend estimate."
          optional = false
        }
    }
  }
}

serviceTemplates {

  CampaignDeliveryEstimatesResponse {
    title = CampaignDeliveryEstimatesResponse
    description = CampaignDeliveryEstimatesResponse
    implements = openapi_server.resourceTypes.CampaignDeliveryEstimatesResponse

  }
}
