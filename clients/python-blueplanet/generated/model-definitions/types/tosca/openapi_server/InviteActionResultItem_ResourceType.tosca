"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server InviteActionResultItem"
package     = openapi_server
version     = "1.0"
description = "Defines a InviteActionResultItem"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  InviteBusinessRoleBinding = openapi_server.resourceTypes.InviteBusinessRoleBinding
  InviteExceptionResponse = openapi_server.resourceTypes.InviteExceptionResponse
}
resourceTypes {

  InviteActionResultItem {
    title = InviteActionResultItem
    description = InviteActionResultItem
    derivedFrom = Root
    properties {
        exception {
          type = InviteExceptionResponse
          description = ""
          optional = false
        }
        invite {
          type = InviteBusinessRoleBinding
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  InviteActionResultItem {
    title = InviteActionResultItem
    description = InviteActionResultItem
    implements = openapi_server.resourceTypes.InviteActionResultItem

  }
}
