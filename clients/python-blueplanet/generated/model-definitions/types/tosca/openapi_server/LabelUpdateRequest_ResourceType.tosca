"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LabelUpdateRequest"
package     = openapi_server
version     = "1.0"
description = "Defines a LabelUpdateRequest"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  LabelUpdateItem = openapi_server.resourceTypes.LabelUpdateItem
}
resourceTypes {

  LabelUpdateRequest {
    title = LabelUpdateRequest
    description = LabelUpdateRequest
    derivedFrom = Root
    properties {
        labels {
          type = array
          items.type = LabelUpdateItem
          description = "Labels that you are applying to the campaign."
          optional = true
        }
    }
  }
}

serviceTemplates {

  LabelUpdateRequest {
    title = LabelUpdateRequest
    description = LabelUpdateRequest
    implements = openapi_server.resourceTypes.LabelUpdateRequest

  }
}
