"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LeadFormTestCreate"
package     = openapi_server
version     = "1.0"
description = "Defines a LeadFormTestCreate"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  LeadFormTestCreate {
    title = LeadFormTestCreate
    description = LeadFormTestCreate
    derivedFrom = Root
    properties {
        answers {
          type = array
          items.type =  string
          description = "Test lead answers. Should follow the creation order."
          optional = true
        }
    }
  }
}

serviceTemplates {

  LeadFormTestCreate {
    title = LeadFormTestCreate
    description = LeadFormTestCreate
    implements = openapi_server.resourceTypes.LeadFormTestCreate

  }
}
