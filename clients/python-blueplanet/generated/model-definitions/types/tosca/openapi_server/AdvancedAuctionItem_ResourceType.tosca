"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AdvancedAuctionItem"
package     = openapi_server
version     = "1.0"
description = "Defines a AdvancedAuctionItem"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  AdvancedAuctionBidOptions = openapi_server.resourceTypes.AdvancedAuctionBidOptions
  Country = openapi_server.resourceTypes.Country
  Language = openapi_server.resourceTypes.Language
}
resourceTypes {

  AdvancedAuctionItem {
    title = AdvancedAuctionItem
    description = AdvancedAuctionItem
    derivedFrom = Root
    properties {
        bid_options {
          type = AdvancedAuctionBidOptions
          description = ""
          optional = true
        }
        country {
          type = Country
          description = ""
          optional = true
        }
        item_id {
          type =  string
          description = "The catalog retail item id in the merchant namespace"
          optional = true
        }
        language {
          type = Language
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  AdvancedAuctionItem {
    title = AdvancedAuctionItem
    description = AdvancedAuctionItem
    implements = openapi_server.resourceTypes.AdvancedAuctionItem

  }
}
