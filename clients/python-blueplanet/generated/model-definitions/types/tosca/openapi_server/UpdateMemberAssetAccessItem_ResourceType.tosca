"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server UpdateMemberAssetAccessItem"
package     = openapi_server
version     = "1.0"
description = "Defines a UpdateMemberAssetAccessItem"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  Permissions = openapi_server.resourceTypes.Permissions
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  UpdateMemberAssetAccessItem {
    title = UpdateMemberAssetAccessItem
    description = UpdateMemberAssetAccessItem
    derivedFrom = Root
    properties {
        asset_id {
          type =  string
          description = "Id of the asset to update."
          optional = true
        }
        member_id {
          type =  string
          description = "Unique identifier of the member on which to perform the update"
          optional = true
        }
        permissions {
          type = array
          items.type = Permissions
          description = "A non-empty array of permissions to assign to the member."
          optional = true
        }
    }
  }
}

serviceTemplates {

  UpdateMemberAssetAccessItem {
    title = UpdateMemberAssetAccessItem
    description = UpdateMemberAssetAccessItem
    implements = openapi_server.resourceTypes.UpdateMemberAssetAccessItem

  }
}
