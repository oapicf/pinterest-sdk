          optional = true
        }
        catalog_type {
          type =  string
          description = ""
          enum = ["CREATIVE_ASSETS"]
          optional = true
        }
        country {
          type = Country
          description = ""
          optional = true
        }
        locale {
          type = CatalogsLocale
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  CatalogsListProductsByFilterRequest {
    title = CatalogsListProductsByFilterRequest
    description = CatalogsListProductsByFilterRequest
    implements = openapi_server.resourceTypes.CatalogsListProductsByFilterRequest

