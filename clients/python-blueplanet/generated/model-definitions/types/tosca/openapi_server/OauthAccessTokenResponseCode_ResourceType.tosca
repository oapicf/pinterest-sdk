"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server OauthAccessTokenResponseCode"
package     = openapi_server
version     = "1.0"
description = "Defines a OauthAccessTokenResponseCode"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  OauthAccessTokenResponseCode {
    title = OauthAccessTokenResponseCode
    description = OauthAccessTokenResponseCode
    derivedFrom = Root
    properties {
        refresh_token {
          type =  string
          description = ""
          optional = false
        }
        refresh_token_expires_at {
          type =  integer
          description = ""
          optional = false
        }
        refresh_token_expires_in {
          type =  integer
          description = ""
          optional = false
        }
        access_token {
          type =  string
          description = ""
          optional = true
        }
        expires_in {
          type =  integer
          description = ""
          optional = true
        }
        response_type {
          type =  string
          description = ""
          enum = ["authorization_code", "refresh_token", "client_credentials"]
          optional = false
        }
        scope {
          type =  string
          description = ""
          optional = true
        }
        token_type {
          type =  string
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  OauthAccessTokenResponseCode {
    title = OauthAccessTokenResponseCode
    description = OauthAccessTokenResponseCode
    implements = openapi_server.resourceTypes.OauthAccessTokenResponseCode

  }
}
