"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CreateAssetAccessRequestResponse"
package     = openapi_server
version     = "1.0"
description = "Defines a CreateAssetAccessRequestResponse"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  AssetAccessRequestError = openapi_server.resourceTypes.AssetAccessRequestError
}
resourceTypes {

  CreateAssetAccessRequestResponse {
    title = CreateAssetAccessRequestResponse
    description = CreateAssetAccessRequestResponse
    derivedFrom = Root
    properties {
        exceptions {
          type = array
          items.type = AssetAccessRequestError
          description = "A list of errors associated with the asset access requests. Will be returned if there is an error."
          optional = false
        }
        invites {
          # TODO
          description = "An object mapping each partner id to the asset access request id. Only one request id is returned per partner."
          optional = false
        }
    }
  }
}

serviceTemplates {

  CreateAssetAccessRequestResponse {
    title = CreateAssetAccessRequestResponse
    description = CreateAssetAccessRequestResponse
    implements = openapi_server.resourceTypes.CreateAssetAccessRequestResponse

  }
}
