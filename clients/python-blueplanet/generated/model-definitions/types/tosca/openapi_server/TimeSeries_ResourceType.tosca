"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server TimeSeries"
package     = openapi_server
version     = "1.0"
description = "Defines a TimeSeries"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  TimeSeries {
    title = TimeSeries
    description = TimeSeries
    derivedFrom = Root
    properties {
        _date {
          type =  string
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  TimeSeries {
    title = TimeSeries
    description = TimeSeries
    implements = openapi_server.resourceTypes.TimeSeries

  }
}
