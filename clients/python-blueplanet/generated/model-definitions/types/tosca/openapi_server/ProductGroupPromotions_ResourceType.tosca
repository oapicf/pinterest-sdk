version     = "1.0"
description = "Defines a ProductGroupPromotions"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  ProductGroupPromotionResponseItem = openapi_server.resourceTypes.ProductGroupPromotionResponseItem
}
resourceTypes {

  ProductGroupPromotions {
    title = ProductGroupPromotions
