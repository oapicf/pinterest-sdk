"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AdResponse"
package     = openapi_server
version     = "1.0"
description = "Defines a AdResponse"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CreativeType = openapi_server.resourceTypes.CreativeType
  CustomizableCTAType = openapi_server.resourceTypes.CustomizableCTAType
  DisclosureType = openapi_server.resourceTypes.DisclosureType
  EntityStatus = openapi_server.resourceTypes.EntityStatus
  GridClickType = openapi_server.resourceTypes.GridClickType
  PinPromotionSummaryStatus = openapi_server.resourceTypes.PinPromotionSummaryStatus
  QuizPinData = openapi_server.resourceTypes.QuizPinData
  TrackingUrls = openapi_server.resourceTypes.TrackingUrls
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  AdResponse {
    title = AdResponse
    description = AdResponse
    derivedFrom = Root
    properties {
        ad_group_id {
          type =  string
          description = "ID of the ad group that contains the ad."
          optional = false
        }
        android_deep_link {
          type =  string
          description = "Deep link URL for Android devices."
          optional = false
        }
        carousel_android_deep_links {
          type = array
          items.type =  string
          description = "Comma-separated deep links for the carousel pin on Android."
          optional = false
        }
        carousel_destination_urls {
          type = array
          items.type =  string
          description = "Comma-separated destination URLs for the carousel pin to promote."
          optional = false
        }
        carousel_ios_deep_links {
          type = array
          items.type =  string
          description = "Comma-separated deep links for the carousel pin on iOS."
          optional = false
        }
        click_tracking_url {
          type =  string
          description = "Tracking url for the ad clicks."
          optional = false
        }
        creative_type {
          type = CreativeType
          description = ""
          optional = false
        }
        customizable_cta_type {
          type = CustomizableCTAType
          description = ""
          optional = false
        }
        destination_url {
          type =  string
          description = "Destination URL."
          optional = false
        }
        disclosure_type {
          type = DisclosureType
          description = ""
          optional = false
        }
        disclosure_url {
          type =  string
          description = "URL for a page that provides disclosures about a pharmaceutical product, such as potential side effects. Make sure the URL takes the user directly to the disclosure content and the referenced site is secure."
          optional = false
        }
        grid_click_type {
          type = GridClickType
          description = ""
          optional = false
        }
        ios_deep_link {
          type =  string
          description = "Deep link URL for iOS devices."
          optional = false
        }
        is_pin_deleted {
          type =  boolean
          description = "Is original pin deleted?"
          optional = false
        }
        is_removable {
          type =  boolean
          description = "Is pin repinnable?"
          optional = false
        }
        lead_form_id {
          type =  string
          description = "Lead form ID for lead ad generation."
          optional = false
        }
        name {
          type =  string
          description = "Name of the ad - 255 chars max."
          optional = false
        }
        quiz_pin_data {
          type = QuizPinData
          description = "Before creating a quiz ad, you must create an organic Pin using POST/Create Pin for each result in the quiz. Quiz ads cannot be saved by a Pinner. Quiz ad results can be saved."
          optional = false
        }
        status {
          type = EntityStatus
          description = ""
          optional = false
        }
        tracking_urls {
          type = TrackingUrls
          description = ""
          optional = false
        }
        view_tracking_url {
          type =  string
          description = "Tracking URL for ad impressions."
          optional = false
        }
        pin_id {
          type =  string
          description = "Pin ID."
          optional = false
        }
        ad_account_id {
          type =  string
          description = "The ID of the advertiser that this ad belongs to."
          optional = false
        }
        campaign_id {
          type =  string
          description = "ID of the ad campaign that contains this ad."
          optional = false
        }
        collection_items_destination_url_template {
          type =  string
          description = "Destination URL template for all items within a collections drawer."
          optional = false
        }
        created_time {
          type =  integer
          description = "Pin creation time. Unix timestamp in seconds."
          optional = false
        }
        id {
          type =  string
          description = "The ID of this ad."
          optional = false
        }
        rejected_reasons {
          type = array
          items.type =  string
          description = "Enum reason why the pin was rejected. Returned if &lt;code&gt;review_status&lt;/code&gt; is \&quot;REJECTED\&quot;."
          enum = ["HASHTAGS", "PROMOTIONS_AND_PRICES", "TARGETING", "LANDING_PAGE", "CAPS_AND_SYMBOLS", "SHOCKING", "WEIGHT_LOSS", "PROHIBITED_PRODUCT", "AUTHENTICITY", "NUDITY", "CONFUSING_DESIGN", "URGENCY", "RATINGS", "APP", "ALCOHOL", "CONTESTS", "POLITICAL", "OTHER", "IMAGE", "NAR", "INCONSISTENT", "CLICKBAIT", "NO_DESCRIPTION", "LOW_QUALITY", "EXAGGERATED_CLAIMS", "PINTEREST_BRAND", "ALCOHOL_NO_SALE", "LANDING_PAGE_SPEED", "LANDING_PAGE_HARDWALL", "LANDING_PAGE_BROKEN", "LANDING_PAGE_QUALITY", "OUT_OF_STOCK", "IMAGE_LOW_QUALITY", "IMAGE_BUSY", "IMAGE_POORLY_EDITED", "IMAGE_BEFORE_AFTER", "UGC", "FAKE_BUTTONS", "WEAPONS", "SENSITIVE", "UNACCEPTABLE_BUSINESS", "SUSPICIOUS_CLAIMS", "PHARMA", "SUSPICIOUS_SUPPLEMENTS", "ILLEGAL_RECREATIONAL_DRUG", "LOW_QUALITY_LANDING_PAGE", "RESTRICTED_HEALTHCARE", "INCONSISTENT_LANG_FR"]
          optional = false
        }
        rejection_labels {
          type = array
          items.type =  string
          description = "Text reason why the pin was rejected. Returned if &lt;code&gt;review_status&lt;/code&gt; is \&quot;REJECTED\&quot;."
          optional = false
        }
        review_status {
          type =  string
          description = "Ad review status"
          enum = ["OTHER", "PENDING", "REJECTED", "APPROVED"]
          optional = false
        }
        summary_status {
          type = PinPromotionSummaryStatus
          description = "Ad summary status"
          optional = false
        }
        type {
          type =  string
          description = "Always \&quot;ad\&quot;."
          optional = false
        }
        updated_time {
          type =  integer
          description = "Last update time. Unix timestamp in seconds."
          optional = false
        }
    }
  }
}

serviceTemplates {

  AdResponse {
    title = AdResponse
    description = AdResponse
    implements = openapi_server.resourceTypes.AdResponse

  }
}
