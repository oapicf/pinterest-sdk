"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server Pin"
package     = openapi_server
version     = "1.0"
description = "Defines a Pin"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  AiDisclosures = openapi_server.resourceTypes.AiDisclosures
  BoardOwner = openapi_server.resourceTypes.BoardOwner
  CreativeType = openapi_server.resourceTypes.CreativeType
  PinMedia = openapi_server.resourceTypes.PinMedia
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  Pin {
    title = Pin
    description = Pin
    derivedFrom = Root
    properties {
        ai_disclosures {
          type = AiDisclosures
          description = "AI disclosure declarations the creator has made about this Pin."
          optional = false
        }
        board_id {
          type =  string
          description = "The board to which this Pin belongs."
          optional = false
        }
        board_owner {
          type = BoardOwner
          description = ""
          optional = false
        }
        board_section_id {
          type =  string
          description = "The board section to which this Pin belongs."
          optional = false
        }
        created_at {
          type =  string
          description = ""
          optional = false
        }
        creative_type {
          type = CreativeType
          description = ""
          optional = false
        }
        dominant_color {
          type =  string
          description = "Dominant pin color. Hex number, e.g. &#x60;#6E7874&#x60;."
          optional = false
        }
        has_been_promoted {
          type =  boolean
          description = "Whether the Pin has been promoted or not."
          optional = false
        }
        id {
          type =  string
          description = ""
          optional = true
        }
        is_owner {
          type =  boolean
          description = "Whether the \&quot;operation user_account\&quot; is the Pin owner."
          optional = false
        }
        is_product {
          type =  boolean
          description = "Whether the Pin is a product Pin."
          optional = false
        }
        is_standard {
          type =  boolean
          description = "Whether the Pin is standard or not. See documentation on [Changes to Pin creation](/docs/api-features/content-overview/) for more information."
          optional = false
        }
        media {
          type = PinMedia
          description = ""
          optional = false
        }
        parent_pin_id {
          type =  string
          description = "The source pin id if this pin was saved from another pin. [Learn more](https://help.pinterest.com/article/save-pins-on-pinterest)."
          optional = false
        }
        pin_metrics {
          type =  
          description = "Pin metrics with associated time intervals if any."
          optional = false
        }
        alt_text {
          type =  string
          description = ""
          optional = false
        }
        description {
          type =  string
          description = ""
          optional = false
        }
        link {
          type =  string
          description = ""
          optional = false
        }
        title {
          type =  string
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  Pin {
    title = Pin
    description = Pin
    implements = openapi_server.resourceTypes.Pin

  }
}
