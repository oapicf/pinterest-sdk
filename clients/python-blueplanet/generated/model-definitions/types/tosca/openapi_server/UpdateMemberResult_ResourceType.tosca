"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server UpdateMemberResult"
package     = openapi_server
version     = "1.0"
description = "Defines a UpdateMemberResult"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  UpdateMemberResult {
    title = UpdateMemberResult
    description = UpdateMemberResult
    derivedFrom = Root
    properties {
        business_role {
          type =  string
          description = "The access level a member has to the business. Values are case-sensitive. &lt;br&gt; - EMPLOYEE: Can only view and access assets you assign to them. They cannot see details about other employees, partners, or other assets. &lt;br&gt; - BIZ_ADMIN: Have full control of roles and can add employees and partners as well as grant asset access."
          optional = false
        }
        member_id {
          type =  string
          description = "Unique identifier of the business member."
          optional = false
        }
    }
  }
}

serviceTemplates {

  UpdateMemberResult {
    title = UpdateMemberResult
    description = UpdateMemberResult
    implements = openapi_server.resourceTypes.UpdateMemberResult

  }
}
