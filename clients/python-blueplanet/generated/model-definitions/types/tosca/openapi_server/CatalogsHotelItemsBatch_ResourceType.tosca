"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsHotelItemsBatch"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsHotelItemsBatch"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  BatchOperationStatus = openapi_server.resourceTypes.BatchOperationStatus
  HotelProcessingRecord = openapi_server.resourceTypes.HotelProcessingRecord
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CatalogsHotelItemsBatch {
    title = CatalogsHotelItemsBatch
    description = CatalogsHotelItemsBatch
    derivedFrom = Root
    properties {
        batch_id {
          type =  string
          description = "Id of the catalogs items batch"
          optional = false
        }
        catalog_type {
          type =  string
          description = ""
          enum = ["HOTEL"]
          optional = true
        }
        completed_time {
          type =  string
          description = "Date and time (UTC) of the batch completion: YYYY-MM-DD&#39;T&#39;hh:mm:ss"
          optional = false
        }
        created_time {
          type =  string
          description = "Date and time (UTC) of the batch creation: YYYY-MM-DD&#39;T&#39;hh:mm:ss"
          optional = false
        }
        items {
          type = array
          items.type = HotelProcessingRecord
          description = "Array with the catalogs items processing records part of the catalogs items batch"
          optional = false
        }
        status {
          type = BatchOperationStatus
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  CatalogsHotelItemsBatch {
    title = CatalogsHotelItemsBatch
    description = CatalogsHotelItemsBatch
    implements = openapi_server.resourceTypes.CatalogsHotelItemsBatch

  }
}
