"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsItemsBatchRequest"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsItemsBatchRequest"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  BatchOperation = openapi_server.resourceTypes.BatchOperation
  CatalogsItemsCreateBatchRequest = openapi_server.resourceTypes.CatalogsItemsCreateBatchRequest
  CatalogsItemsDeleteBatchRequest = openapi_server.resourceTypes.CatalogsItemsDeleteBatchRequest
  CatalogsItemsDeleteDiscontinuedBatchRequest = openapi_server.resourceTypes.CatalogsItemsDeleteDiscontinuedBatchRequest
  CatalogsItemsUpdateBatchRequest = openapi_server.resourceTypes.CatalogsItemsUpdateBatchRequest
  CatalogsItemsUpsertBatchRequest = openapi_server.resourceTypes.CatalogsItemsUpsertBatchRequest
  Country = openapi_server.resourceTypes.Country
  ItemDeleteBatchRecord = openapi_server.resourceTypes.ItemDeleteBatchRecord
}
resourceTypes {

  CatalogsItemsBatchRequest {
    title = CatalogsItemsBatchRequest
    description = CatalogsItemsBatchRequest
    derivedFrom = Root
    properties {
        country {
          type = Country
          description = ""
          optional = true
        }
        items {
          type = array
          items.type = ItemDeleteBatchRecord
          description = "Array with catalogs items"
          optional = true
        }
        language {
          type =  string
          description = "We recommend using the CatalogsLocale values."
          enum = ["af-ZA", "ar-SA", "bg-BG", "bn-IN", "cs-CZ", "da-DK", "de", "el-GR", "en-AU", "en-CA", "en-GB", "en-IN", "en-US", "es-419", "es-AR", "es-ES", "es-MX", "fi-FI", "fr", "fr-CA", "he-IL", "hi-IN", "hr-HR", "hu-HU", "id-ID", "it", "ja", "ko-KR", "ms-MY", "nb-NO", "nl", "pl-PL", "pt-BR", "pt-PT", "ro-RO", "ru-RU", "sk-SK", "sv-SE", "te-IN", "th-TH", "tl-PH", "tr", "uk-UA", "vi-VN", "zh-CN", "zh-TW", "AM", "AR", "AZ", "BG", "BN", "BS", "CA", "CS", "DA", "DV", "DZ", "DE", "EL", "EN", "ES", "ET", "FA", "FI", "FR", "HE", "HI", "HR", "HU", "HY", "ID", "IN", "IS", "IT", "IW", "JA", "KA", "KM", "KO", "LO", "LT", "LV", "MK", "MN", "MS", "MY", "NB", "NE", "NL", "NO", "PL", "PT", "RO", "RU", "SK", "SL", "SQ", "SR", "SV", "TL", "UK", "VI", "TE", "TH", "TR", "XX", "ZH"]
          optional = true
        }
        operation {
          type = BatchOperation
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  CatalogsItemsBatchRequest {
    title = CatalogsItemsBatchRequest
    description = CatalogsItemsBatchRequest
    implements = openapi_server.resourceTypes.CatalogsItemsBatchRequest

  }
}
