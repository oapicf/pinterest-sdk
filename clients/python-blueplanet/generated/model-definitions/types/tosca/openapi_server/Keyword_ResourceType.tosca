"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server Keyword"
package     = openapi_server
version     = "1.0"
description = "Defines a Keyword"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  MatchType = openapi_server.resourceTypes.MatchType
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  Keyword {
    title = Keyword
    description = Keyword
    derivedFrom = Root
    properties {
        archived {
          type =  boolean
          description = ""
          optional = false
        }
        bid {
          type =  integer
          description = "**Note:** bid field has been deprecated. Input will not be set and field will return null. Keyword custom bid in microcurrency - null if inherited from parent ad group."
          optional = false
        }
        id {
          type =  string
          description = "Keyword ID ."
          optional = true
        }
        match_type {
          type = MatchType
          description = "Keyword [match type](/docs/api-features/targeting-overview/)"
          optional = true
        }
        parent_id {
          type =  string
          description = "Keyword parent entity ID (advertiser, campaign, ad group)."
          optional = true
        }
        parent_type {
          type =  string
          description = "Parent entity type (advertiser, campaign, ad group)."
          optional = false
        }
        type {
          type =  string
          description = "Always keyword"
          optional = false
        }
        value {
          type =  string
          description = "Keyword value (120 chars max)."
          optional = true
        }
    }
  }
}

serviceTemplates {

  Keyword {
    title = Keyword
    description = Keyword
    implements = openapi_server.resourceTypes.Keyword

  }
}
