"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server PartnerMetadata"
package     = openapi_server
version     = "1.0"
description = "Defines a PartnerMetadata"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  PartnerMetadata {
    title = PartnerMetadata
    description = PartnerMetadata
    derivedFrom = Root
    properties {
        subscriber_key {
          type =  string
          description = "Text field value that uniquely identifies a subscriber."
          optional = false
        }
    }
  }
}

serviceTemplates {

  PartnerMetadata {
    title = PartnerMetadata
    description = PartnerMetadata
    implements = openapi_server.resourceTypes.PartnerMetadata

  }
}
