"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ConversionMSOTEvents"
package     = openapi_server
version     = "1.0"
description = "Defines a ConversionMSOTEvents"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  Currency = openapi_server.resourceTypes.Currency
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  ConversionMSOTEvents {
    title = ConversionMSOTEvents
    description = ConversionMSOTEvents
    derivedFrom = Root
    properties {
        action_timestamps {
          type = array
          items.type =  integer
          description = "Timestamp(s) when the ad action(s) happened. Unix timestamp in seconds."
          optional = false
        }
        ad_group_id {
          type =  string
          description = "The ID of the ad group that was attributed to the conversion event."
          optional = true
        }
        attribution_model {
          type =  string
          description = "The attribution model used to attribute the conversion event."
          enum = ["first_touch", "last_touch", "multi_touch"]
          optional = false
        }
        attribution_scope {
          type =  string
          description = "Ad event type."
          enum = ["view", "engagement", "click"]
          optional = true
        }
        attribution_score {
          type =  integer
          description = "Credit given to the attributed ad actions. Allowed values are &gt; 0 and &lt;&#x3D; 1."
          optional = false
        }
        campaign_id {
          type =  string
          description = "The ID of the campaign that was attributed to the conversion event."
          optional = false
        }
        currency {
          type = Currency
          description = ""
          optional = false
        }
        event_id {
          type =  string
          description = "A unique id string that identifies this event. If you are already sending us events through Conversions API, then this id should match the event_id sent through Conversions API."
          optional = true
        }
        event_name {
          type =  string
          description = "Type of user event."
          enum = ["add_to_cart", "checkout", "lead", "signup"]
          optional = true
        }
        event_timestamp {
          type =  integer
          description = "The time when the event occurred. Unix timestamp in seconds."
          optional = true
        }
        total_event_touchpoints {
          type =  integer
          description = "Total number of ad events including other non-Pinterest ad platforms."
          optional = false
        }
        total_events {
          type =  integer
          description = "Total number of conversion events that are reported in one API call. &lt;p&gt;If you are sending one API request for one attributed conversion event then this value should be 1.&lt;/p&gt; &lt;p&gt;If you are sending multiple attributed conversion events in one API request then this value should be the total number of attributed conversion events in the request.&lt;/p&gt;"
          optional = false
        }
        value {
          type =  integer
          description = "Order value of the conversion event. Required if &lt;code&gt;event_name&lt;/code&gt; is &#39;add_to_cart&#39; or &#39;checkout&#39;."
          optional = false
        }
    }
  }
}

serviceTemplates {

  ConversionMSOTEvents {
    title = ConversionMSOTEvents
    description = ConversionMSOTEvents
    implements = openapi_server.resourceTypes.ConversionMSOTEvents

  }
}
