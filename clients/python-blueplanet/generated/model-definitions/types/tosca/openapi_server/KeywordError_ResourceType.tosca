"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server KeywordError"
package     = openapi_server
version     = "1.0"
description = "Defines a KeywordError"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  Keyword = openapi_server.resourceTypes.Keyword
}
resourceTypes {

  KeywordError {
    title = KeywordError
    description = KeywordError
    derivedFrom = Root
    properties {
        data {
          type = Keyword
          description = ""
          optional = false
        }
        error_messages {
          type = array
          items.type =  string
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  KeywordError {
    title = KeywordError
    description = KeywordError
    implements = openapi_server.resourceTypes.KeywordError

  }
}
