"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AudienceDefinitionType"
package     = openapi_server
version     = "1.0"
description = "Defines a AudienceDefinitionType"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  AudienceDefinitionType {
    title = AudienceDefinitionType
    description = AudienceDefinitionType
    derivedFrom = Root
    properties {
        scope {
          type =  string
          description = ""
          enum = ["IMPRESSION_PLUS_ENGAGEMENT", "ENGAGEMENT"]
          optional = false
        }
    }
  }
}

serviceTemplates {

  AudienceDefinitionType {
    title = AudienceDefinitionType
    description = AudienceDefinitionType
    implements = openapi_server.resourceTypes.AudienceDefinitionType

  }
}
