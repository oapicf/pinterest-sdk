"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LocalInventoryItemResponse"
package     = openapi_server
version     = "1.0"
description = "Defines a LocalInventoryItemResponse"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  ItemAvailability = openapi_server.resourceTypes.ItemAvailability
  StoreMetadata = openapi_server.resourceTypes.StoreMetadata
}
resourceTypes {

  LocalInventoryItemResponse {
    title = LocalInventoryItemResponse
    description = LocalInventoryItemResponse
    derivedFrom = Root
    properties {
        ad_link {
          type =  string
          description = "Ad link for the item"
          optional = false
        }
        availability {
          type = ItemAvailability
          description = "Availability status of the item"
          optional = false
        }
        created_at {
          type =  integer
          description = "The millisecond timestamp when the local inventory item was created"
          optional = true
        }
        item_id {
          type =  string
          description = "The catalog item id in the merchant namespace"
          optional = true
        }
        last_updated_time {
          type =  integer
          description = "The millisecond timestamp when the local inventory item was lastly modified by the merchant."
          optional = true
        }
        price {
          type =  string
          description = "The price of the product. It supports the following formats, \&quot;49.99 USD\&quot;, \&quot;49.99USD\&quot; and \&quot;49.99\&quot;. If the currency is not included, we default to US dollars."
          optional = false
        }
        sale_price {
          type =  string
          description = "The sale price of the product. It supports the following formats, \&quot;24.99 USD\&quot;, \&quot;24.99USD\&quot; and \&quot;24.99\&quot;. If the currency is not included, we default to US dollars."
          optional = false
        }
        store_metadata {
          type = StoreMetadata
          description = "Store metadata for this local inventory item"
          optional = true
        }
    }
  }
}

serviceTemplates {

  LocalInventoryItemResponse {
    title = LocalInventoryItemResponse
    description = LocalInventoryItemResponse
    implements = openapi_server.resourceTypes.LocalInventoryItemResponse

  }
}
