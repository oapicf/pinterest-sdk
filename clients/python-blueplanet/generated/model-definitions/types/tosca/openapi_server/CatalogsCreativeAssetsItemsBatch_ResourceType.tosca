"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsCreativeAssetsItemsBatch"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsCreativeAssetsItemsBatch"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  BatchOperationStatus = openapi_server.resourceTypes.BatchOperationStatus
  CreativeAssetsProcessingRecord = openapi_server.resourceTypes.CreativeAssetsProcessingRecord
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CatalogsCreativeAssetsItemsBatch {
    title = CatalogsCreativeAssetsItemsBatch
    description = CatalogsCreativeAssetsItemsBatch
    derivedFrom = Root
    properties {
        batch_id {
          type =  string
          description = "Id of the catalogs items batch"
          optional = false
        }
        catalog_type {
          type =  string
          description = ""
          enum = ["CREATIVE_ASSETS"]
          optional = true
        }
        completed_time {
          type =  string
          description = "Date and time (UTC) of the batch completion: YYYY-MM-DD&#39;T&#39;hh:mm:ss"
          optional = false
        }
        created_time {
          type =  string
          description = "Date and time (UTC) of the batch creation: YYYY-MM-DD&#39;T&#39;hh:mm:ss"
          optional = false
        }
        items {
          type = array
          items.type = CreativeAssetsProcessingRecord
          description = "Array with the catalogs items processing records part of the catalogs items batch"
          optional = false
        }
        status {
          type = BatchOperationStatus
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  CatalogsCreativeAssetsItemsBatch {
    title = CatalogsCreativeAssetsItemsBatch
    description = CatalogsCreativeAssetsItemsBatch
    implements = openapi_server.resourceTypes.CatalogsCreativeAssetsItemsBatch

  }
}
