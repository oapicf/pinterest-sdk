"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ItemValidationEvent"
package     = openapi_server
version     = "1.0"
description = "Defines a ItemValidationEvent"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  ItemValidationEvent {
    title = ItemValidationEvent
    description = ItemValidationEvent
    derivedFrom = Root
    properties {
        attribute {
          type =  string
          description = "The attribute that the item validation event references"
          optional = false
        }
        code {
          type =  integer
          description = "The event code that the item validation event references"
          optional = false
        }
        message {
          type =  string
          description = "Title message describing the item validation event"
          optional = false
        }
    }
  }
}

serviceTemplates {

  ItemValidationEvent {
    title = ItemValidationEvent
    description = ItemValidationEvent
    implements = openapi_server.resourceTypes.ItemValidationEvent

  }
}
