"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ConversionProductReportCreate"
package     = openapi_server
version     = "1.0"
description = "Defines a ConversionProductReportCreate"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  ConversionAttributionWindowDays = openapi_server.resourceTypes.ConversionAttributionWindowDays
  ConversionObjectiveType = openapi_server.resourceTypes.ConversionObjectiveType
  ConversionProductAttributionType = openapi_server.resourceTypes.ConversionProductAttributionType
  ConversionProductReportBreakdownType = openapi_server.resourceTypes.ConversionProductReportBreakdownType
  ConversionProductReportGranularity = openapi_server.resourceTypes.ConversionProductReportGranularity
  ConversionProductReportLevel = openapi_server.resourceTypes.ConversionProductReportLevel
  ConversionProductReportingColumn = openapi_server.resourceTypes.ConversionProductReportingColumn
  ConversionReportTimeType = openapi_server.resourceTypes.ConversionReportTimeType
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  ConversionProductReportCreate {
    title = ConversionProductReportCreate
    description = ConversionProductReportCreate
    derivedFrom = Root
    properties {
        ad_group_ids {
          type = array
          items.type =  string
          description = "  List of ad group ids.   Only support ad_group_ids field when level of the report is AD_GROUP."
          optional = false
        }
        campaign_ids {
          type = array
          items.type =  string
          description = "  List of campaign ids.   Only support campaign_ids field when level of the report is CAMPAIGN."
          optional = false
        }
        campaign_objective_types {
          type = array
          items.type = ConversionObjectiveType
          description = "List of values for filtering. Default is [&#39;CONSIDERATION&#39;,&#39;AWARENESS&#39;,&#39;WEB_CONVERSION&#39;,&#39;VIDEO_COMPLETION&#39;]."
          optional = false
        }
        click_window_days {
          type = ConversionAttributionWindowDays
          description = "Number of days to use as the conversion attribution window for a pin click action. Applies to Pinterest Tag conversion metrics. Prior conversion tags use their defined attribution windows. If not specified, defaults to &#x60;30&#x60; days."
          optional = false
        }
        columns {
          type = array
          items.type = ConversionProductReportingColumn
          description = "Metric and entity columns"
          optional = true
        }
        conversion_product_attribution_type {
          type = ConversionProductAttributionType
          description = "  Required attribution type of the B/C/S report.   When the attribution type is BRAND_ATTRIBUTION, start_date for the report must be after 2025-04-01."
          optional = false
        }
        conversion_product_breakdown {
          type = ConversionProductReportBreakdownType
          description = "Report breakdown type. This is used to specify the breakdown of the report by brand, category, or SKU."
          optional = false
        }
        conversion_report_time {
          type = ConversionReportTimeType
          description = "The date by which the conversion metrics returned from this endpoint will be reported. There are two dates associated with a conversion event: the date that the user interacted with the ad, and the date that the user completed a conversion event."
          optional = false
        }
        end_date {
          type =  string
          description = "  Metric report end date (UTC). Format: YYYY-MM-DD.   A max of 1 year is allowed between the start and end date for reports."
          optional = true
        }
        granularity {
          type = ConversionProductReportGranularity
          description = "Report granularity for time-based metric aggregation"
          optional = true
        }
        level {
          type = ConversionProductReportLevel
          description = "Level of the report"
          optional = true
        }
        product_sku_ids {
          type = array
          items.type =  string
          description = "  List of SKU ids.   Only support product_sku_ids field when report breakdown type is PRODUCT_SKU_GROUP."
          optional = false
        }
        report_name {
          type =  string
          description = "Name of the conversion product report"
          optional = true
        }
        start_date {
          type =  string
          description = "  Metric report start date (UTC). Format: YYYY-MM-DD.   Start date must be after 2024-03-16. 7 day minimum time window for report is required."
          optional = true
        }
        view_window_days {
          type = ConversionAttributionWindowDays
          description = "Number of days to use as the conversion attribution window for a view action. Applies to Pinterest Tag conversion metrics. Prior conversion tags use their defined attribution windows. If not specified, defaults to &#x60;1&#x60; day."
          optional = false
        }
    }
  }
}

serviceTemplates {

  ConversionProductReportCreate {
    title = ConversionProductReportCreate
    description = ConversionProductReportCreate
    implements = openapi_server.resourceTypes.ConversionProductReportCreate

  }
}
