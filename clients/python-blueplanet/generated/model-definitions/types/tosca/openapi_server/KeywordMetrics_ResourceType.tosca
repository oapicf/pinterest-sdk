"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server KeywordMetrics"
package     = openapi_server
version     = "1.0"
description = "Defines a KeywordMetrics"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  KeywordMetrics {
    title = KeywordMetrics
    description = KeywordMetrics
    derivedFrom = Root
    properties {
        keyword_query_volume {
          type =  string
          description = "Keyword&#39;s search frequency. This value is based on keyword frequency in pepsi client response"
          optional = false
        }
    }
  }
}

serviceTemplates {

  KeywordMetrics {
    title = KeywordMetrics
    description = KeywordMetrics
    implements = openapi_server.resourceTypes.KeywordMetrics

  }
}
