"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AllOf"
package     = openapi_server
version     = "1.0"
description = "Defines a AllOf"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsProductGroupFilterKeys = openapi_server.resourceTypes.CatalogsProductGroupFilterKeys
}
resourceTypes {

  AllOf {
    title = AllOf
    description = AllOf
    derivedFrom = Root
    properties {
        all_of {
          type = array
          items.type = CatalogsProductGroupFilterKeys
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  AllOf {
    title = AllOf
    description = AllOf
    implements = openapi_server.resourceTypes.AllOf

  }
}
