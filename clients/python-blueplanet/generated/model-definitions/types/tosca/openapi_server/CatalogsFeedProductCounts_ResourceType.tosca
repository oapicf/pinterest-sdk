"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsFeedProductCounts"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsFeedProductCounts"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  CatalogsFeedProductCounts {
    title = CatalogsFeedProductCounts
    description = CatalogsFeedProductCounts
    derivedFrom = Root
    properties {
        ingested {
          type =  integer
          description = "The number of products successfully ingested from the feed file."
          optional = false
        }
        original {
          type =  integer
          description = "The number of products in the feed file."
          optional = false
        }
    }
  }
}

serviceTemplates {

  CatalogsFeedProductCounts {
    title = CatalogsFeedProductCounts
    description = CatalogsFeedProductCounts
    implements = openapi_server.resourceTypes.CatalogsFeedProductCounts

  }
}
