"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server OrderLineError"
package     = openapi_server
version     = "1.0"
description = "Defines a OrderLineError"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  OrderLine = openapi_server.resourceTypes.OrderLine
}
resourceTypes {

  OrderLineError {
    title = OrderLineError
    description = OrderLineError
    derivedFrom = Root
    properties {
        data {
          type = OrderLine
          description = ""
          optional = false
        }
        error_messages {
          type = array
          items.type =  string
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  OrderLineError {
    title = OrderLineError
    description = OrderLineError
    implements = openapi_server.resourceTypes.OrderLineError

  }
}
