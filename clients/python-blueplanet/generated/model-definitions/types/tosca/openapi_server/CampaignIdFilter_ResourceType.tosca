"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CampaignIdFilter"
package     = openapi_server
version     = "1.0"
description = "Defines a CampaignIdFilter"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  CampaignIdFilter {
    title = CampaignIdFilter
    description = CampaignIdFilter
    derivedFrom = Root
    properties {
        campaign_ids {
          type = array
          items.type =  string
          description = "List of campaign ids"
          optional = false
        }
    }
  }
}

serviceTemplates {

  CampaignIdFilter {
    title = CampaignIdFilter
    description = CampaignIdFilter
    implements = openapi_server.resourceTypes.CampaignIdFilter

  }
}
