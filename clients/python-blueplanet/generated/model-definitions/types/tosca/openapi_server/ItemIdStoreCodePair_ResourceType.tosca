"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ItemIdStoreCodePair"
package     = openapi_server
version     = "1.0"
description = "Defines a ItemIdStoreCodePair"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  ItemIdStoreCodePair {
    title = ItemIdStoreCodePair
    description = ItemIdStoreCodePair
    derivedFrom = Root
    properties {
        item_id {
          type =  string
          description = "Catalog item id in the merchant namespace"
          optional = true
        }
        store_code {
          type =  string
          description = "Store code for the local inventory item"
          optional = true
        }
    }
  }
}

serviceTemplates {

  ItemIdStoreCodePair {
    title = ItemIdStoreCodePair
    description = ItemIdStoreCodePair
    implements = openapi_server.resourceTypes.ItemIdStoreCodePair

  }
}
