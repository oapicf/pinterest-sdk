"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AdvertiserDefinedEventProcessingRecord"
package     = openapi_server
version     = "1.0"
description = "Defines a AdvertiserDefinedEventProcessingRecord"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  AdvertiserDefinedEventProcessingRecord {
    title = AdvertiserDefinedEventProcessingRecord
    description = AdvertiserDefinedEventProcessingRecord
    derivedFrom = Root
    properties {
        exceptions {
          type = array
          items.type =  string
          description = "List of exception messages if the operation failed"
          optional = false
        }
        name {
          type =  string
          description = "Name of the advertiser defined event"
          optional = true
        }
        status {
          type =  string
          description = "Processing status (success or failure)"
          optional = true
        }
    }
  }
}

serviceTemplates {

  AdvertiserDefinedEventProcessingRecord {
    title = AdvertiserDefinedEventProcessingRecord
    description = AdvertiserDefinedEventProcessingRecord
    implements = openapi_server.resourceTypes.AdvertiserDefinedEventProcessingRecord

  }
}
