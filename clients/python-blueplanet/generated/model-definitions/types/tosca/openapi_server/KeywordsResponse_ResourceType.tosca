"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server KeywordsResponse"
package     = openapi_server
version     = "1.0"
description = "Defines a KeywordsResponse"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  Keyword = openapi_server.resourceTypes.Keyword
  KeywordError = openapi_server.resourceTypes.KeywordError
}
resourceTypes {

  KeywordsResponse {
    title = KeywordsResponse
    description = KeywordsResponse
    derivedFrom = Root
    properties {
        errors {
          type = array
          items.type = KeywordError
          description = ""
          optional = false
        }
        keywords {
          type = array
          items.type = Keyword
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  KeywordsResponse {
    title = KeywordsResponse
    description = KeywordsResponse
    implements = openapi_server.resourceTypes.KeywordsResponse

  }
}
