"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server IneligibleProductTagErrorItem"
package     = openapi_server
version     = "1.0"
description = "Defines a IneligibleProductTagErrorItem"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  IneligibleProductTagReason = openapi_server.resourceTypes.IneligibleProductTagReason
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  IneligibleProductTagErrorItem {
    title = IneligibleProductTagErrorItem
    description = IneligibleProductTagErrorItem
    derivedFrom = Root
    properties {
        error_message {
          type = IneligibleProductTagReason
          description = "Reason why the pin is ineligible for tagging."
          optional = true
        }
        pin_id {
          type =  string
          description = "Pin ID that failed eligibility check."
          optional = true
        }
    }
  }
}

serviceTemplates {

  IneligibleProductTagErrorItem {
    title = IneligibleProductTagErrorItem
    description = IneligibleProductTagErrorItem
    implements = openapi_server.resourceTypes.IneligibleProductTagErrorItem

  }
}
