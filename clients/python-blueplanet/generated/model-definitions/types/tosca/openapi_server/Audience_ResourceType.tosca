"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server Audience"
package     = openapi_server
version     = "1.0"
description = "Defines a Audience"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  AudienceRule = openapi_server.resourceTypes.AudienceRule
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  Audience {
    title = Audience
    description = Audience
    derivedFrom = Root
    properties {
        ad_account_id {
          type =  string
          description = "Ad account ID."
          optional = false
        }
        audience_type {
          type =  string
          description = "&lt;a href&#x3D;\&quot;/docs/reference/glossary/#Audience Types\&quot;&gt;Audience types&lt;/a&gt;: ACTALIKE, ENGAGEMENT, CUSTOMER_LIST and VISITOR"
          optional = false
        }
        created_by_company_name {
          type =  string
          description = "The company that created this audience."
          optional = false
        }
        created_timestamp {
          type =  integer
          description = "Creation time. Unix timestamp in seconds."
          optional = false
        }
        description {
          type =  string
          description = "Audience description."
          optional = false
        }
        id {
          type =  string
          description = "Audience ID."
          optional = false
        }
        name {
          type =  string
          description = "Audience name."
          optional = false
        }
        rule {
          type = AudienceRule
          description = ""
          optional = false
        }
        size {
          type =  integer
          description = "Audience size."
          optional = false
        }
        status {
          type =  string
          description = "Audience status. READY, INITIALIZING, TOO_SMALL - Each audience list needs to have at least 100 people with Pinterest accounts before you can start using it."
          optional = false
        }
        type {
          type =  string
          description = "Always \&quot;audience\&quot;."
          optional = false
        }
        updated_timestamp {
          type =  integer
          description = "Last update time. Unix timestamp in seconds."
          optional = false
        }
    }
  }
}

serviceTemplates {

  Audience {
    title = Audience
    description = Audience
    implements = openapi_server.resourceTypes.Audience

  }
}
