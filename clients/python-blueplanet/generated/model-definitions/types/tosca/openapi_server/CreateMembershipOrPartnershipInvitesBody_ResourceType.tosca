"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CreateMembershipOrPartnershipInvitesBody"
package     = openapi_server
version     = "1.0"
description = "Defines a CreateMembershipOrPartnershipInvitesBody"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  InviteType = openapi_server.resourceTypes.InviteType
}
resourceTypes {

  CreateMembershipOrPartnershipInvitesBody {
    title = CreateMembershipOrPartnershipInvitesBody
    description = CreateMembershipOrPartnershipInvitesBody
    derivedFrom = Root
    properties {
        business_role {
          type =  string
          description = "The business access level to grant member/partner. Note, values are case-sensitive. - EMPLOYEE: Can only view and access assets you assign them to. They cannot see details about other employees, partners, or other assets. - BIZ_ADMIN: Have full control of roles and can add employees and partners as well as grant asset access. - PARTNER: Can only view and access assets you assign them to/or they assign to you."
          enum = ["EMPLOYEE", "BIZ_ADMIN", "PARTNER"]
          optional = true
        }
        invite_type {
          type = InviteType
          description = ""
          optional = true
        }
        members {
          type = array
          items.type =  string
          description = "A list of usernames, emails, or a mix of them. Should be used if invite_type is MEMBER_INVITE"
          optional = false
        }
        partners {
          type = array
          items.type =  string
          description = "A list of partner_id. Should be used if invite_type is PARTNER_INVITE or PARTNER_REQUEST"
          optional = false
        }
    }
  }
}

serviceTemplates {

  CreateMembershipOrPartnershipInvitesBody {
    title = CreateMembershipOrPartnershipInvitesBody
    description = CreateMembershipOrPartnershipInvitesBody
    implements = openapi_server.resourceTypes.CreateMembershipOrPartnershipInvitesBody

  }
}
