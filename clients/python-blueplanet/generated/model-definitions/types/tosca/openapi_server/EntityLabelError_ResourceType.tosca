"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server EntityLabelError"
package     = openapi_server
version     = "1.0"
description = "Defines a EntityLabelError"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  EntityLabel = openapi_server.resourceTypes.EntityLabel
}
resourceTypes {

  EntityLabelError {
    title = EntityLabelError
    description = EntityLabelError
    derivedFrom = Root
    properties {
        data {
          type = EntityLabel
          description = ""
          optional = false
        }
        error_messages {
          type = array
          items.type =  string
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  EntityLabelError {
    title = EntityLabelError
    description = EntityLabelError
    implements = openapi_server.resourceTypes.EntityLabelError

  }
}
