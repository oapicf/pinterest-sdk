"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ConversionEventDeviceInfo"
package     = openapi_server
version     = "1.0"
description = "Defines a ConversionEventDeviceInfo"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  ConversionEventDeviceInfo {
    title = ConversionEventDeviceInfo
    description = ConversionEventDeviceInfo
    derivedFrom = Root
    properties {
        battery_level {
          type =  integer
          description = "Battery charge level percentage"
          optional = false
        }
        brand {
          type =  string
          description = "Device brand"
          optional = false
        }
        carrier {
          type =  string
          description = "User device&#39;s mobile carrier."
          optional = false
        }
        cpu_cores {
          type =  integer
          description = "Number of CPU cores"
          optional = false
        }
        external_storage_free_space {
          type =  integer
          description = "External storage size in GB"
          optional = false
        }
        external_storage_size {
          type =  integer
          description = "External storage size in GB"
          optional = false
        }
        form_factor {
          type =  string
          description = "Device form factor"
          enum = ["desktop", "laptop", "cellphone", "tablet", "smartwatch", "tv", "vr", "console", "other"]
          optional = false
        }
        kernel_version {
          type =  string
          description = "Kernel version. Examples: Linux: 6.15. Obtain by running: uname -r MacOS: 24.3.0. Obtain by running: sysctl kern.version Android: 6.6. Obtain from OS.uname().release"
          optional = false
        }
        languages {
          type = array
          items.type =  string
          description = "List of user installed languages. ISO 639-1 format"
          optional = false
        }
        locale {
          type =  string
          description = "Device locale BCP-47 format"
          optional = false
        }
        model {
          type =  string
          description = "Device model name"
          optional = false
        }
        network_type {
          type =  string
          description = "Network type: 4G, 5G, ethernet, wifi In Android: NetworkCapabilities.getNetworkCapabilities()"
          enum = ["wifi", "cellular_2g", "cellular_3g", "cellular_4g", "cellular_5g", "cellular_6g", "ethernet", "unknown"]
          optional = false
        }
        os_family {
          type =  string
          description = "OS Family"
          enum = ["ios", "android", "macos", "windows", "linux", "bsd", "other"]
          optional = false
        }
        os_name {
          type =  string
          description = "Short name of the OS. This value if specific to os family. Examples: Windows: 10, 11; Android: 16; iOS: 18; MacOS: 15; Linux: Debian, Ubuntu, Arch"
          optional = false
        }
        os_release_name {
          type =  string
          description = "Marketing name for the release version iOS: Dawn Android: Baklava MacOS: Sequoia Ubuntu Linux: Plucky Puffin"
          optional = false
        }
        os_version {
          type =  string
          description = "Full name of the version. Examples: iOS: 18.3 Android: 16.1 MacOS: 15.5 Windows: 24H2 Ubuntu Linux: 25.04"
          optional = false
        }
        screen_density {
          type =  integer
          description = "Screen density, PPI"
          optional = false
        }
        screen_height {
          type =  integer
          description = "Screen height in pixels"
          optional = false
        }
        screen_width {
          type =  integer
          description = "Screen width in pixels"
          optional = false
        }
        storage_free_space {
          type =  integer
          description = "Internal storage size in GB"
          optional = false
        }
        storage_size {
          type =  integer
          description = "Internal storage size in GB"
          optional = false
        }
        timezone {
          type =  string
          description = "Device timezone"
          optional = false
        }
        timezone_abbr {
          type =  string
          description = "Timezone abbreviation"
          optional = false
        }
        type {
          type =  string
          description = "Device type"
          optional = false
        }
    }
  }
}

serviceTemplates {

  ConversionEventDeviceInfo {
    title = ConversionEventDeviceInfo
    description = ConversionEventDeviceInfo
    implements = openapi_server.resourceTypes.ConversionEventDeviceInfo

  }
}
