authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  BusinessMembershipMember = openapi_server.resourceTypes.BusinessMembershipMember
}
resourceTypes {

  UpdateBusinessMembershipsResponse {
    title = UpdateBusinessMembershipsResponse
    description = UpdateBusinessMembershipsResponse
    derivedFrom = Root
    properties {
        items {
          type = array
          items.type = BusinessMembershipMember
          description = "List of members with updated business access role."
          optional = false
        }
    }
  }
}

serviceTemplates {

