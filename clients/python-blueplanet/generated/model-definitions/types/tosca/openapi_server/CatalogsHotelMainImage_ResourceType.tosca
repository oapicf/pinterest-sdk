"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsHotelMainImage"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsHotelMainImage"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  CatalogsHotelMainImage {
    title = CatalogsHotelMainImage
    description = CatalogsHotelMainImage
    derivedFrom = Root
    properties {
        link {
          type =  string
          description = "&lt;&#x3D; 2000 characters. The link to the main hotel image. Image should be at least 75x75 pixels to avoid errors. Must start with http:// or https://."
          optional = false
        }
        tag {
          type = array
          items.type =  string
          description = "Tag appended to the image that identifies image category or details. There can be multiple tags associated with an image"
          optional = false
        }
    }
  }
}

serviceTemplates {

  CatalogsHotelMainImage {
    title = CatalogsHotelMainImage
    description = CatalogsHotelMainImage
    implements = openapi_server.resourceTypes.CatalogsHotelMainImage

  }
}
