"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server DeletedMembersResponse"
package     = openapi_server
version     = "1.0"
description = "Defines a DeletedMembersResponse"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  DeletedMembersResponse {
    title = DeletedMembersResponse
    description = DeletedMembersResponse
    derivedFrom = Root
    properties {
        deleted_members {
          type = array
          items.type =  string
          description = "List of members whose business membership have been terminated."
          optional = false
        }
    }
  }
}

serviceTemplates {

  DeletedMembersResponse {
    title = DeletedMembersResponse
    description = DeletedMembersResponse
    implements = openapi_server.resourceTypes.DeletedMembersResponse

  }
}
