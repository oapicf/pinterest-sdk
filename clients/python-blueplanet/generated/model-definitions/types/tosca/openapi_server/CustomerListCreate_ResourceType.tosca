"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CustomerListCreate"
package     = openapi_server
version     = "1.0"
description = "Defines a CustomerListCreate"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CustomerListRecordRow = openapi_server.resourceTypes.CustomerListRecordRow
  UserListType = openapi_server.resourceTypes.UserListType
}
resourceTypes {

  CustomerListCreate {
    title = CustomerListCreate
    description = CustomerListCreate
    derivedFrom = Root
    properties {
        is_nca {
          type =  boolean
          description = "Whether the list was uploaded for new customer acquisition (expanded matching). Immutable after creation."
          optional = false
        }
        list_type {
          type = UserListType
          description = "Type of customer list (e.g., EMAIL, IDFA, MAID)."
          optional = false
        }
        name {
          type =  string
          description = "Customer list name."
          optional = true
        }
        records {
          type =  string
          description = "Records list. Can be any combination of emails, MAIDs, or IDFAs. Emails must be lowercase and can be plain text or hashed using SHA1, SHA256, or MD5. MAIDs and IDFAs must be hashed with SHA1, SHA256, or MD5."
          optional = false
        }
        records_v2 {
          type = array
          items.type = CustomerListRecordRow
          description = "Multi-field record format. Array of objects with optional email, maid, ip_address, user_agent, external_id, hashed_pinner_id, hashed_phone_number, and liveramp_envelope per row. Provide exactly one of records or records_v2."
          optional = false
        }
    }
  }
}

serviceTemplates {

  CustomerListCreate {
    title = CustomerListCreate
    description = CustomerListCreate
    implements = openapi_server.resourceTypes.CustomerListCreate

  }
}
