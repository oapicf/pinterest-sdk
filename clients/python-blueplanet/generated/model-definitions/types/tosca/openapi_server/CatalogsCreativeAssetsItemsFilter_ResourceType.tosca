"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsCreativeAssetsItemsFilter"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsCreativeAssetsItemsFilter"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CatalogsCreativeAssetsItemsFilter {
    title = CatalogsCreativeAssetsItemsFilter
    description = CatalogsCreativeAssetsItemsFilter
    derivedFrom = Root
    properties {
        catalog_id {
          type =  string
          description = "Catalog id pertaining to the creative assets item. If not provided, default to oldest creative assets catalog"
          optional = false
        }
        catalog_type {
          type =  string
          description = ""
          enum = ["CREATIVE_ASSETS"]
          optional = true
        }
        creative_assets_ids {
          type = array
          items.type =  string
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  CatalogsCreativeAssetsItemsFilter {
    title = CatalogsCreativeAssetsItemsFilter
    description = CatalogsCreativeAssetsItemsFilter
    implements = openapi_server.resourceTypes.CatalogsCreativeAssetsItemsFilter

  }
}
