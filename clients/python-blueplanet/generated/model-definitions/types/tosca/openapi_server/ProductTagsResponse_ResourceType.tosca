"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ProductTagsResponse"
package     = openapi_server
version     = "1.0"
description = "Defines a ProductTagsResponse"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  ProductTagItem = openapi_server.resourceTypes.ProductTagItem
}
resourceTypes {

  ProductTagsResponse {
    title = ProductTagsResponse
    description = ProductTagsResponse
    derivedFrom = Root
    properties {
        product_tags {
          type = array
          items.type = ProductTagItem
          description = "List of product tags on the pin."
          optional = true
        }
    }
  }
}

serviceTemplates {

  ProductTagsResponse {
    title = ProductTagsResponse
    description = ProductTagsResponse
    implements = openapi_server.resourceTypes.ProductTagsResponse

  }
}
