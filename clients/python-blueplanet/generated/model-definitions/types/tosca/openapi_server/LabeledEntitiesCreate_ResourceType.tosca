"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LabeledEntitiesCreate"
package     = openapi_server
version     = "1.0"
description = "Defines a LabeledEntitiesCreate"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  LabeledEntitiesCreate {
    title = LabeledEntitiesCreate
    description = LabeledEntitiesCreate
    derivedFrom = Root
    properties {
        entity_ids {
          type = array
          items.type =  string
          description = "Entity IDs to apply label to."
          optional = true
        }
    }
  }
}

serviceTemplates {

  LabeledEntitiesCreate {
    title = LabeledEntitiesCreate
    description = LabeledEntitiesCreate
    implements = openapi_server.resourceTypes.LabeledEntitiesCreate

  }
}
