"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server PlacementMultipliers"
package     = openapi_server
version     = "1.0"
description = "Defines a PlacementMultipliers"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  PlacementType = openapi_server.resourceTypes.PlacementType
}
resourceTypes {

  PlacementMultipliers {
    title = PlacementMultipliers
    description = PlacementMultipliers
    derivedFrom = Root
    properties {
        placement {
          type = PlacementType
          description = "Placement type identifier."
          optional = false
        }
    }
  }
}

serviceTemplates {

  PlacementMultipliers {
    title = PlacementMultipliers
    description = PlacementMultipliers
    implements = openapi_server.resourceTypes.PlacementMultipliers

  }
}
