"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server Board"
package     = openapi_server
version     = "1.0"
description = "Defines a Board"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  BoardMedia = openapi_server.resourceTypes.BoardMedia
  BoardOwner = openapi_server.resourceTypes.BoardOwner
  BoardPrivacy = openapi_server.resourceTypes.BoardPrivacy
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  Board {
    title = Board
    description = Board
    derivedFrom = Root
    properties {
        board_pins_modified_at {
          type =  string
          description = "Date and time of last board pins modified."
          optional = false
        }
        collaborator_count {
          type =  integer
          description = "Count of collaborators on the board."
          optional = false
        }
        created_at {
          type =  string
          description = "Date and time of board creation."
          optional = false
        }
        description {
          type =  string
          description = ""
          optional = false
        }
        follower_count {
          type =  integer
          description = "Board follower count."
          optional = false
        }
        id {
          type =  string
          description = ""
          optional = true
        }
        is_ads_only {
          type =  boolean
          description = "If set to &#x60;true&#x60;, the board will be ad-only and can store ad-only Pins."
          optional = false
        }
        media {
          type = BoardMedia
          description = "Board media."
          optional = false
        }
        name {
          type =  string
          description = "     Name of the board.      **Note:** If you create an ad-only board by setting &#x60;is_ads_only&#x60;     to &#x60;true&#x60;, the board name automatically becomes \&quot;Ad-only Pins\&quot;."
          optional = true
        }
        owner {
          type = BoardOwner
          description = ""
          optional = false
        }
        pin_count {
          type =  integer
          description = "Count of Pins on the board."
          optional = false
        }
        privacy {
          type = BoardPrivacy
          description = "    Privacy setting for a board. Learn more about [secret](https://help.pinterest.com/en/article/secret-boards)     boards and [protected](https://help.pinterest.com/en/business/article/protected-boards) boards.      **Note:** If you create an ad-only board by setting &#x60;is_ads_only&#x60;     to &#x60;true&#x60;, the &#x60;privacy&#x60; settng automatically becomes &#x60;PROTECTED&#x60;. "
          optional = false
        }
    }
  }
}

serviceTemplates {

  Board {
    title = Board
    description = Board
    implements = openapi_server.resourceTypes.Board

  }
}
