"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AuthRespondInviteAction"
package     = openapi_server
version     = "1.0"
description = "Defines a AuthRespondInviteAction"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  Permissions = openapi_server.resourceTypes.Permissions
}
resourceTypes {

  AuthRespondInviteAction {
    title = AuthRespondInviteAction
    description = AuthRespondInviteAction
    derivedFrom = Root
    properties {
        accept_invite {
          type =  boolean
          description = "Whether the invite/request is accepted."
          optional = true
        }
        asset_id_to_permissions {
          # TODO
          description = "An object mapping asset ids to lists of business permissions. This can be used to setting/requesting permissions on various assets. If accepting an invite or request, this object would be used to grant asset permissions to the member or partner."
          optional = false
        }
    }
  }
}

serviceTemplates {

  AuthRespondInviteAction {
    title = AuthRespondInviteAction
    description = AuthRespondInviteAction
    implements = openapi_server.resourceTypes.AuthRespondInviteAction

  }
}
