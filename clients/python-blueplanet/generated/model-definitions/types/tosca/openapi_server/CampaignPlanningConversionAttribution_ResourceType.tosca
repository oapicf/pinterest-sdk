"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CampaignPlanningConversionAttribution"
package     = openapi_server
version     = "1.0"
description = "Defines a CampaignPlanningConversionAttribution"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CampaignPlanningConversionAttributionWindowDays = openapi_server.resourceTypes.CampaignPlanningConversionAttributionWindowDays
}
resourceTypes {

  CampaignPlanningConversionAttribution {
    title = CampaignPlanningConversionAttribution
    description = CampaignPlanningConversionAttribution
    derivedFrom = Root
    properties {
        click_window_days {
          type = CampaignPlanningConversionAttributionWindowDays
          description = "Number of days to use as the conversion attribution window for a pin click action."
          optional = false
        }
        engagement_window_days {
          type = CampaignPlanningConversionAttributionWindowDays
          description = "Number of days to use as the conversion attribution window for an engagement action. Engagements include saves, closeups, link clicks, and carousel card swipes."
          optional = false
        }
        view_window_days {
          type = CampaignPlanningConversionAttributionWindowDays
          description = "Number of days to use as the conversion attribution window for a view action."
          optional = false
        }
    }
  }
}

serviceTemplates {

  CampaignPlanningConversionAttribution {
    title = CampaignPlanningConversionAttribution
    description = CampaignPlanningConversionAttribution
    implements = openapi_server.resourceTypes.CampaignPlanningConversionAttribution

  }
}
