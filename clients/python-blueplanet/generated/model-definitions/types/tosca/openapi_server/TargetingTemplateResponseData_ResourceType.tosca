"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server TargetingTemplateResponseData"
package     = openapi_server
version     = "1.0"
description = "Defines a TargetingTemplateResponseData"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  PlacementGroupType = openapi_server.resourceTypes.PlacementGroupType
  TargetingSpec = openapi_server.resourceTypes.TargetingSpec
  TargetingTemplateAudienceSizing = openapi_server.resourceTypes.TargetingTemplateAudienceSizing
  TargetingTemplateKeyword = openapi_server.resourceTypes.TargetingTemplateKeyword
  TrackingUrls = openapi_server.resourceTypes.TrackingUrls
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  TargetingTemplateResponseData {
    title = TargetingTemplateResponseData
    description = TargetingTemplateResponseData
    derivedFrom = Root
    properties {
        auto_targeting_enabled {
          type =  boolean
          description = "Enable auto-targeting for ad group. Also known as &lt;a href&#x3D;\&quot;https://help.pinterest.com/en/business/article/expanded-targeting\&quot; target&#x3D;\&quot;_blank\&quot;&gt;\&quot;expanded targeting\&quot;&lt;/a&gt;."
          optional = false
        }
        keywords {
          type = array
          items.type = TargetingTemplateKeyword
          description = ""
          optional = false
        }
        name {
          type =  string
          description = "targeting template name"
          optional = false
        }
        placement_group {
          type = PlacementGroupType
          description = ""
          optional = false
        }
        targeting_attributes {
          type = TargetingSpec
          description = ""
          optional = false
        }
        tracking_urls {
          type = TrackingUrls
          description = ""
          optional = false
        }
        ad_account_id {
          type =  string
          description = "The ID of the advertiser that this targeting template belongs to."
          optional = false
        }
        created_time {
          type =  integer
          description = "Targeting template created time. Unix timestamp in seconds."
          optional = false
        }
        id {
          type =  string
          description = "Targeting template ID."
          optional = false
        }
        sizing {
          type = TargetingTemplateAudienceSizing
          description = ""
          optional = false
        }
        status {
          type =  string
          description = "Indicate targeting template is active or Deleted"
          enum = ["ACTIVE", "DELETED"]
          optional = false
        }
        updated_time {
          type =  integer
          description = "Targeting template updated time.Unix timestamp in seconds."
          optional = false
        }
    }
  }
}

serviceTemplates {

  TargetingTemplateResponseData {
    title = TargetingTemplateResponseData
    description = TargetingTemplateResponseData
    implements = openapi_server.resourceTypes.TargetingTemplateResponseData

  }
}
