"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ConditionFilter"
package     = openapi_server
version     = "1.0"
description = "Defines a ConditionFilter"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsProductGroupMultipleStringCriteria = openapi_server.resourceTypes.CatalogsProductGroupMultipleStringCriteria
}
resourceTypes {

  ConditionFilter {
    title = ConditionFilter
    description = ConditionFilter
    derivedFrom = Root
    properties {
        condition {
          type = CatalogsProductGroupMultipleStringCriteria
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  ConditionFilter {
    title = ConditionFilter
    description = ConditionFilter
    implements = openapi_server.resourceTypes.ConditionFilter

  }
}
