"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LocalInventoryUpdateOperation"
package     = openapi_server
version     = "1.0"
description = "Defines a LocalInventoryUpdateOperation"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  RetailLocalInventoryItemAttributesOptional = openapi_server.resourceTypes.RetailLocalInventoryItemAttributesOptional
}
resourceTypes {

  LocalInventoryUpdateOperation {
    title = LocalInventoryUpdateOperation
    description = LocalInventoryUpdateOperation
    derivedFrom = Root
    properties {
        attributes {
          type = RetailLocalInventoryItemAttributesOptional
          description = ""
          optional = true
        }
        item_id {
          type =  string
          description = "Catalog item id in the merchant namespace"
          optional = true
        }
        operation {
          type =  string
          description = ""
          enum = ["UPDATE"]
          optional = true
        }
        store_code {
          type =  string
          description = "Store code for the local inventory item"
          optional = true
        }
    }
  }
}

serviceTemplates {

  LocalInventoryUpdateOperation {
    title = LocalInventoryUpdateOperation
    description = LocalInventoryUpdateOperation
    implements = openapi_server.resourceTypes.LocalInventoryUpdateOperation

  }
}
