"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsCreateRequest"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsCreateRequest"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsType = openapi_server.resourceTypes.CatalogsType
}
resourceTypes {

  CatalogsCreateRequest {
    title = CatalogsCreateRequest
    description = CatalogsCreateRequest
    derivedFrom = Root
    properties {
        catalog_type {
          type = CatalogsType
          description = ""
          optional = true
        }
        name {
          type =  string
          description = "A human-friendly name associated to a given catalog."
          optional = true
        }
    }
  }
}

serviceTemplates {

  CatalogsCreateRequest {
    title = CatalogsCreateRequest
