"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CampaignsAnalyticsMetrics"
package     = openapi_server
version     = "1.0"
description = "Defines a CampaignsAnalyticsMetrics"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CampaignsAnalyticsMetrics {
    title = CampaignsAnalyticsMetrics
    description = CampaignsAnalyticsMetrics
    derivedFrom = Root
    properties {
        campaign_id {
          type =  string
          description = "The ID of the campaing that this metrics belongs to. Returned as long as aggregate_report_rows is not true."
          optional = false
        }
        _date {
          type =  string
          description = "Current metrics date. Only returned when granularity is a time-based value (&#x60;DAY&#x60;, &#x60;HOUR&#x60;, &#x60;WEEK&#x60;, &#x60;MONTH&#x60;)"
          optional = false
        }
    }
  }
}

serviceTemplates {

  CampaignsAnalyticsMetrics {
    title = CampaignsAnalyticsMetrics
    description = CampaignsAnalyticsMetrics
    implements = openapi_server.resourceTypes.CampaignsAnalyticsMetrics

  }
}
