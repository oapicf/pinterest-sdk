"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsHotelReportParametersReport"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsHotelReportParametersReport"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsReportDistributionIssueFilter = openapi_server.resourceTypes.CatalogsReportDistributionIssueFilter
  CatalogsReportFeedIngestionFilter = openapi_server.resourceTypes.CatalogsReportFeedIngestionFilter
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CatalogsHotelReportParametersReport {
    title = CatalogsHotelReportParametersReport
    description = CatalogsHotelReportParametersReport
    derivedFrom = Root
    properties {
        feed_id {
          type =  string
          description = "ID of the feed entity."
          optional = true
        }
        processing_result_id {
          type =  string
          description = "Unique identifier of a feed processing result. It can be acquired from the \&quot;id\&quot; field of the \&quot;items\&quot; array within the response of the [List processing results for a given feed](/docs/api/v5/#operation/feed_processing_results/list). If not provided, default to most recent completed processing result."
          optional = false
        }
        report_type {
          type =  string
          description = ""
          enum = ["DISTRIBUTION_ISSUES"]
          optional = true
        }
        catalog_id {
          type =  string
          description = "Unique identifier of a catalog. If not given, oldest catalog will be used"
          optional = false
        }
    }
  }
}

serviceTemplates {

  CatalogsHotelReportParametersReport {
    title = CatalogsHotelReportParametersReport
    description = CatalogsHotelReportParametersReport
    implements = openapi_server.resourceTypes.CatalogsHotelReportParametersReport

  }
}
