"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LinkFilter"
package     = openapi_server
version     = "1.0"
description = "Defines a LinkFilter"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsProductGroupFilterOperatorTypeCriteria = openapi_server.resourceTypes.CatalogsProductGroupFilterOperatorTypeCriteria
}
resourceTypes {

  LinkFilter {
    title = LinkFilter
    description = LinkFilter
    derivedFrom = Root
    properties {
        link {
          type = CatalogsProductGroupFilterOperatorTypeCriteria
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  LinkFilter {
    title = LinkFilter
    description = LinkFilter
    implements = openapi_server.resourceTypes.LinkFilter

  }
}
