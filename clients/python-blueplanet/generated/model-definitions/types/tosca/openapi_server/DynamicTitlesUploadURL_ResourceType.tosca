"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server DynamicTitlesUploadURL"
package     = openapi_server
version     = "1.0"
description = "Defines a DynamicTitlesUploadURL"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  DynamicTitlesUploadURL {
    title = DynamicTitlesUploadURL
    description = DynamicTitlesUploadURL
    derivedFrom = Root
    properties {
        existing_filename {
          type =  string
          description = "If present, a reviewed CSV was previously submitted for this ad group. Uploading a new file will replace it. Absent when no prior submission exists."
          optional = false
        }
        request_id {
          type =  string
          description = "Unique identifier for this upload session. Must be passed to the process endpoint."
          optional = true
        }
        upload_url {
          type =  string
          description = "Pre-signed S3 PUT URL to upload the reviewed CSV file."
          optional = true
        }
    }
  }
}

serviceTemplates {

  DynamicTitlesUploadURL {
    title = DynamicTitlesUploadURL
    description = DynamicTitlesUploadURL
    implements = openapi_server.resourceTypes.DynamicTitlesUploadURL

  }
}
