"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LeadFormUpdateRequest"
package     = openapi_server
version     = "1.0"
description = "Defines a LeadFormUpdateRequest"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  LeadFormCommonPolicyLinksInner = openapi_server.resourceTypes.LeadFormCommonPolicyLinksInner
  LeadFormQuestion = openapi_server.resourceTypes.LeadFormQuestion
  LeadFormStatus = openapi_server.resourceTypes.LeadFormStatus
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  LeadFormUpdateRequest {
    title = LeadFormUpdateRequest
    description = LeadFormUpdateRequest
    derivedFrom = Root
    properties {
        completion_message {
          type =  string
          description = "A message for people who complete the form to let them know what happens next."
          optional = false
        }
        disclosure_language {
          type =  string
          description = "Additional disclosure language to be included in the lead form."
          optional = false
        }
        has_accepted_terms {
          type =  boolean
          description = "Whether the advertiser has accepted Pinterest&#39;s terms of service for creating a lead ad.  By sending us TRUE for this parameter, you agree that (i) you will use any personal information received in compliance with the privacy policy you share with Pinterest, and (ii) you will comply with Pinterest&#39;s &lt;a href&#x3D;\&quot;https://policy.pinterest.com/en/lead-ad-terms\&quot;&gt;Lead Ad Terms&lt;/a&gt;. As a reminder, all advertising on Pinterest is subject to the &lt;a href&#x3D;\&quot;https://business.pinterest.com/en/pinterest-advertising-services-agreement/\&quot;&gt;Pinterest Advertising Services Agreement&lt;/a&gt; or an equivalent agreement as set forth on an IO"
          optional = false
        }
        name {
          type =  string
          description = "Internal name of the lead form."
          optional = false
        }
        policy_links {
          type = array
          items.type = LeadFormCommonPolicyLinksInner
          description = "List of additional policy links to be displayed on the lead form."
          optional = false
        }
        privacy_policy_link {
          type =  string
          description = "A link to the advertiser&#39;s privacy policy. This will be included in the lead form&#39;s disclosure language."
          optional = false
        }
        questions {
          type = array
          items.type = LeadFormQuestion
          description = "List of questions to be displayed on the lead form."
          optional = false
        }
        status {
          type = LeadFormStatus
          description = ""
          optional = false
        }
        id {
          type =  string
          description = "The ID of this lead form to be updated"
          optional = true
        }
    }
  }
}

serviceTemplates {

  LeadFormUpdateRequest {
    title = LeadFormUpdateRequest
    description = LeadFormUpdateRequest
    implements = openapi_server.resourceTypes.LeadFormUpdateRequest

  }
}
