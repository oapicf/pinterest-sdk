"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ProductTagsBulkDeleteRequest"
package     = openapi_server
version     = "1.0"
description = "Defines a ProductTagsBulkDeleteRequest"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  ProductTagItem = openapi_server.resourceTypes.ProductTagItem
}
resourceTypes {

  ProductTagsBulkDeleteRequest {
    title = ProductTagsBulkDeleteRequest
    description = ProductTagsBulkDeleteRequest
    derivedFrom = Root
    properties {
        product_tags {
          type = array
          items.type = ProductTagItem
          description = "List of product tags to delete."
          optional = true
        }
    }
  }
}

serviceTemplates {

  ProductTagsBulkDeleteRequest {
    title = ProductTagsBulkDeleteRequest
    description = ProductTagsBulkDeleteRequest
    implements = openapi_server.resourceTypes.ProductTagsBulkDeleteRequest

  }
}
