"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CurrencyFilter"
package     = openapi_server
version     = "1.0"
description = "Defines a CurrencyFilter"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsProductGroupCurrencyCriteria = openapi_server.resourceTypes.CatalogsProductGroupCurrencyCriteria
}
resourceTypes {

  CurrencyFilter {
    title = CurrencyFilter
    description = CurrencyFilter
    derivedFrom = Root
    properties {
        currency {
          type = CatalogsProductGroupCurrencyCriteria
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  CurrencyFilter {
    title = CurrencyFilter
    description = CurrencyFilter
    implements = openapi_server.resourceTypes.CurrencyFilter

  }
}
