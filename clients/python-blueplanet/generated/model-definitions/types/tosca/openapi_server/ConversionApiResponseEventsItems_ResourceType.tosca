package     = openapi_server
version     = "1.0"
description = "Defines a ConversionApiResponseEventsItems"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  EventProcessingStatus = openapi_server.resourceTypes.EventProcessingStatus
}
resourceTypes {

  ConversionApiResponseEventsItems {
    title = ConversionApiResponseEventsItems
    description = ConversionApiResponseEventsItems
    derivedFrom = Root
    properties {
        error_message {
          type =  string
          description = "Error message containing more information about why the event failed to be processed."
          optional = false
        }
        status {
          type = EventProcessingStatus
          description = "Whether the event was processed successfully."
          optional = true
        }
        warning_message {
          type =  string
          description = "Warning messages about any fields in the event which are not standard. These are not critical to event processing."
          optional = false
        }
    }
  }
}

serviceTemplates {

  ConversionApiResponseEventsItems {
    title = ConversionApiResponseEventsItems
