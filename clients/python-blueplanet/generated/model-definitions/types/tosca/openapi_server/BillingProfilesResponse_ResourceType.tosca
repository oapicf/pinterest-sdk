"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server BillingProfilesResponse"
package     = openapi_server
version     = "1.0"
description = "Defines a BillingProfilesResponse"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  BillingProfileCardType = openapi_server.resourceTypes.BillingProfileCardType
  BillingProfilePaymentMethodBrand = openapi_server.resourceTypes.BillingProfilePaymentMethodBrand
  BillingProfileStatus = openapi_server.resourceTypes.BillingProfileStatus
  BillingType = openapi_server.resourceTypes.BillingType
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  BillingProfilesResponse {
    title = BillingProfilesResponse
    description = BillingProfilesResponse
    derivedFrom = Root
    properties {
        advertiser_id {
          type =  string
          description = "Advertiser ID of the billing."
          optional = false
        }
        billing_type {
          type = BillingType
          description = "Billing type of the advertiser"
          optional = false
        }
        card_type {
          type = BillingProfileCardType
          description = "Type of the card."
          optional = false
        }
        id {
          type =  string
          description = "Billing ID."
          optional = false
        }
        payment_method_brand {
          type = BillingProfilePaymentMethodBrand
          description = "Brand of the payment method."
          optional = false
        }
        status {
          type = BillingProfileStatus
          description = "Status of the billing."
          optional = false
        }
    }
  }
}

serviceTemplates {

  BillingProfilesResponse {
    title = BillingProfilesResponse
    description = BillingProfilesResponse
    implements = openapi_server.resourceTypes.BillingProfilesResponse

  }
}
