"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LabelUpdateItem"
package     = openapi_server
version     = "1.0"
description = "Defines a LabelUpdateItem"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  LabelStatus = openapi_server.resourceTypes.LabelStatus
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  LabelUpdateItem {
    title = LabelUpdateItem
    description = LabelUpdateItem
    derivedFrom = Root
    properties {
        id {
          type =  string
          description = "Label ID."
          optional = true
        }
        status {
          type = LabelStatus
          description = ""
          optional = false
        }
        value {
          type =  string
          description = "Label name. 100-character limit."
          optional = false
        }
    }
  }
}

serviceTemplates {

  LabelUpdateItem {
    title = LabelUpdateItem
    description = LabelUpdateItem
    implements = openapi_server.resourceTypes.LabelUpdateItem

  }
}
