"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ItemBatchRecord"
package     = openapi_server
version     = "1.0"
description = "Defines a ItemBatchRecord"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  ItemAttributesRequest = openapi_server.resourceTypes.ItemAttributesRequest
  ItemCreateBatchRecord = openapi_server.resourceTypes.ItemCreateBatchRecord
  ItemDeleteBatchRecord = openapi_server.resourceTypes.ItemDeleteBatchRecord
  ItemDeleteDiscontinuedBatchRecord = openapi_server.resourceTypes.ItemDeleteDiscontinuedBatchRecord
  ItemUpdateBatchRecord = openapi_server.resourceTypes.ItemUpdateBatchRecord
  ItemUpsertBatchRecord = openapi_server.resourceTypes.ItemUpsertBatchRecord
  UpdateMaskFieldType = openapi_server.resourceTypes.UpdateMaskFieldType
}
resourceTypes {

  ItemBatchRecord {
    title = ItemBatchRecord
    description = ItemBatchRecord
    derivedFrom = Root
    properties {
        attributes {
          type = ItemAttributesRequest
          description = ""
          optional = false
        }
        item_id {
          type =  string
          description = "The catalog item id in the merchant namespace"
          optional = false
        }
        update_mask {
          type = array
          items.type = UpdateMaskFieldType
          description = "The list of product attributes to be updated. Attributes specified in the update mask without a value specified in the body will be deleted from the product item."
          optional = false
        }
    }
  }
}

serviceTemplates {

  ItemBatchRecord {
    title = ItemBatchRecord
    description = ItemBatchRecord
    implements = openapi_server.resourceTypes.ItemBatchRecord

  }
}
