        }
        creative_assets_id {
          type =  string
          description = "The catalog creative assets id in the merchant namespace"
          optional = true
        }
        operation {
          type =  string
          description = ""
          enum = ["UPSERT"]
          optional = true
        }
    }
  }
}

serviceTemplates {

  CatalogsUpsertCreativeAssetsItem {
    title = CatalogsUpsertCreativeAssetsItem
