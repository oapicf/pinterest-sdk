"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CustomerList"
package     = openapi_server
version     = "1.0"
description = "Defines a CustomerList"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CustomerListStatus = openapi_server.resourceTypes.CustomerListStatus
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CustomerList {
    title = CustomerList
    description = CustomerList
    derivedFrom = Root
    properties {
        ad_account_id {
          type =  string
          description = "Associated ad account ID."
          optional = false
        }
        created_time {
          type =  
          description = "Creation time. Unix timestamp in seconds."
          optional = false
        }
        exceptions {
          type =  
          description = "Customer list errors."
          optional = false
        }
        id {
          type =  string
          description = "Customer list ID."
          optional = true
        }
        is_nca {
          type =  boolean
          description = "Whether the list was uploaded for new customer acquisition (expanded matching). Immutable after creation."
          optional = false
        }
        name {
          type =  string
          description = "Customer list name."
          optional = true
        }
        num_batches {
          type =  
          description = "Total number of list updates. List creation counts as one batch. Each [Append](/docs/redoc/#operation/ads_v3_customer_list_add_handler_PUT) or [Remove API](/docs/redoc/#operation/ads_v3_customer_list_remove_handler_PUT) call counts as another. List creation via the **Ads Manager** UI could result in more than one batch since the UI breaks up large lists."
          optional = false
        }
        num_removed_user_records {
          type =  
          description = "Number of removed user records. In a [Remove API](/docs/redoc/#operation/ads_v3_customer_list_remove_handler_PUT) call, this counter increases even if the user is not found in the list."
          optional = false
        }
        num_uploaded_user_records {
          type =  
          description = "Number of uploaded user records. In an [Append API](/docs/redoc/#operation/ads_v3_customer_list_add_handler_PUT) call, this counter increases even if the uploaded user is already in the list."
          optional = false
        }
        status {
          type = CustomerListStatus
          description = "Customer list status. &#x60;TOO_SMALL&#x60; means the list has fewer than 100 Pinterest users."
          optional = false
        }
        type {
          type =  string
          description = "Always &#x60;customerlist&#x60;."
          optional = false
        }
        updated_time {
          type =  
          description = "Last update time. Unix timestamp in seconds."
          optional = false
        }
    }
  }
}

serviceTemplates {

  CustomerList {
    title = CustomerList
    description = CustomerList
    implements = openapi_server.resourceTypes.CustomerList

  }
}
