"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CampaignId"
package     = openapi_server
version     = "1.0"
description = "Defines a CampaignId"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CampaignId {
    title = CampaignId
    description = CampaignId
    derivedFrom = Root
    properties {
        id {
          type =  string
          description = "Campaign ID."
          optional = false
        }
    }
  }
}

serviceTemplates {

  CampaignId {
    title = CampaignId
    description = CampaignId
    implements = openapi_server.resourceTypes.CampaignId

  }
}
