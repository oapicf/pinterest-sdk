"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AdvertiserDefinedEvent"
package     = openapi_server
version     = "1.0"
description = "Defines a AdvertiserDefinedEvent"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  AdvertiserDefinedEvent {
    title = AdvertiserDefinedEvent
    description = AdvertiserDefinedEvent
    derivedFrom = Root
    properties {
        name {
          type =  string
          description = "raw string name of the event, usually logged as raw_event_name in our dataset"
          optional = false
        }
        mapped_conversion_type {
          type =  string
          description = "standard type mapped to ADE for optimization"
          enum = ["PAGE_LOAD", "UNKNOWN", "INITIALIZED", "PAGE_VISIT", "SIGNUP", "CHECKOUT", "CUSTOM", "VIEW_CATEGORY", "SEARCH", "ADD_TO_CART", "WATCH_VIDEO", "LEAD", "APP_INSTALL", "WEB_SESSION", "EXTERNAL_MEASUREMENT", "ADD_PAYMENT_INFO", "ADD_TO_WISHLIST", "INITIATE_CHECKOUT", "SUBSCRIBE", "VIEW_CONTENT", "ADVERTISER_DEFINED_EVENT", "APP_OPEN", "CONTACT", "SCHEDULE", "FIND_LOCATION", "CUSTOMIZE_PRODUCT", "SUBMIT_APPLICATION", "START_TRIAL", ""]
          optional = false
        }
    }
  }
}

serviceTemplates {

  AdvertiserDefinedEvent {
    title = AdvertiserDefinedEvent
    description = AdvertiserDefinedEvent
    implements = openapi_server.resourceTypes.AdvertiserDefinedEvent

  }
}
