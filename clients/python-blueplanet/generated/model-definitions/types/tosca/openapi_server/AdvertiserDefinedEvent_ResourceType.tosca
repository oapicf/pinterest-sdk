"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AdvertiserDefinedEvent"
package     = openapi_server
version     = "1.0"
description = "Defines a AdvertiserDefinedEvent"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  ConversionTagTypeOptimal = openapi_server.resourceTypes.ConversionTagTypeOptimal
}
resourceTypes {

  AdvertiserDefinedEvent {
    title = AdvertiserDefinedEvent
    description = AdvertiserDefinedEvent
    derivedFrom = Root
    properties {
        mapped_conversion_type {
          type = ConversionTagTypeOptimal
          description = "Standard type mapped to ADE for optimization"
          optional = false
        }
        name {
          type =  string
          description = "Raw string name of the event, usually logged as raw_event_name in our dataset"
          optional = false
        }
    }
  }
}

serviceTemplates {

  AdvertiserDefinedEvent {
    title = AdvertiserDefinedEvent
    description = AdvertiserDefinedEvent
    implements = openapi_server.resourceTypes.AdvertiserDefinedEvent

  }
}
