"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server HotelIdFilter"
package     = openapi_server
version     = "1.0"
description = "Defines a HotelIdFilter"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsProductGroupMultipleStringCriteria = openapi_server.resourceTypes.CatalogsProductGroupMultipleStringCriteria
}
resourceTypes {

  HotelIdFilter {
    title = HotelIdFilter
    description = HotelIdFilter
    derivedFrom = Root
    properties {
        hotel_id {
          type = CatalogsProductGroupMultipleStringCriteria
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  HotelIdFilter {
    title = HotelIdFilter
    description = HotelIdFilter
    implements = openapi_server.resourceTypes.HotelIdFilter

  }
}
