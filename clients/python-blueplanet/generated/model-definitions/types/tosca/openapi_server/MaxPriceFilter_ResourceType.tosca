"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server MaxPriceFilter"
package     = openapi_server
version     = "1.0"
description = "Defines a MaxPriceFilter"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsProductGroupPricingCriteria = openapi_server.resourceTypes.CatalogsProductGroupPricingCriteria
}
resourceTypes {

  MaxPriceFilter {
    title = MaxPriceFilter
    description = MaxPriceFilter
    derivedFrom = Root
    properties {
        max_price {
          type = CatalogsProductGroupPricingCriteria
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  MaxPriceFilter {
    title = MaxPriceFilter
    description = MaxPriceFilter
    implements = openapi_server.resourceTypes.MaxPriceFilter

  }
}
