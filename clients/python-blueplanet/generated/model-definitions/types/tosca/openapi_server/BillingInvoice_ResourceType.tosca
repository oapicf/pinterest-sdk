"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server BillingInvoice"
package     = openapi_server
version     = "1.0"
description = "Defines a BillingInvoice"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  BillingInvoiceDocumentType = openapi_server.resourceTypes.BillingInvoiceDocumentType
  BillingInvoiceStatus = openapi_server.resourceTypes.BillingInvoiceStatus
  Currency = openapi_server.resourceTypes.Currency
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  BillingInvoice {
    title = BillingInvoice
    description = BillingInvoice
    derivedFrom = Root
    properties {
        ad_account_id {
          type =  string
          description = "The ID of the ad account this invoice belongs to"
          optional = false
        }
        ad_account_name {
          type =  string
          description = "The name of the ad account this invoice belongs to"
          optional = false
        }
        amount_billed_micro_currency {
          type =  integer
          description = "The amount billed in this invoice. Denoted in micro currency"
          optional = false
        }
        amount_discount_micro_currency {
          type =  integer
          description = "The discount in this invoice. Denoted in micro currency"
          optional = false
        }
        amount_net_micro_currency {
          type =  integer
          description = "The net amount in this invoice. Denoted in micro currency"
          optional = false
        }
        amount_tax_micro_currency {
          type =  integer
          description = "The tax in this invoice. Denoted in micro currency"
          optional = false
        }
        bill_to_country {
          type =  string
          description = "The country of the bill to address"
          optional = false
        }
        billing_period_end_date {
          type =  string
          description = "The end date of the billing period. Format: YYYY-MM-DD"
          optional = false
        }
        billing_period_start_date {
          type =  string
          description = "The start date of the billing period. Format: YYYY-MM-DD"
          optional = false
        }
        currency {
          type = Currency
          description = ""
          optional = false
        }
        document_type {
          type = BillingInvoiceDocumentType
          description = "The type of the document"
          optional = false
        }
        id {
          type =  string
          description = "Unique identifier for the billing invoice"
          optional = false
        }
        invoice_due_date {
          type =  string
          description = "The date the invoice is due. Format: YYYY-MM-DD"
          optional = false
        }
        payment_terms {
          type =  string
          description = "The payment terms of the invoice"
          optional = false
        }
        status {
          type = BillingInvoiceStatus
          description = "The status of the invoice"
          optional = false
        }
    }
  }
}

serviceTemplates {

  BillingInvoice {
    title = BillingInvoice
    description = BillingInvoice
    implements = openapi_server.resourceTypes.BillingInvoice

  }
}
