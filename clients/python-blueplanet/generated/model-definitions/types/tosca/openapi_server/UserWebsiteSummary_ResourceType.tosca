"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server UserWebsiteSummary"
package     = openapi_server
version     = "1.0"
description = "Defines a UserWebsiteSummary"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  UserWebsiteSummary {
    title = UserWebsiteSummary
    description = UserWebsiteSummary
    derivedFrom = Root
    properties {
        status {
          type =  string
          description = "Status of the verification process"
          optional = false
        }
        verified_at {
          type =  string
          description = "UTC timestamp when the verification happened - sometimes missing"
          optional = false
        }
        website {
          type =  string
          description = "Website with path or domain only"
          optional = false
        }
    }
  }
}

serviceTemplates {

  UserWebsiteSummary {
    title = UserWebsiteSummary
    description = UserWebsiteSummary
    implements = openapi_server.resourceTypes.UserWebsiteSummary

  }
}
