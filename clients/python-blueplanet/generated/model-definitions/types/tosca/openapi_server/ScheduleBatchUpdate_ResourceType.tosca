"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ScheduleBatchUpdate"
package     = openapi_server
version     = "1.0"
description = "Defines a ScheduleBatchUpdate"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  AdAccountEntityType = openapi_server.resourceTypes.AdAccountEntityType
  ScheduleAction = openapi_server.resourceTypes.ScheduleAction
  ScheduleDeltaValue = openapi_server.resourceTypes.ScheduleDeltaValue
  ScheduleStatus = openapi_server.resourceTypes.ScheduleStatus
  ScheduleType = openapi_server.resourceTypes.ScheduleType
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  ScheduleBatchUpdate {
    title = ScheduleBatchUpdate
    description = ScheduleBatchUpdate
    derivedFrom = Root
    properties {
        delta_value {
          type = ScheduleDeltaValue
          description = ""
          optional = false
        }
        end_timestamp {
          type =  integer
          description = "Schedule end time. Unix timestamp in seconds."
          optional = false
        }
        entity_id {
          type =  string
          description = "entity ID."
          optional = false
        }
        entity_type {
          type = AdAccountEntityType
          description = "Specify the entity_type to get summary information"
          optional = false
        }
        id {
          type =  string
          description = ""
          optional = true
        }
        name {
          type =  string
          description = "Schedule name."
          optional = false
        }
        schedule_action {
          type = ScheduleAction
          description = "The schedule action."
          optional = false
        }
        schedule_id {
          type =  string
          description = "Schedule ID."
          optional = true
        }
        schedule_status {
          type = ScheduleStatus
          description = "Schedule status."
          optional = false
        }
        schedule_type {
          type = ScheduleType
          description = "The schedule type."
          optional = false
        }
        start_timestamp {
          type =  integer
          description = "Schedule start time. Unix timestamp in seconds."
          optional = false
        }
    }
  }
}

serviceTemplates {

  ScheduleBatchUpdate {
