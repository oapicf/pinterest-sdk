"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server BookClosedResponse"
package     = openapi_server
version     = "1.0"
description = "Defines a BookClosedResponse"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  BookClosedResponse {
    title = BookClosedResponse
    description = BookClosedResponse
    derivedFrom = Root
    properties {
        conversion_metrics_ready {
          type =  boolean
          description = "Are conversion metrics ready?"
          optional = false
        }
        non_conversion_metrics_ready {
          type =  boolean
          description = "Are non-conversion metrics ready?"
          optional = false
        }
    }
  }
}

serviceTemplates {

  BookClosedResponse {
    title = BookClosedResponse
    description = BookClosedResponse
    implements = openapi_server.resourceTypes.BookClosedResponse

  }
}
