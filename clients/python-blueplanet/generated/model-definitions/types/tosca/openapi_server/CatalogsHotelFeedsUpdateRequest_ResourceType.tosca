"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsHotelFeedsUpdateRequest"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsHotelFeedsUpdateRequest"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsFeedCredentials = openapi_server.resourceTypes.CatalogsFeedCredentials
  CatalogsFeedProcessingSchedule = openapi_server.resourceTypes.CatalogsFeedProcessingSchedule
  CatalogsFormat = openapi_server.resourceTypes.CatalogsFormat
  CatalogsStatus = openapi_server.resourceTypes.CatalogsStatus
  NullableCurrency = openapi_server.resourceTypes.NullableCurrency
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CatalogsHotelFeedsUpdateRequest {
    title = CatalogsHotelFeedsUpdateRequest
    description = CatalogsHotelFeedsUpdateRequest
    derivedFrom = Root
    properties {
        catalog_type {
          type =  string
          description = ""
          enum = ["HOTEL"]
          optional = true
        }
        credentials {
          type = CatalogsFeedCredentials
          description = ""
          optional = false
        }
        default_currency {
          type = NullableCurrency
          description = ""
          optional = false
        }
        format {
          type = CatalogsFormat
          description = ""
          optional = false
        }
        location {
          type =  string
          description = "The URL where a feed is available for download. This URL is what Pinterest will use to download a feed for processing."
          optional = false
        }
        name {
          type =  string
          description = "A human-friendly name associated to a given feed."
          optional = false
        }
        preferred_processing_schedule {
          type = CatalogsFeedProcessingSchedule
          description = ""
          optional = false
        }
        status {
          type = CatalogsStatus
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  CatalogsHotelFeedsUpdateRequest {
    title = CatalogsHotelFeedsUpdateRequest
    description = CatalogsHotelFeedsUpdateRequest
    implements = openapi_server.resourceTypes.CatalogsHotelFeedsUpdateRequest

  }
}
