"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server HttpMethod"
package     = openapi_server
version     = "1.0"
description = "Defines a HttpMethod"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  HttpMethod {
    title = HttpMethod
    description = HttpMethod
    derivedFrom = Root
    properties {
    }
  }
}

serviceTemplates {

  HttpMethod {
    title = HttpMethod
    description = HttpMethod
    implements = openapi_server.resourceTypes.HttpMethod

  }
}
