"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsHotelFeedsCreateRequest"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsHotelFeedsCreateRequest"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsCreativeAssetsFeedsCreateRequestDefaultLocale = openapi_server.resourceTypes.CatalogsCreativeAssetsFeedsCreateRequestDefaultLocale
  CatalogsFeedCredentials = openapi_server.resourceTypes.CatalogsFeedCredentials
  CatalogsFeedProcessingSchedule = openapi_server.resourceTypes.CatalogsFeedProcessingSchedule
  CatalogsFormat = openapi_server.resourceTypes.CatalogsFormat
  CatalogsStatus = openapi_server.resourceTypes.CatalogsStatus
  NullableCurrency = openapi_server.resourceTypes.NullableCurrency
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CatalogsHotelFeedsCreateRequest {
    title = CatalogsHotelFeedsCreateRequest
    description = CatalogsHotelFeedsCreateRequest
    derivedFrom = Root
    properties {
        catalog_id {
          type =  string
          description = "Catalog id pertaining to the feed. If not provided, feed will use a default catalog based on type."
          optional = false
        }
        catalog_type {
          type =  string
          description = ""
          enum = ["HOTEL"]
          optional = true
        }
        credentials {
          type = CatalogsFeedCredentials
          description = ""
          optional = false
        }
        default_currency {
          type = NullableCurrency
          description = ""
          optional = false
        }
        default_locale {
          type = CatalogsCreativeAssetsFeedsCreateRequestDefaultLocale
          description = ""
          optional = true
        }
        format {
          type = CatalogsFormat
          description = ""
          optional = true
        }
        location {
          type =  string
          description = "The URL where a feed is available for download. This URL is what Pinterest will use to download a feed for processing."
          optional = true
        }
        name {
          type =  string
          description = "A human-friendly name associated to a given feed."
          optional = true
        }
        preferred_processing_schedule {
          type = CatalogsFeedProcessingSchedule
          description = ""
          optional = false
        }
        status {
          type = CatalogsStatus
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  CatalogsHotelFeedsCreateRequest {
    title = CatalogsHotelFeedsCreateRequest
    description = CatalogsHotelFeedsCreateRequest
    implements = openapi_server.resourceTypes.CatalogsHotelFeedsCreateRequest

