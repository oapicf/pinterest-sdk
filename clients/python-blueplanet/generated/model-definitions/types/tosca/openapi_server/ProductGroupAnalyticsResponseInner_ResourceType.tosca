"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ProductGroupAnalyticsResponseInner"
package     = openapi_server
version     = "1.0"
description = "Defines a ProductGroupAnalyticsResponseInner"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  ProductGroupAnalyticsResponseInner {
    title = ProductGroupAnalyticsResponseInner
    description = ProductGroupAnalyticsResponseInner
    derivedFrom = Root
    properties {
        _date {
          type =  string
          description = "Current metrics date. Only returned when granularity is a time-based value (&#x60;DAY&#x60;, &#x60;HOUR&#x60;, &#x60;WEEK&#x60;, &#x60;MONTH&#x60;)"
          optional = false
        }
        product_group_id {
          type =  string
          description = "The ID of the product group that this metrics belongs to."
          optional = true
        }
    }
  }
}

serviceTemplates {

  ProductGroupAnalyticsResponseInner {
    title = ProductGroupAnalyticsResponseInner
    description = ProductGroupAnalyticsResponseInner
    implements = openapi_server.resourceTypes.ProductGroupAnalyticsResponseInner

  }
}
