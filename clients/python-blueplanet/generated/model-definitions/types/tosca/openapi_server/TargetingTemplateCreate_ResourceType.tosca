"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server TargetingTemplateCreate"
package     = openapi_server
version     = "1.0"
description = "Defines a TargetingTemplateCreate"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  PlacementGroupType = openapi_server.resourceTypes.PlacementGroupType
  TargetingSpecOptimal = openapi_server.resourceTypes.TargetingSpecOptimal
  TargetingTemplateKeyword = openapi_server.resourceTypes.TargetingTemplateKeyword
  TrackingUrls = openapi_server.resourceTypes.TrackingUrls
}
resourceTypes {

  TargetingTemplateCreate {
    title = TargetingTemplateCreate
    description = TargetingTemplateCreate
    derivedFrom = Root
    properties {
        auto_targeting_enabled {
          type =  boolean
          description = "Enable auto-targeting for ad group. Also known as [\&quot;expanded targeting\&quot;](https://help.pinterest.com/en/business/article/expanded-targeting)."
          optional = false
        }
        keywords {
          type = array
          items.type = TargetingTemplateKeyword
          description = ""
          optional = false
        }
        name {
          type =  string
          description = "targeting template name"
          optional = true
        }
        placement_group {
          type = PlacementGroupType
          description = ""
          optional = false
        }
        targeting_attributes {
          type = TargetingSpecOptimal
          description = "targeting profile attributes"
          optional = true
        }
        tracking_urls {
          type = TrackingUrls
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  TargetingTemplateCreate {
    title = TargetingTemplateCreate
    description = TargetingTemplateCreate
    implements = openapi_server.resourceTypes.TargetingTemplateCreate

  }
}
