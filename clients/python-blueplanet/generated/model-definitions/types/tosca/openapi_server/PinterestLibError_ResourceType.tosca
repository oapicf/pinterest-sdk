version     = "1.0"
description = "Defines a PinterestLibError"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  PinterestLibError {
    title = PinterestLibError
    description = PinterestLibError
