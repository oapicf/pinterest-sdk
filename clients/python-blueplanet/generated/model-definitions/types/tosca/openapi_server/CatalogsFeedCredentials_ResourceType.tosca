"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsFeedCredentials"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsFeedCredentials"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  CatalogsFeedCredentials {
    title = CatalogsFeedCredentials
    description = CatalogsFeedCredentials
    derivedFrom = Root
    properties {
        password {
          type =  string
          description = "The required password for downloading a feed."
          optional = true
        }
        username {
          type =  string
          description = "The required username for downloading a feed."
          optional = true
        }
    }
  }
}

serviceTemplates {

  CatalogsFeedCredentials {
    title = CatalogsFeedCredentials
    description = CatalogsFeedCredentials
    implements = openapi_server.resourceTypes.CatalogsFeedCredentials

  }
}
