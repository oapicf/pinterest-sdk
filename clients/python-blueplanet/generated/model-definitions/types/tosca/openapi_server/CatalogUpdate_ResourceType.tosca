"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogUpdate"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogUpdate"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsType = openapi_server.resourceTypes.CatalogsType
}
resourceTypes {

  CatalogUpdate {
    title = CatalogUpdate
    description = CatalogUpdate
    derivedFrom = Root
    properties {
        catalog_type {
          type = CatalogsType
          description = ""
          optional = false
        }
        name {
          type =  string
          description = "A human-friendly name associated to a catalog entity."
          optional = false
        }
    }
  }
}

serviceTemplates {

  CatalogUpdate {
    title = CatalogUpdate
    description = CatalogUpdate
    implements = openapi_server.resourceTypes.CatalogUpdate

  }
}
