"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsCreativeAssetsBatchRequest"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsCreativeAssetsBatchRequest"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsCreativeAssetsBatchItem = openapi_server.resourceTypes.CatalogsCreativeAssetsBatchItem
  Country = openapi_server.resourceTypes.Country
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CatalogsCreativeAssetsBatchRequest {
    title = CatalogsCreativeAssetsBatchRequest
    description = CatalogsCreativeAssetsBatchRequest
    derivedFrom = Root
    properties {
        catalog_id {
          type =  string
          description = "Catalog id pertaining to the creative assets item. If not provided, default to oldest creative assets catalog"
          optional = false
        }
        catalog_type {
          type =  string
          description = ""
          enum = ["CREATIVE_ASSETS"]
          optional = true
        }
        country {
          type = Country
          description = ""
          optional = true
        }
        items {
          type = array
          items.type = CatalogsCreativeAssetsBatchItem
          description = "Array with creative assets item operations"
          optional = true
        }
        language {
          type =  string
          description = "We recommend using the CatalogsLocale values."
          enum = ["af-ZA", "ar-SA", "bg-BG", "bn-IN", "cs-CZ", "da-DK", "de", "el-GR", "en-AU", "en-CA", "en-GB", "en-IN", "en-US", "es-419", "es-AR", "es-ES", "es-MX", "fi-FI", "fr", "fr-CA", "he-IL", "hi-IN", "hr-HR", "hu-HU", "id-ID", "it", "ja", "ko-KR", "ms-MY", "nb-NO", "nl", "pl-PL", "pt-BR", "pt-PT", "ro-RO", "ru-RU", "sk-SK", "sv-SE", "te-IN", "th-TH", "tl-PH", "tr", "uk-UA", "vi-VN", "zh-CN", "zh-TW", "AM", "AR", "AZ", "BG", "BN", "BS", "CA", "CS", "DA", "DV", "DZ", "DE", "EL", "EN", "ES", "ET", "FA", "FI", "FR", "HE", "HI", "HR", "HU", "HY", "ID", "IN", "IS", "IT", "IW", "JA", "KA", "KM", "KO", "LO", "LT", "LV", "MK", "MN", "MS", "MY", "NB", "NE", "NL", "false", "PL", "PT", "RO", "RU", "SK", "SL", "SQ", "SR", "SV", "TL", "UK", "VI", "TE", "TH", "TR", "XX", "ZH"]
          optional = true
        }
    }
  }
}

serviceTemplates {

  CatalogsCreativeAssetsBatchRequest {
    title = CatalogsCreativeAssetsBatchRequest
    description = CatalogsCreativeAssetsBatchRequest
    implements = openapi_server.resourceTypes.CatalogsCreativeAssetsBatchRequest

