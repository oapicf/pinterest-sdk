"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server CatalogsFeedProcessingSchedule"
package     = openapi_server
version     = "1.0"
description = "Defines a CatalogsFeedProcessingSchedule"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsFeedProcessingScheduleTimezone = openapi_server.resourceTypes.CatalogsFeedProcessingScheduleTimezone
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  CatalogsFeedProcessingSchedule {
    title = CatalogsFeedProcessingSchedule
    description = CatalogsFeedProcessingSchedule
    derivedFrom = Root
    properties {
        time {
          type =  string
          description = "A time in format HH:MM with leading 0 (zero)"
          optional = true
        }
        timezone {
          type = CatalogsFeedProcessingScheduleTimezone
          description = "The timezone considered for the processing schedule time."
          optional = true
        }
    }
  }
}

serviceTemplates {

  CatalogsFeedProcessingSchedule {
    title = CatalogsFeedProcessingSchedule
    description = CatalogsFeedProcessingSchedule
    implements = openapi_server.resourceTypes.CatalogsFeedProcessingSchedule

  }
}
