"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server Media"
package     = openapi_server
version     = "1.0"
description = "Defines a Media"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  MediaUploadStatus = openapi_server.resourceTypes.MediaUploadStatus
  MediaUploadType = openapi_server.resourceTypes.MediaUploadType
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  Media {
    title = Media
    description = Media
    derivedFrom = Root
    properties {
        media_id {
          type =  string
          description = "Unique identifier for this media upload. Used to track status and for attaching during Pin creation."
          optional = true
        }
        media_type {
          type = MediaUploadType
          description = ""
          optional = true
        }
        status {
          type = MediaUploadStatus
          description = ""
          optional = false
        }
    }
  }
}

serviceTemplates {

  Media {
    title = Media
    description = Media
    implements = openapi_server.resourceTypes.Media

  }
}
