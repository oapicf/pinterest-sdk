"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server UpdatePartnerAssetsResult"
package     = openapi_server
version     = "1.0"
description = "Defines a UpdatePartnerAssetsResult"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  UpdatePartnerAssetsResult {
    title = UpdatePartnerAssetsResult
    description = UpdatePartnerAssetsResult
    derivedFrom = Root
    properties {
        asset_id {
          type =  string
          description = "Unique identifier of a business asset."
          optional = false
        }
        asset_type {
          type =  string
          description = "Type of asset. Currently we only support AD_ACCOUNT, PROFILE, ASSET_GROUP and CATALOG."
          optional = false
        }
        partner_id {
          type =  string
          description = "Unique identifier of a business partner."
          optional = false
        }
        permissions {
          type = array
          items.type =  string
          description = "Permission levels member or partner has on an asset."
          optional = false
        }
    }
  }
}

serviceTemplates {

  UpdatePartnerAssetsResult {
    title = UpdatePartnerAssetsResult
    description = UpdatePartnerAssetsResult
    implements = openapi_server.resourceTypes.UpdatePartnerAssetsResult

  }
}
