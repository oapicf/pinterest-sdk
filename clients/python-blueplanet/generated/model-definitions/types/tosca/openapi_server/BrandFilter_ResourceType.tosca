"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server BrandFilter"
package     = openapi_server
version     = "1.0"
description = "Defines a BrandFilter"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CatalogsProductGroupMultipleStringCriteria = openapi_server.resourceTypes.CatalogsProductGroupMultipleStringCriteria
}
resourceTypes {

  BrandFilter {
    title = BrandFilter
    description = BrandFilter
    derivedFrom = Root
    properties {
        brand {
          type = CatalogsProductGroupMultipleStringCriteria
          description = ""
          optional = true
        }
    }
  }
}

serviceTemplates {

  BrandFilter {
    title = BrandFilter
    description = BrandFilter
    implements = openapi_server.resourceTypes.BrandFilter

  }
}
