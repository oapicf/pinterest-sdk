"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server SharedAudienceAccount"
package     = openapi_server
version     = "1.0"
description = "Defines a SharedAudienceAccount"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  AudienceAccountType = openapi_server.resourceTypes.AudienceAccountType
  import re = openapi_server.resourceTypes.import re
}
resourceTypes {

  SharedAudienceAccount {
    title = SharedAudienceAccount
    description = SharedAudienceAccount
    derivedFrom = Root
    properties {
        account_id {
          type =  string
          description = "Account ID (ad account or business ID)."
          optional = true
        }
        account_name {
          type =  string
          description = "Account name."
          optional = true
        }
        account_type {
          type = AudienceAccountType
          description = "account type"
          optional = true
        }
        shared_on_timestamp {
          type =  integer
          description = "Epoch timestamp in seconds for the shared audience event"
          optional = true
        }
    }
  }
}

serviceTemplates {

  SharedAudienceAccount {
    title = SharedAudienceAccount
    description = SharedAudienceAccount
    implements = openapi_server.resourceTypes.SharedAudienceAccount

  }
}
