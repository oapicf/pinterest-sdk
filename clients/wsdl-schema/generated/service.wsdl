      <xs:complexType name="ConversionMSOTEventsCreate">
        <xs:annotation>
          <xs:documentation>Resource create operation model.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="action_timestamps" type="xs:long">
            <xs:annotation>
              <xs:documentation>Timestamp(s) when the ad action(s) happened. Unix timestamp in seconds.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="ad_group_id" type="xs:string">
            <xs:annotation>
              <xs:documentation>The ID of the ad group that was attributed to the conversion event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="attribution_model" type="schemas:AttributionModel">
            <xs:annotation>
              <xs:documentation>The attribution model used to attribute the conversion event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="attribution_scope" type="schemas:AttributionScope">
            <xs:annotation>
              <xs:documentation>Ad event type.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="attribution_score">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Credit given to the attributed ad actions. Allowed values are &gt; 0 and &lt;&#x3D; 1.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:double">
                <xs:maxInclusive value="1" />
                <xs:minInclusive value="0" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="campaign_id" type="xs:string">
            <xs:annotation>
              <xs:documentation>The ID of the campaign that was attributed to the conversion event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="click_window" type="xs:string">
            <xs:annotation>
              <xs:documentation>Click window used for attribution (for example, &#x60;1d&#x60;, &#x60;7d&#x60;, &#x60;30d&#x60;, &#x60;lifetime&#x60;).</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="currency" type="schemas:Currency">
            <xs:annotation>
              <xs:documentation>Currency code for the &#x60;value&#x60; field, required if &#x60;value&#x60; is present. Currency Codes should be in ISO 4217 standard.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="event_id">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>A unique id string that identifies this event. If you are already sending us events through Conversions API, then this id should match the event_id sent through Conversions API.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:maxLength value="256" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="event_name" type="schemas:MsotEventName">
            <xs:annotation>
              <xs:documentation>Type of user event.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="event_timestamp" type="xs:long">
            <xs:annotation>
              <xs:documentation>The time when the event occurred. Unix timestamp in seconds.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="total_event_touchpoints">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Total number of ad events including other non-Pinterest ad platforms.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:integer">
                <xs:minInclusive value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="total_events">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Deprecated: use &#x60;total_events_fractional&#x60; instead to avoid rounding errors. Total number of conversion events that are reported in one API call.  If you are sending one API request for one attributed conversion event then this value should be 1. If you are sending multiple attributed conversion events in one API request then this value should be the total number of attributed conversion events in the request.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:integer">
                <xs:minInclusive value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="total_events_fractional">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>Total number of conversion events that are reported in one API call. Use this field instead of &#x60;total_events&#x60; to send precise fractional values.  If you are sending one API request for one attributed conversion event with full credit, this value should be 1.0. For partial attribution, send the exact fractional value (e.g., 0.5 for half credit).</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:double">
                <xs:minInclusive value="0" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="0" name="value" type="xs:double">
            <xs:annotation>
              <xs:documentation>Order value of the conversion event. Required if &#x60;event_name&#x60; is &#x60;add_to_cart&#x60; or &#x60;checkout&#x60;.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="view_window" type="xs:string">
            <xs:annotation>
              <xs:documentation>View window used for attribution (for example, &#x60;1d&#x60;, &#x60;7d&#x60;, &#x60;30d&#x60;).</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
