          <xs:element minOccurs="0" default="TIME_OF_AD_ACTION" name="conversionReportTime" type="schemas:Conversion_report_time">
            <xs:annotation>
              <xs:documentation>The date by which the conversion metrics returned from this endpoint will be reported. There are two dates associated with a conversion event: the date that the user interacted with the ad, and the date that the user completed a conversion event.</xs:documentation>
