          <stringProp name="HTTPSampler.path">/v5/catalogs/processing_results/${processing_result_id}/item_issues</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
