{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "ConversionTagConfigs",
  "fields": [
    {
      "name": "aem_db_enabled",
      "type": ["boolean", "null"],
      "doc": "Whether Automatic Enhanced Match birthdate is enabled. See [Enhanced match](https://help.pinterest.com/en/business/article/enhanced-match) for more information.",
      "default": false
    },
    {
      "name": "aem_enabled",
      "type": ["boolean", "null"],
      "doc": "Whether Automatic Enhanced Match email is enabled. See [Enhanced match](https://help.pinterest.com/en/business/article/enhanced-match) for more information.",
      "default": false
    },
    {
      "name": "aem_external_id_enabled",
      "type": ["boolean", "null"],
      "doc": "Whether Automatic Enhanced Match location is enabled. See [Enhanced match](https://help.pinterest.com/en/business/article/enhanced-match) for more information.",
      "default": false
    },
    {
      "name": "aem_fnln_enabled",
      "type": ["boolean", "null"],
      "doc": "Whether Automatic Enhanced Match name is enabled. See [Enhanced match](https://help.pinterest.com/en/business/article/enhanced-match) for more information.",
      "default": false
    },
    {
      "name": "aem_ge_enabled",
      "type": ["boolean", "null"],
      "doc": "Whether Automatic Enhanced Match gender is enabled. See [Enhanced match](https://help.pinterest.com/en/business/article/enhanced-match) for more information.",
      "default": false
    },
    {
      "name": "aem_loc_enabled",
      "type": ["boolean", "null"],
      "doc": "Whether Automatic Enhanced Match location is enabled. See [Enhanced match](https://help.pinterest.com/en/business/article/enhanced-match) for more information.",
      "default": false
    },
    {
      "name": "aem_ph_enabled",
      "type": ["boolean", "null"],
      "doc": "Whether Automatic Enhanced Match phone is enabled. See [Enhanced match](https://help.pinterest.com/en/business/article/enhanced-match) for more information.",
      "default": false
    },
    {
      "name": "md_frequency",
      "type": ["double", "null"],
      "doc": "Metadata ingestion frequency.",
      "default": 1
    },
    {
      "name": "no_code_capi_domains",
      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "List of advertiser subdomains configured for NoCodeCAPI calls.",
      "default": null
    }
  ]

