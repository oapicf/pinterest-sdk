{
  "namespace": "model",
  "type": "record",
  "doc": "Per-item entry inside `PinMedia.items` for mixed image/video pins. Discriminated by `item_type`.",
  "name": "PinMediaMetadata",
  "fields": [
    {
      "name": "description",
      "type": ["null", "string"],
      "doc": "",
      "default": null
    },
    {
      "name": "images",
      "type": ["null", "model.ImageSize"],
      "doc": "",
      "default": null
    },
    {
      "name": "item_type",
      "type": {
        "type": "enum",
        "name": "PinMediaMetadata_itemUnderscoretype",
        "symbols": [
          "video"
        ]
      },
      "doc": "Discriminator literal identifying this as video metadata inside a `PinMediaMetadata` payload."
    },
    {
      "name": "link",
      "type": ["null", "string"],
      "doc": "",
      "default": null
    },
    {
      "name": "title",
      "type": ["null", "string"],
      "doc": "",
      "default": null
    },
    {
      "name": "cover_image_url",
      "type": ["null", "string"],
      "doc": "",
      "default": null
    },
    {
      "name": "duration",
      "type": ["null", "double"],
      "doc": "Duration (in miliseconds). Field maybe null after creation due to video processing time.",
      "default": null
    },
    {
      "name": "height",
      "type": ["null", "int"],
      "doc": "Height (in pixels). Field maybe null after creation due to video processing time.",
      "default": null
    },
    {
      "name": "video_url",
      "type": ["null", "string"],
      "doc": "Video url (720p).  **Note:** This field is limited and not available to all apps.",
      "default": null
    },
    {
      "name": "video_url_hls",
      "type": ["null", "string"],
      "doc": "Video url (HLS).  **Note:** This field is limited and not available to all apps.",
      "default": null
    },
    {
      "name": "width",
      "type": ["null", "int"],
      "doc": "Width (in pixels). Field maybe null after creation due to video processing time.",
      "default": null
    }
  ]

}
