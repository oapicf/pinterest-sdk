{
  "namespace": "model",
  "type": "record",
  "doc": "Object containing information about the device where event occurred.",
  "name": "ConversionEventDeviceInfo",
  "fields": [
    {
      "name": "battery_level",
      "type": ["null", "int"],
      "doc": "Battery charge level percentage",
      "default": null
    },
    {
      "name": "brand",
      "type": ["null", "string"],
      "doc": "Device brand",
      "default": null
    },
    {
      "name": "carrier",
      "type": ["null", "string"],
      "doc": "User device's mobile carrier.",
      "default": null
    },
    {
      "name": "cpu_cores",
      "type": ["null", "int"],
      "doc": "Number of CPU cores",
      "default": null
    },
    {
      "name": "external_storage_free_space",
      "type": ["null", "int"],
      "doc": "External storage size in GB",
      "default": null
    },
    {
      "name": "external_storage_size",
      "type": ["null", "int"],
      "doc": "External storage size in GB",
      "default": null
    },
    {
      "name": "form_factor",
      "type": ["null", {
        "type": "enum",
        "name": "ConversionEventDeviceInfo_formUnderscorefactor",
        "symbols": [
          "desktop",
          "laptop",
          "cellphone",
          "tablet",
          "smartwatch",
          "tv",
          "vr",
          "console",
          "other"
        ]
      }],
      "doc": "Device form factor",
      "default": null
    },
    {
      "name": "kernel_version",
      "type": ["null", "string"],
      "doc": "Kernel version. Examples: Linux: 6.15. Obtain by running: uname -r MacOS: 24.3.0. Obtain by running: sysctl kern.version Android: 6.6. Obtain from OS.uname().release",
      "default": null
    },
    {
      "name": "languages",
      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "List of user installed languages. ISO 639-1 format",
      "default": null
    },
    {
      "name": "locale",
      "type": ["null", "string"],
      "doc": "Device locale BCP-47 format",
      "default": null
    },
    {
      "name": "model",
      "type": ["null", "string"],
      "doc": "Device model name",
      "default": null
    },
    {
      "name": "network_type",
      "type": ["null", {
        "type": "enum",
        "name": "ConversionEventDeviceInfo_networkUnderscoretype",
        "symbols": [
          "wifi",
          "cellular_2g",
          "cellular_3g",
          "cellular_4g",
          "cellular_5g",
          "cellular_6g",
          "ethernet",
          "unknown"
        ]
      }],
      "doc": "Network type: 4G, 5G, ethernet, wifi In Android: NetworkCapabilities.getNetworkCapabilities()",
      "default": null
    },
    {
      "name": "os_family",
      "type": ["null", {
        "type": "enum",
        "name": "ConversionEventDeviceInfo_osUnderscorefamily",
        "symbols": [
          "ios",
          "android",
          "macos",
          "windows",
          "linux",
          "bsd",
          "other"
        ]
      }],
      "doc": "OS Family",
      "default": null
    },
    {
      "name": "os_name",
      "type": ["null", "string"],
      "doc": "Short name of the OS. This value if specific to os family. Examples: Windows: 10, 11; Android: 16; iOS: 18; MacOS: 15; Linux: Debian, Ubuntu, Arch",
      "default": null
    },
    {
      "name": "os_release_name",
      "type": ["null", "string"],
      "doc": "Marketing name for the release version iOS: Dawn Android: Baklava MacOS: Sequoia Ubuntu Linux: Plucky Puffin",
      "default": null
    },
    {
      "name": "os_version",
      "type": ["null", "string"],
      "doc": "Full name of the version. Examples: iOS: 18.3 Android: 16.1 MacOS: 15.5 Windows: 24H2 Ubuntu Linux: 25.04",
      "default": null
    },
    {
      "name": "screen_density",
      "type": ["null", "int"],
      "doc": "Screen density, PPI",
      "default": null
    },
    {
      "name": "screen_height",
      "type": ["null", "int"],
      "doc": "Screen height in pixels",
      "default": null
    },
    {
      "name": "screen_width",
      "type": ["null", "int"],
      "doc": "Screen width in pixels",
      "default": null
    },
    {
      "name": "storage_free_space",
      "type": ["null", "int"],
      "doc": "Internal storage size in GB",
      "default": null
    },
    {
      "name": "storage_size",
      "type": ["null", "int"],
      "doc": "Internal storage size in GB",
      "default": null
