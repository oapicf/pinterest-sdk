{
  "namespace": "model",
  "type": "record",
  "doc": "Ad group configuration for delivery estimates.",
  "name": "AdGroupDeliveryEstimates",
  "fields": [
    {
      "name": "auto_targeting_enabled",
      "type": ["null", "boolean"],
      "doc": "",
      "default": null
    },
    {
      "name": "creative_types",
      "type": ["null", {
        "type": "array",
        "items": "model.AdGroupAudienceSizingCreativeTypes"
      }],
      "doc": "Pin creative types filter. **Note:** SHOP_THE_PIN has been deprecated. Please use COLLECTION instead.",
      "default": null
    },
    {
      "name": "keywords",
      "type": ["null", {
        "type": "array",
        "items": "model.AdGroupDeliveryEstimatesKeywordsItems"
      }],
      "doc": "Array of keyword objects. If the keywords field is missing, all keywords will be targeted.",
      "default": null
    },
    {
      "name": "monthly_frequency_cap",
      "type": ["null", "int"],
      "doc": "Set a limit to the number of times a promoted pin from this campaign can be impressed by a pinner within the past rolling 30 days. Only available for CPM (cost per mille (1000 impressions))  ad groups.",
      "default": null
    },
    {
      "name": "optimization_goal_metadata",
      "type": ["null", "model.OptimizationGoalMetadata"],
      "doc": "",
      "default": null
    },
    {
      "name": "optimization_type",
      "type": ["null", "model.OptimizationType"],
      "doc": "Optimization type for ad group delivery. Defaults to WEB_CONVERSION for WEB_CONVERSION/AWARENESS objectives, CLICKTHROUGH otherwise.",
      "default": null
    },
    {
      "name": "placement_group",
      "type": ["null", "model.PlacementGroupType"],
      "doc": "",
      "default": null
    },
    {
      "name": "product_group_ids",
      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "[Targeted product group IDs](/docs/redoc/#section/AdGroup-Audience-Sizing) **Note:** This can only be combined with shopping/catalog sales campaigns.",
      "default": null
    },
    {
      "name": "targeting_spec",
      "type": ["null", "model.TargetingSpecOptimal"],
      "doc": "",
      "default": null
    }
  ]

}
