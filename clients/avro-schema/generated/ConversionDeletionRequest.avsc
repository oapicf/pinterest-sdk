{
  "namespace": "model",
  "type": "record",
  "doc": "Conversion deletion request",
  "name": "ConversionDeletionRequest",
  "fields": [
    {
      "name": "created_time",
      "type": "string",
      "doc": "Timestamp when the conversion deletion request was succesfully created."
    },
    {
      "name": "processed_time",
      "type": ["null", "string"],
      "doc": "Timestamp when the conversion deletion request was processed.",
      "default": null
    },
    {
      "name": "request_id",
      "type": "string",
      "doc": "Unique identifier of the conversion deletion request"
    },
    {
      "name": "status",
      "type": "model.ConversionDeletionRequestStatus",
      "doc": "Represents the status of the conversion deletion request. \"PENDING\" or \"SUBMITTED\". \"PENDING\" meaning the Advertiser can cancel the request. The advertiser has a 7 day time window after the conversion deletion request was submitted to cancel it. \"SUBMITTED\" meaning that the Data Deletion process has begun and can no longer be canceled."
    }
  ]

}
