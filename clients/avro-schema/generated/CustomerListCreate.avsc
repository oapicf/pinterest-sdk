{
  "namespace": "model",
  "type": "record",
  "doc": "Resource create operation model.",
  "name": "CustomerListCreate",
  "fields": [
    {
      "name": "is_nca",
      "type": ["null", "boolean"],
      "doc": "Whether the list was uploaded for new customer acquisition (expanded matching). Immutable after creation.",
      "default": null
    },
    {
      "name": "list_type",
      "type": ["model.UserListType", "null"],
      "doc": "Type of customer list (e.g., EMAIL, IDFA, MAID).",
      "default": EMAIL
    },
    {
      "name": "name",
      "type": "string",
      "doc": "Customer list name."
    },
    {
      "name": "records",
      "type": ["null", "string"],
      "doc": "Records list. Can be any combination of emails, MAIDs, or IDFAs. Emails must be lowercase and can be plain text or hashed using SHA1, SHA256, or MD5. MAIDs and IDFAs must be hashed with SHA1, SHA256, or MD5.",
      "default": null
    },
    {
      "name": "records_v2",
      "type": ["null", {
        "type": "array",
        "items": "model.CustomerListRecordRow"
      }],
      "doc": "Multi-field record format. Array of objects with optional email, maid, ip_address, user_agent, external_id, hashed_pinner_id, hashed_phone_number, and liveramp_envelope per row. Provide exactly one of records or records_v2.",
      "default": null
    }
  ]

}
