{
  "namespace": "model",
  "type": "record",
  "doc": "Bid floor specification for a given campaign configuration.",
  "name": "BidFloorSpec",
  "fields": [
    {
      "name": "billable_event",
      "type": "model.ActionType",
      "doc": "Ad group billable event type."
    },
    {
      "name": "countries",
      "type": ["null", {
        "type": "array",
        "items": "model.Country"
      }],
      "doc": "List of ISO 3166-1 alpha-2 country codes.",
      "default": null
    },
    {
      "name": "creative_type",
      "type": ["null", "model.CreativeType"],
      "doc": "Creative type for the bid floor request.",
      "default": null
    },
    {
      "name": "currency",
      "type": "model.Currency",
      "doc": "Currency for the bid floor value."
    },
    {
      "name": "objective_type",
      "type": ["null", "model.BidFloorObjectiveType"],
      "doc": "Campaign objective type.",
      "default": null
    },
    {
      "name": "optimization_goal_metadata",
      "type": ["null", "model.OptimizationGoalMetadata"],
      "doc": "Optimization goal metadata.",
      "default": null
    }
  ]

}
