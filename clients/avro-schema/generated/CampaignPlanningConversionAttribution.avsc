    {
      "name": "engagement_window_days",
      "type": ["null", "model.CampaignPlanningConversionAttributionWindowDays"],
      "doc": "Number of days to use as the conversion attribution window for an engagement action. Engagements include saves, closeups, link clicks, and carousel card swipes.",
      "default": null
    },
    {
      "name": "view_window_days",
      "type": ["null", "model.CampaignPlanningConversionAttributionWindowDays"],
      "doc": "Number of days to use as the conversion attribution window for a view action.",
