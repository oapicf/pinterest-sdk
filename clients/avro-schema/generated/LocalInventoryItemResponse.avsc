{
  "namespace": "model",
  "type": "record",
  "doc": "Local inventory item response",
  "name": "LocalInventoryItemResponse",
  "fields": [
    {
      "name": "ad_link",
      "type": ["null", "string"],
      "doc": "Ad link for the item",
      "default": null
    },
    {
      "name": "availability",
      "type": ["null", "model.ItemAvailability"],
      "doc": "Availability status of the item",
      "default": null
    },
    {
      "name": "created_at",
      "type": "long",
      "doc": "The millisecond timestamp when the local inventory item was created"
    },
    {
      "name": "item_id",
      "type": "string",
      "doc": "The catalog item id in the merchant namespace"
    },
    {
      "name": "last_updated_time",
      "type": "long",
      "doc": "The millisecond timestamp when the local inventory item was lastly modified by the merchant."
    },
    {
      "name": "price",
      "type": ["null", "string"],
      "doc": "The price of the product. It supports the following formats, \"49.99 USD\", \"49.99USD\" and \"49.99\". If the currency is not included, we default to US dollars.",
      "default": null
    },
    {
      "name": "sale_price",
      "type": ["null", "string"],
      "doc": "The sale price of the product. It supports the following formats, \"24.99 USD\", \"24.99USD\" and \"24.99\". If the currency is not included, we default to US dollars.",
      "default": null
    },
    {
      "name": "store_metadata",
      "type": "model.StoreMetadata",
      "doc": "Store metadata for this local inventory item"
    }
  ]

}
