{
  "namespace": "model",
  "type": "record",
  "doc": "Resource create operation model.",
  "name": "BoardCreate",
  "fields": [
    {
      "name": "description",
      "type": ["null", "string"],
      "doc": "",
      "default": null
    },
    {
      "name": "is_ads_only",
      "type": ["boolean", "null"],
      "doc": "If set to `true`, the board will be ad-only and can store ad-only Pins.",
      "default": false
    },
    {
      "name": "name",
      "type": "string",
      "doc": "     Name of the board.      **Note:** If you create an ad-only board by setting `is_ads_only`     to `true`, the board name automatically becomes \"Ad-only Pins\"."
    },
    {
      "name": "privacy",
      "type": ["model.BoardPrivacy", "null"],
      "doc": "    Privacy setting for a board. Learn more about [secret](https://help.pinterest.com/en/article/secret-boards)     boards and [protected](https://help.pinterest.com/en/business/article/protected-boards) boards.      **Note:** If you create an ad-only board by setting `is_ads_only`     to `true`, the `privacy` settng automatically becomes `PROTECTED`. ",
      "default": PUBLIC
    }
  ]

}
