{
  "namespace": "model",
  "type": "record",
  "doc": "Resource create operation model.",
  "name": "ConversionMSOTEventsCreate",
  "fields": [
    {
      "name": "action_timestamps",
      "type": ["null", {
        "type": "array",
        "items": "long"
      }],
      "doc": "Timestamp(s) when the ad action(s) happened. Unix timestamp in seconds.",
      "default": null
    },
    {
      "name": "ad_group_id",
      "type": "string",
      "doc": "The ID of the ad group that was attributed to the conversion event."
    },
    {
      "name": "attribution_model",
      "type": ["null", "model.AttributionModel"],
      "doc": "The attribution model used to attribute the conversion event.",
      "default": null
    },
    {
      "name": "attribution_scope",
      "type": ["null", "model.AttributionScope"],
      "doc": "Ad event type.",
      "default": null
    },
    {
      "name": "attribution_score",
      "type": ["null", "double"],
      "doc": "Credit given to the attributed ad actions. Allowed values are > 0 and <= 1.",
      "default": null
    },
    {
      "name": "campaign_id",
      "type": ["null", "string"],
      "doc": "The ID of the campaign that was attributed to the conversion event.",
      "default": null
    },
    {
      "name": "click_window",
      "type": ["null", "string"],
      "doc": "Click window used for attribution (for example, `1d`, `7d`, `30d`, `lifetime`).",
      "default": null
    },
    {
      "name": "currency",
      "type": ["null", "model.Currency"],
      "doc": "Currency code for the `value` field, required if `value` is present. Currency Codes should be in ISO 4217 standard.",
      "default": null
    },
    {
      "name": "event_id",
      "type": "string",
      "doc": "A unique id string that identifies this event. If you are already sending us events through Conversions API, then this id should match the event_id sent through Conversions API."
    },
    {
      "name": "event_name",
      "type": "model.MsotEventName",
      "doc": "Type of user event."
    },
    {
      "name": "event_timestamp",
      "type": "long",
      "doc": "The time when the event occurred. Unix timestamp in seconds."
    },
    {
      "name": "total_event_touchpoints",
      "type": ["null", "int"],
      "doc": "Total number of ad events including other non-Pinterest ad platforms.",
      "default": null
    },
    {
      "name": "total_events",
      "type": ["null", "int"],
      "doc": "Deprecated: use `total_events_fractional` instead to avoid rounding errors. Total number of conversion events that are reported in one API call.  If you are sending one API request for one attributed conversion event then this value should be 1. If you are sending multiple attributed conversion events in one API request then this value should be the total number of attributed conversion events in the request.",
      "default": null
    },
    {
      "name": "total_events_fractional",
      "type": ["null", "double"],
      "doc": "Total number of conversion events that are reported in one API call. Use this field instead of `total_events` to send precise fractional values.  If you are sending one API request for one attributed conversion event with full credit, this value should be 1.0. For partial attribution, send the exact fractional value (e.g., 0.5 for half credit).",
      "default": null
    },
    {
      "name": "value",
      "type": ["null", "double"],
      "doc": "Order value of the conversion event. Required if `event_name` is `add_to_cart` or `checkout`.",
      "default": null
    },
    {
      "name": "view_window",
      "type": ["null", "string"],
      "doc": "View window used for attribution (for example, `1d`, `7d`, `30d`).",
      "default": null
    }
  ]

}
