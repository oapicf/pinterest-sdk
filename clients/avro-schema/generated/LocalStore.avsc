      "doc": "The ID of the local store."
    },
    {
      "name": "latitude",
      "type": ["null", "float"],
      "doc": "Geographic latitude coordinate of the store.",
      "default": null
    },
    {
      "name": "longitude",
      "type": ["null", "float"],
      "doc": "Geographic longitude coordinate of the store.",
      "default": null
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name of the local store."
    },
    {
