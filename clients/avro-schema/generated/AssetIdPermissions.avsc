{
  "namespace": "model",
  "type": "record",
  "doc": "An object containing the permissions a business member has on the asset.",
  "name": "AssetIdPermissions",
  "fields": [
    {
      "name": "asset_group_info",
      "type": ["null", "model.AssetGroupBinding"],
      "doc": "An object containing all the information specific to the provided asset group. This field will be populated only if asset_type equals 'ASSET_GROUP'.",
      "default": null
    },
    {
      "name": "asset_id",
      "type": "string",
      "doc": "Unique identifier of a business asset."
    },
    {
      "name": "asset_type",
      "type": "model.AssetTypeResponse",
      "doc": ""
    },
    {
      "name": "permissions",
      "type": {
        "type": "array",
        "items": "string"
      },
      "doc": "Permission levels member or partner has on an asset."
    }
  ]

}
