{
  "namespace": "model",
  "type": "record",
  "doc": "Resource create operation model.",
  "name": "AdGroupAudienceSizingCreate",
  "fields": [
    {
      "name": "auto_targeting_enabled",
      "type": ["boolean", "null"],
      "doc": "Enable auto-targeting for ad group. Default value is True. Also known as [Pinterest Performance+ targeting](https://help.pinterest.com/en/business/article/performance-plus-targeting).",
      "default": true
    },
    {
      "name": "creative_types",
      "type": ["null", {
        "type": "array",
        "items": "model.AdGroupAudienceSizingCreativeTypes"
      }],
      "doc": "Pin creative types filter. **Note:** SHOP_THE_PIN has been deprecated. Please use COLLECTION instead.",
      "default": null
    },
    {
      "name": "keywords",
      "type": ["null", {
        "type": "array",
        "items": "model.AdGroupAudienceSizingKeyword"
      }],
      "doc": "Array of keyword objects. If the keywords field is missing, all keywords will be targeted.",
      "default": null
    },
    {
      "name": "placement_group",
      "type": ["model.AdgroupPlacementGroupType", "null"],
      "doc": "[Placement group](/docs/redoc/#section/Placement-group).",
      "default": ALL
    },
    {
      "name": "product_group_ids",
      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "Targeted product group IDs. **Note:** This can only be combined with shopping/catalog sales campaigns. For more information, [click here](https://help.pinterest.com/en/business/article/shopping-ads#section-14571). SHOPPING_RETARGETING must be included in targeting_spec object or this field will be ignored.",
      "default": null
    },
    {
      "name": "targeting_spec",
      "type": ["null", "model.TargetingSpecOptimal"],
      "doc": "",
      "default": null
    }
  ]

}
