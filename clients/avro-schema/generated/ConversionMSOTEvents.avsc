{
  "namespace": "model",
  "type": "record",
  "doc": "Object containing the MSOT conversion events.",
  "name": "ConversionMSOTEvents",
  "fields": [
    {
      "name": "action_timestamps",
      "type": ["null", {
        "type": "array",
        "items": "long"
      }],
      "doc": "Timestamp(s) when the ad action(s) happened. Unix timestamp in seconds.",
      "default": null
    },
    {
      "name": "ad_group_id",
      "type": "string",
      "doc": "The ID of the ad group that was attributed to the conversion event."
    },
    {
      "name": "attribution_model",
      "type": ["null", {
        "type": "enum",
        "name": "ConversionMSOTEvents_attributionUnderscoremodel",
        "symbols": [
          "first_touch",
          "last_touch",
          "multi_touch"
        ]
      }],
      "doc": "The attribution model used to attribute the conversion event.",
      "default": null
    },
    {
      "name": "attribution_scope",
      "type": {
        "type": "enum",
        "name": "ConversionMSOTEvents_attributionUnderscorescope",
        "symbols": [
          "view",
          "engagement",
          "click"
        ]
      },
      "doc": "Ad event type."
    },
    {
      "name": "attribution_score",
      "type": ["null", "double"],
      "doc": "Credit given to the attributed ad actions. Allowed values are > 0 and <= 1.",
      "default": null
    },
    {
      "name": "campaign_id",
      "type": ["null", "string"],
      "doc": "The ID of the campaign that was attributed to the conversion event.",
      "default": null
    },
    {
      "name": "currency",
      "type": ["null", "model.Currency"],
      "doc": "",
      "default": null
    },
    {
      "name": "event_id",
      "type": "string",
      "doc": "A unique id string that identifies this event. If you are already sending us events through Conversions API, then this id should match the event_id sent through Conversions API."
    },
    {
      "name": "event_name",
      "type": {
        "type": "enum",
        "name": "ConversionMSOTEvents_eventUnderscorename",
        "symbols": [
          "add_to_cart",
          "checkout",
          "lead",
          "signup"
        ]
      },
      "doc": "Type of user event."
    },
    {
      "name": "event_timestamp",
      "type": "long",
      "doc": "The time when the event occurred. Unix timestamp in seconds."
    },
    {
      "name": "total_event_touchpoints",
      "type": ["null", "int"],
      "doc": "Total number of ad events including other non-Pinterest ad platforms.",
      "default": null
    },
    {
      "name": "total_events",
      "type": ["null", "int"],
      "doc": "Total number of conversion events that are reported in one API call. <p>If you are sending one API request for one attributed conversion event then this value should be 1.</p> <p>If you are sending multiple attributed conversion events in one API request then this value should be the total number of attributed conversion events in the request.</p>",
      "default": null
    },
    {
      "name": "value",
      "type": ["null", "double"],
      "doc": "Order value of the conversion event. Required if <code>event_name</code> is 'add_to_cart' or 'checkout'.",
      "default": null
    }
  ]

}
