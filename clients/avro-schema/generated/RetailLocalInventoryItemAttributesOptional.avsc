{
  "namespace": "model",
  "type": "record",
  "doc": "Local inventory attributes for retail items (all fields optional for update/get)",
  "name": "RetailLocalInventoryItemAttributesOptional",
  "fields": [
    {
      "name": "ad_link",
      "type": ["null", "string"],
      "doc": "Ad link for the item",
      "default": null
    },
    {
      "name": "availability",
      "type": ["null", "model.ItemAvailability"],
      "doc": "Availability status of the item",
      "default": null
    },
    {
      "name": "price",
      "type": ["null", "string"],
      "doc": "The price of the product. It supports the following formats, \"49.99 USD\", \"49.99USD\" and \"49.99\". If the currency is not included, we default to US dollars.",
      "default": null
    },
    {
      "name": "sale_price",
      "type": ["null", "string"],
      "doc": "The sale price of the product. It supports the following formats, \"24.99 USD\", \"24.99USD\" and \"24.99\". If the currency is not included, we default to US dollars.",
      "default": null
    }
  ]

}
