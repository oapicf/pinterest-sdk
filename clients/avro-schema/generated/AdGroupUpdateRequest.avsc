{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "AdGroupUpdateRequest",
  "fields": [
    {
      "name": "bid_multiplier",
      "type": ["null", "double"],
      "doc": "<a href=\"/docs/getting-started/using-beta-and-restricted-features/\" target=\"blank>Open beta</a> Bid multiplier for ad group. This value is a double between 0.1 and 10.0. Enter 0 to remove the bid multiplier. - Make sure the `bid_strategy` type for your ad group is set to `AUTOMATIC_BID`. - Not currently supported for <a href=\"/docs/api-features/pinterest-performance-plus-setup/\" target=\"blank\">Pinterest Performance+ campaigns</a>.",
      "default": null
    },
    {
      "name": "id",
      "type": "string",
      "doc": "Ad group ID."
    },
    {
      "name": "targeting_spec_operations",
      "type": ["null", {
        "type": "array",
        "items": "model.TargetingSpecOperations"
      }],
      "doc": "<div>Targeting spec operations define modifications to apply to the targeting spec.</div> <br /> <div><strong>NOTE:</strong> The <code>targeting_spec</code> and <code>targeting_spec_operations</code> cannot be sent at the same time.</div> <br /> <div>The supported operations are:</div> <ul> <li><code>SET</code>: sets the field with the given values. If value is set to <code>null</code>, the field will be removed.</li> <li><code>ADD</code>: adds the given values to the field.</li> <li><code>REMOVE</code>: removes the given values from the field.</li> </ul> <div>Note the following:</div> <ul> <li>Same items are not added and removed at the same time.</li> <li>For a given field, only <code>ADD</code>/<code>REMOVE</code> or <code>SET</code> operations are allowed, not a mix of them.</li> <li>Only one SET operation is allowed for a given field.</li> <li>The <code>AGE_BUCKET</code>, <code>MAXIMUM_AGE</code>, <code>MINIMUM_AGE</code> and <code>SHOPPING_RETARGETING</code> fields only support the <code>SET</code> operation.</li> </ul>",
      "default": null
    },
    {
      "name": "auto_targeting_enabled",
      "type": ["null", "boolean"],
      "doc": "Enable auto-targeting for ad group. Default value is True. Also known as <a href=\"https://help.pinterest.com/en/business/article/performance-plus-targeting\" target=\"_blank\">\"Pinterest Performance+ targeting\"</a>.",
      "default": null
    },
    {
      "name": "bid_in_micro_currency",
      "type": ["null", "int"],
      "doc": "Bid price in micro currency. This field is **REQUIRED** for the following campaign objective_type/billable_event combinations: AWARENESS/IMPRESSION, CONSIDERATION/CLICKTHROUGH, CATALOG_SALES/CLICKTHROUGH.",
      "default": null
    },
    {
      "name": "bid_strategy_type",
      "type": ["null", "model.BidStrategyType"],
      "doc": "",
      "default": null
    },
    {
      "name": "billable_event",
      "type": ["null", "model.ActionType"],
      "doc": "",
      "default": null
    },
    {
      "name": "budget_in_micro_currency",
      "type": ["null", "int"],
      "doc": "Budget in micro currency. This field is **REQUIRED** for non-CBO (campaign budget optimization) campaigns.  A CBO campaign automatically generates ad group budgets from its campaign budget to maximize campaign outcome. A CBO campaign is limited to 70 or less ad groups.",
      "default": null
    },
    {
      "name": "budget_type",
      "type": ["null", "model.BudgetType"],
      "doc": "",
      "default": null
    },
    {
      "name": "campaign_id",
      "type": ["null", "string"],
      "doc": "Campaign ID of the ad group.",
      "default": null
    },
    {
      "name": "end_time",
      "type": ["null", "int"],
      "doc": "Timestamp in Unix format for scheduling when ads in the ad group stop appearing. If not specified, ads run indefinitely unless you update the ad group by changing their status to `paused`. Cannot occur after `end_time` for parent campaign (if specified). Learn about <a href=\"/docs/api-features/managing-ads/#step-2-create-an-ad-group\" target=\"blank\">scheduling ads</a>. For certain organizations (<a href=\"/docs/getting-started/using-beta-and-restricted-features/\" target=\"blank\" target=\"blank\">Closed beta</a>): Supported for campaigns with Campaign Budget Optimization (CBO). For all organizations: Supported for campaigns without CBO.",
      "default": null
    },
    {
      "name": "is_creative_optimization",
      "type": ["null", "boolean"],
      "doc": "Enable creative optimization for the ad group, default value is FALSE. When enabled, you allow Pinterest to automatically turn your product Pins into ads in different formats (collections and shopping) and deliver those ads to users at scale.",
      "default": null
    },
    {
      "name": "lifetime_frequency_cap",
      "type": ["null", "int"],
      "doc": "Set a limit to the number of times a promoted pin from this campaign can be impressed by a pinner within the past rolling 30 days. Only available for CPM (cost per mille (1000 impressions))  ad groups. A CPM ad group has an IMPRESSION <a href=\"/docs/redoc/#section/Billable-event\">billable_event</a> value. This field **REQUIRES** the `end_time` field.",
      "default": null
    },
    {
      "name": "name",
      "type": ["null", "string"],
      "doc": "Ad group name.",
      "default": null
    },
    {
      "name": "optimization_goal_metadata",
      "type": ["null", "model.object"],
      "doc": "Optimization goals for objective-based performance campaigns. **REQUIRED** when campaign's `objective_type` is set to `\"WEB_CONVERSION\"`.",
      "default": null
    },
    {
      "name": "pacing_delivery_type",
      "type": ["null", "model.PacingDeliveryType"],
      "doc": "",
      "default": null
    },
    {
      "name": "placement_group",
      "type": ["null", "model.PlacementGroupType"],
      "doc": "<a href=\"/docs/redoc/#section/Placement-group\">Placement group</a>.",
      "default": null
    },
    {
      "name": "promotion_application_level",
      "type": ["null", {
        "type": "enum",
        "name": "AdGroupUpdateRequest_promotionUnderscoreapplicationUnderscorelevel",
        "symbols": [
          "NONE",
          "ITEM",
          "AD_GROUP"
        ]
      }],
      "doc": "Specify if the promotion is applied at ad group or item level",
      "default": null
    },
    {
      "name": "promotion_id",
      "type": ["string", "null"],
      "doc": "Promotion ID. To clear this field, set to null.",
      "default": "0"
    },
    {
      "name": "promotion_ids",
      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "Promotion IDs list. To clear this field, set to an empty array [].",
      "default": null
    },
    {
      "name": "start_time",
      "type": ["null", "int"],
      "doc": "Timestamp in Unix format for scheduling when ads in the ad group start to appear. If not specified, ads appear during parent campaign's `start_time`. Cannot precede `start_time` for parent campaign (if specified). Learn about <a href=\"/docs/api-features/managing-ads/#step-2-create-an-ad-group\" target=\"blank\">scheduling ads</a>. For certain organizations (<a href=\"/docs/getting-started/using-beta-and-restricted-features/\" target=\"blank\" target=\"blank\">Closed beta</a>): Supported for campaigns with Campaign Budget Optimization (CBO). For all organizations: Supported for campaigns without CBO.",
      "default": null
    },
    {
      "name": "status",
      "type": ["null", "model.EntityStatus"],
      "doc": "Ad group/entity status.",
      "default": null
    },
    {
      "name": "targeting_spec",
      "type": ["null", "model.TargetingSpec"],
      "doc": "",
      "default": null
    },
    {
      "name": "targeting_template_ids",
      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "Targeting template IDs applied to the ad group. We currently only support 1 targeting template per ad group. To use targeting templates, do not set any other targeting fields: targeting_spec, tracking_urls, auto_targeting_enabled, placement_group. To clear all targeting template IDs, set this field to ['0'].",
      "default": null
    },
    {
      "name": "tracking_urls",
      "type": ["null", "model.object"],
      "doc": "Third-party tracking URLs.<br> JSON object with the format: {\"<a href=\"/docs/redoc/#section/Tracking-URL-event\">Tracking event enum</a>\":[URL string array],...}<br> For example: {\"impression\": [\"URL1\", \"URL2\"], \"click\": [\"URL1\", \"URL2\", \"URL3\"]}.<br>Up to three tracking URLs are supported for each event type. Tracking URLs set at the ad group or ad level can override those set at the campaign level. May be null. Pass in an empty object - EmptyObject - to remove tracking URLs.<br><br> For more information, see <a href=\"https://help.pinterest.com/en/business/article/third-party-and-dynamic-tracking\" target=\"_blank\">Third-party and dynamic tracking</a>.",
      "default": null
    }
  ]

}
