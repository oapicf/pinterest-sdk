{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "Promotion",
  "fields": [
    {
      "name": "ad_account_id",
      "type": "string",
      "doc": "The Ad Account ID that this promotion belongs to."
    },
    {
      "name": "discount_status",
      "type": ["null", "model.DiscountStatus"],
      "doc": "",
      "default": null
    },
    {
      "name": "end_time",
      "type": ["null", "int"],
      "doc": "Promotion end time. Unix timestamp in seconds. Independent of campaign end time.",
      "default": null
    },
    {
      "name": "external_id",
      "type": ["null", "string"],
      "doc": "Platform-specific ID for this promotion. Will be null for promotions first created within Pinterest.",
      "default": null
    },
    {
      "name": "id",
      "type": "string",
      "doc": "Promotion ID"
    },
    {
      "name": "platform_type",
      "type": ["null", "string"],
      "doc": "The source integration platform used when creating the promotion. Currently supported values are 'DEFAULT' and 'SHOPIFY'.",
      "default": null
    },
    {
      "name": "promotion_code",
      "type": ["null", "string"],
      "doc": "Code that can be used to redeem a promotion.",
      "default": null
    },
    {
      "name": "promotion_custom_id",
      "type": ["null", "string"],
      "doc": "An optional field for user defined promotion ID for this promotion. Will copy from Pinterest system generated ID if user did not provide one.",
      "default": null
    },
    {
      "name": "promotion_title",
      "type": "string",
      "doc": "Internal name for the promotion."
    },
    {
      "name": "promotion_type",
      "type": "model.PromotionType",
      "doc": ""
    },
    {
      "name": "start_time",
      "type": ["null", "int"],
      "doc": "Promotion start time. Unix timestamp in seconds. Independent of campaign start time.",
      "default": null
    },
    {
      "name": "status",
      "type": ["null", "model.EntityStatus"],
      "doc": "",
      "default": null
    },
    {
      "name": "template_values",
      "type": ["null", {
        "type": "array",
        "items": "model.PromotionTemplateValue"
      }],
      "doc": "List of values to be inserted in the promotion type-specific template.",
      "default": null
    }
  ]

}
