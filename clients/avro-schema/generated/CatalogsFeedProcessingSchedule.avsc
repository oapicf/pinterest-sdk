  "name": "CatalogsFeedProcessingSchedule",
  "fields": [
    {
      "name": "time",
      "type": "string",
      "doc": "A time in format HH:MM with leading 0 (zero)"
    },
    {
      "name": "timezone",
      "type": "model.CatalogsFeedProcessingScheduleTimezone",
      "doc": "The timezone considered for the processing schedule time."
    }
  ]

}
