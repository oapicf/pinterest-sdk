      "type": ["null", {
        "type": "array",
        "items": "model.AdGroupSummaryStatus"
      }],
      "doc": "List of values for filtering",
      "default": null
    },
    {
      "name": "ad_ids",
      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "List of ad ids. This parameter is not supported for Product Item level reports.",
      "default": null
    },
    {
      "name": "ad_statuses",
      "type": ["null", {
        "type": "array",
        "items": "model.PinPromotionSummaryStatus"
      }],
      "doc": "List of values for filtering. This parameter is not supported for Product Item level reports.",
      "default": null
    },
    {
      "name": "attribution_types",
      "type": ["null", {
        "type": "array",
        "items": "model.ConversionReportAttributionType"
      }],
      "doc": "List of attribution types for the conversion report.",
      "default": null
    },
    {
      "name": "campaign_brand_label",
      "type": ["null", "string"],
      "doc": "Campaign brand label for filtering.",
      "default": null
    },
    {
      "name": "campaign_custom_label",
      "type": ["null", "string"],
      "doc": "Campaign custom label for filtering.",
      "default": null
    },
    {
      "name": "campaign_ids",
      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "List of campaign ids",
      "default": null
    },
    {
      "name": "campaign_objective_types",
      "type": ["null", {
        "type": "array",
        "items": "model.CampaignObjectiveType"
      }],
      "doc": "List of values for filtering. [\"WEB_SESSIONS\"] is in BETA.",
      "default": null
    },
    {
      "name": "campaign_statuses",
      "type": ["null", {
        "type": "array",
        "items": "model.CampaignSummaryStatus"
      }],
      "doc": "List of status values for filtering",
      "default": null
    },
    {
      "name": "click_window_days",
      "type": ["model.ConversionAttributionWindowDays", "null"],
      "doc": "Number of days to use as the conversion attribution window for a pin click action.",
      "default": 30
    },
    {
      "name": "columns",
      "type": ["null", {
        "type": "array",
        "items": "model.ReportingColumnAsync"
      }],
      "doc": "Metric and entity columns. Pin promotion and ad related columns are not supported for Product Item level reports.",
      "default": null
    },
    {
      "name": "combine_targeting_types",
      "type": ["boolean", "null"],
      "doc": "Determines if the targeting types included in the request should be consolidated into a single breakdown.",
      "default": false
    },
    {
      "name": "conversion_report_time",
      "type": ["model.ConversionReportTimeType", "null"],
      "doc": "Date dimension for conversion metrics.",
      "default": TIME_OF_AD_ACTION
    },
    {
      "name": "custom_conversion_event_metrics",
      "type": ["null", {
        "type": "array",
        "items": "model.CustomConversionEventMetrics"
      }],
      "doc": "List of advertiser-defined custom conversion event metrics to include in the report",
      "default": null
    },
    {
      "name": "end_date",
      "type": "string",
      "doc": "Metric report end date (UTC). Format: YYYY-MM-DD"
    },
    {
      "name": "end_hour",
      "type": ["null", "int"],
      "doc": "Which hour of the end date to stop the report (inclusive). Only allowed for hourly reports.",
      "default": null
    },
    {
      "name": "engagement_window_days",
      "type": ["model.ConversionAttributionWindowDays", "null"],
      "doc": "Number of days to use as the conversion attribution window for an engagement action.",
      "default": 30
    },
    {
      "name": "granularity",
      "type": "model.Granularity",
      "doc": "  TOTAL - metrics are aggregated over the specified date range.   DAY - metrics are broken down daily.   HOUR - metrics are broken down hourly.   WEEKLY - metrics are broken down weekly.   MONTHLY - metrics are broken down monthly."
    },
    {
      "name": "level",
      "type": ["null", "model.MetricsReportingLevel"],
      "doc": "Level of the report",
      "default": null
    },
    {
      "name": "metrics_filters",
      "type": ["null", {
        "type": "array",
        "items": "model.AdsAnalyticsMetricsFilter"
      }],
      "doc": "List of metrics filters",
      "default": null
    },
    {
      "name": "primary_sort",
      "type": ["model.PrimarySort", "null"],
      "doc": "",
      "default": BY_ID
    },
    {
      "name": "product_group_ids",
      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "List of product group ids",
      "default": null
    },
    {
