      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "List of product item ids",
      "default": null
    },
    {
      "name": "report_format",
      "type": ["model.DataOutputFormat", "null"],
      "doc": "",
      "default": JSON
    },
    {
      "name": "reporting_timezone",
      "type": ["null", "model.ReportingTimeZone"],
      "doc": "Specify the timezone to be applied for the reporting.",
      "default": null
    },
    {
      "name": "start_date",
      "type": "string",
      "doc": "Metric report start date (UTC). Format: YYYY-MM-DD"
    },
    {
      "name": "start_hour",
      "type": ["null", "int"],
      "doc": "Which hour of the start date to begin the report. Only allowed for hourly reports.",
      "default": null
    },
    {
      "name": "targeting_types",
      "type": ["null", {
        "type": "array",
        "items": "model.AdAdsAnalyticsAsyncTargetingTypes"
      }],
      "doc": "List of targeting types. Requires `level` to be a value ending in `_TARGETING`.",
      "default": null
    },
    {
      "name": "view_window_days",
      "type": ["model.ConversionAttributionWindowDays", "null"],
      "doc": "Number of days to use as the conversion attribution window for a view action.",
