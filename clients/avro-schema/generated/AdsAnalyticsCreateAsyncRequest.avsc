{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "AdsAnalyticsCreateAsyncRequest",
  "fields": [
    {
      "name": "attribution_types",
      "type": ["null", {
        "type": "array",
        "items": "model.ConversionReportAttributionType"
      }],
      "doc": "List of types of attribution for the conversion report",
      "default": null
    },
    {
      "name": "click_window_days",
      "type": ["model.ConversionAttributionWindowDays", "null"],
      "doc": "Number of days to use as the conversion attribution window for a pin click action. Applies to Pinterest Tag conversion metrics. Prior conversion tags use their defined attribution windows. If not specified, defaults to `30` days.",
      "default": 30
    },
    {
      "name": "conversion_report_time",
      "type": ["model.ConversionReportTimeType", "null"],
      "doc": "The date by which the conversion metrics returned from this endpoint will be reported. There are two dates associated with a conversion event: the date that the user interacted with the ad, and the date that the user completed a conversion event.",
      "default": ConversionReportTimeType.TIME_OF_AD_ACTION
    },
    {
      "name": "end_date",
      "type": "string",
      "doc": "Metric report end date (UTC). Format: YYYY-MM-DD"
    },
    {
      "name": "engagement_window_days",
      "type": ["model.ConversionAttributionWindowDays", "null"],
      "doc": "Number of days to use as the conversion attribution window for an engagement action. Engagements include saves, closeups, link clicks, and carousel card swipes. Applies to Pinterest Tag conversion metrics. Prior conversion tags use their defined attribution windows. If not specified, defaults to `30` days.",
      "default": 30
    },
    {
      "name": "granularity",
      "type": "model.Granularity",
      "doc": "TOTAL - metrics are aggregated over the specified date range.<br> DAY - metrics are broken down daily.<br> HOUR - metrics are broken down hourly.<br>WEEKLY - metrics are broken down weekly.<br>MONTHLY - metrics are broken down monthly"
    },
    {
      "name": "start_date",
      "type": "string",
      "doc": "Metric report start date (UTC). Format: YYYY-MM-DD"
    },
    {
      "name": "view_window_days",
      "type": ["model.ConversionAttributionWindowDays", "null"],
      "doc": "Number of days to use as the conversion attribution window for a view action. Applies to Pinterest Tag conversion metrics. Prior conversion tags use their defined attribution windows. If not specified, defaults to `1` day.",
      "default": 1
    },
    {
      "name": "campaign_ids",
      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "List of campaign ids",
      "default": null
    },
    {
      "name": "campaign_statuses",
      "type": ["null", {
        "type": "array",
        "items": "model.CampaignSummaryStatus"
      }],
      "doc": "List of status values for filtering",
      "default": null
    },
    {
      "name": "campaign_objective_types",
      "type": ["null", {
        "type": "array",
        "items": "model.ObjectiveType"
      }],
      "doc": "List of values for filtering. [\"WEB_SESSIONS\"] in BETA.",
      "default": null
    },
    {
      "name": "campaign_brand_label",
      "type": ["null", "string"],
      "doc": "Campaign brand label for filtering.",
      "default": null
    },
    {
      "name": "ad_group_ids",
      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "List of ad group ids",
      "default": null
    },
    {
      "name": "ad_group_statuses",
      "type": ["null", {
        "type": "array",
        "items": "model.AdGroupSummaryStatus"
      }],
      "doc": "List of values for filtering",
      "default": null
    },
    {
      "name": "ad_ids",
      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "List of ad ids [This parameter is no supported for Product Item Level Reports]",
      "default": null
    },
    {
      "name": "ad_statuses",
      "type": ["null", {
        "type": "array",
        "items": "model.PinPromotionSummaryStatus"
      }],
      "doc": "List of values for filtering [This parameter is not supported for Product Item Level Reports]",
      "default": null
    },
    {
      "name": "product_group_ids",
      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "List of product group ids",
      "default": null
    },
    {
      "name": "product_group_statuses",
      "type": ["null", {
        "type": "array",
        "items": "model.ProductGroupSummaryStatus"
      }],
      "doc": "List of values for filtering",
      "default": null
    },
    {
      "name": "product_item_ids",
      "type": ["null", {
        "type": "array",
        "items": "string"
      }],
      "doc": "List of product item ids",
      "default": null
    },
    {
      "name": "targeting_types",
      "type": ["null", {
        "type": "enum",
        "name": "AdsAnalyticsCreateAsyncRequest_targetingUnderscoretypes",
        "symbols": [
          "KEYWORD",
          "APPTYPE",
          "GENDER",
          "LOCATION",
          "PLACEMENT",
          "COUNTRY",
          "TARGETED_INTEREST",
          "PINNER_INTEREST",
          "AUDIENCE_INCLUDE",
          "GEO",
          "AGE_BUCKET",
          "REGION",
          "MEDIA_TYPE",
          "AGE_BUCKET_AND_GENDER",
          "AUDIENCE_MULTIPLIER",
          "CREATIVE_ENHANCEMENTS",
          "LOCAL_ADS_STORE_CODE"
        ]
      }],
      "doc": "List of targeting types. Requires `level` to be a value ending in `_TARGETING`. [\"AUDIENCE_MULTIPLIER\"] is only available in CAMPAIGN_TARGETING level. [\"MEDIA_TYPE\"] is only available in PRODUCT_ITEM_TARGETING level. [\"AGE_BUCKET_AND_GENDER\"] is in BETA and not yet available to all users.",
      "default": null
    },
    {
      "name": "metrics_filters",
      "type": ["null", {
        "type": "array",
        "items": "model.AdsAnalyticsMetricsFilter"
      }],
      "doc": "List of metrics filters",
      "default": null
    },
    {
      "name": "columns",
      "type": {
        "type": "array",
        "items": "model.ReportingColumnAsync"
      },
      "doc": "Metric and entity columns. Pin promotion and ad related columns are not supported for the Product Item level reports."
    },
    {
      "name": "combine_targeting_types",
      "type": ["boolean", "null"],
      "doc": "Determines if the targeting types included in the request should be consolidated into a single breakdown. For example, when combine_targeting_types is set to true, if GENDER and COUNTRY are targeting types in the request, the response will have a targeting type of GENDER_AND_COUNTRY and targeting values such as female&US. This feature is currently in BETA and is not available to all users.",
      "default": false
    },
    {
      "name": "custom_conversion_event_metrics",
      "type": ["null", {
        "type": "array",
        "items": "model.AdsAnalyticsCreateAsyncRequestAllOfCustomConversionEventMetrics"
      }],
      "doc": "List of advertiser-defined custom conversion event metrics to include in the report",
      "default": null
    },
    {
      "name": "end_hour",
      "type": ["null", "int"],
      "doc": "Which hour of the end date to stop the report (inclusive). For example, with an end_date of '2020-01-01' and end_hour of '15', the report will contain metrics up to '2020-01-01 14:59:59'. The entire day will be included if no end hour is provided. Only allowed for hourly reports.",
      "default": null
    },
    {
      "name": "level",
      "type": "model.MetricsReportingLevel",
      "doc": "Level of the report"
    },
    {
      "name": "primary_sort",
      "type": ["null", {
        "type": "enum",
        "name": "AdsAnalyticsCreateAsyncRequest_primaryUnderscoresort",
        "symbols": [
          "BY_ID",
          "BY_DATE"
        ]
      }],
      "doc": "Whether to first sort the report by date or by entity ID of the reporting entity level. Date will be used as the first level key for JSON reports that use BY_DATE. BY_DATE is recommended for large requests.",
      "default": null
    },
    {
      "name": "report_format",
      "type": ["model.DataOutputFormat", "null"],
      "doc": "Specification for formatting the report data. Reports in JSON will not zero-fill metrics, whereas reports in CSV will. Both report formats will omit rows where all the columns are equal to 0.",
      "default": DataOutputFormat.JSON
    },
    {
      "name": "reporting_timezone",
      "type": ["null", "model.ReportingTimeZone"],
      "doc": "Specify the timezone to be applied for the reporting. This feature is currently in BETA and is not available to all users.",
      "default": null
    },
    {
      "name": "start_hour",
      "type": ["null", "int"],
      "doc": "Which hour of the start date to begin the report. The entire day will be included if no start hour is provided. Only allowed for hourly reports.",
      "default": null
    }
  ]

}
