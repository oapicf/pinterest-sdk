{
  "namespace": "model",
  "type": "record",
  "doc": "Pin image data for trending topics",
  "name": "TrendingPin",
  "fields": [
    {
      "name": "color",
      "type": "string",
      "doc": "Dominant color of the pin image in hex format"
    },
    {
      "name": "height",
      "type": "int",
      "doc": "Height of the pin image in pixels"
    },
    {
      "name": "id",
      "type": "string",
      "doc": "Unique identifier for the pin"
    },
    {
      "name": "src",
      "type": "string",
      "doc": "URL of the pin image"
    },
    {
      "name": "vertical_offset",
      "type": ["null", "double"],
      "doc": "The vertical offset of the pin image as a percentage from 0 to 100, where 0 is the top of the image and 100 is the bottom.",
      "default": null
    },
    {
      "name": "width",
      "type": "int",
      "doc": "Width of the pin image in pixels"
    }
  ]

}
