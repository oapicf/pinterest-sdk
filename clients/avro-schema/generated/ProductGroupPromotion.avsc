{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "ProductGroupPromotion",
  "fields": [
    {
      "name": "ad_group_id",
      "type": ["null", "string"],
      "doc": "ID of the ad group the product group belongs to.",
      "default": null
    },
    {
      "name": "bid_in_micro_currency",
      "type": ["null", "int"],
      "doc": "The bid in micro currency.",
      "default": null
    },
    {
      "name": "catalog_product_group_id",
      "type": ["null", "string"],
      "doc": "ID of the catalogs product group that this product group promotion references",
      "default": null
    },
    {
      "name": "catalog_product_group_name",
      "type": ["null", "string"],
      "doc": "Catalogs product group name",
      "default": null
    },
    {
      "name": "collections_header_type",
      "type": ["null", {
        "type": "enum",
        "name": "ProductGroupPromotion_collectionsUnderscoreheaderUnderscoretype",
        "symbols": [
          "SHOP_THIS_COLLECTION",
          "EXPLORE_THIS_COLLECTION",
          "NO_HEADER",
          "ON_SALE",
          "GET_DEAL"
        ]
      }],
      "doc": "Collections ad header type",
      "default": null
    },
    {
      "name": "collections_hero_destination_url",
      "type": ["null", "string"],
      "doc": "Collections Hero Destination Url",
      "default": null
    },
    {
      "name": "collections_hero_pin_id",
      "type": ["null", "string"],
      "doc": "Hero Pin ID if this PG is promoted as a Collection",
      "default": null
    },
    {
      "name": "creative_type",
      "type": ["null", "model.CreativeType"],
      "doc": "",
      "default": null
    },
    {
      "name": "customizable_cta_type",
      "type": ["null", {
        "type": "enum",
        "name": "ProductGroupPromotion_customizableUnderscorectaUnderscoretype",
        "symbols": [
          "SHOP_NOW",
          "BOOK_NOW",
          "ON_SALE",
          "GET_DEAL",
          "BUY_ONLINE_PICKUP_IN_STORE"
        ]
      }],
      "doc": "Select a call to action (CTA) to display below your ad. CTA options for catalog sales campaigns are SHOP_NOW, BOOK_NOW, ON_SALE, GET_DEAL, BUY_ONLINE_PICKUP_IN_STORE",
      "default": null
    },
    {
      "name": "definition",
      "type": ["null", "string"],
      "doc": "The full product group definition path",
      "default": null
    },
    {
      "name": "grid_click_type",
      "type": ["null", "model.GridClickType"],
      "doc": "",
      "default": null
    },
    {
      "name": "id",
      "type": ["null", "string"],
      "doc": "ID of the product group promotion.",
      "default": null
    },
    {
      "name": "included",
      "type": ["null", "boolean"],
      "doc": "True if the group is BIDDABLE, false if it should be EXCLUDED from serving ads.",
      "default": null
    },
    {
      "name": "is_generate_background",
      "type": ["null", "boolean"],
      "doc": "Enable generate backgrounds for the product group, default value is FALSE. When enabled, Pinterest will use generative AI to apply backgrounds for your product images that help drive user inspiration and engagement.",
      "default": null
    },
    {
      "name": "is_mdl",
      "type": ["null", "boolean"],
      "doc": "If set to true products promoted in this product group will use the Mobile Deep Link specified in your catalog",
      "default": null
    },
    {
      "name": "parent_id",
      "type": ["null", "string"],
      "doc": "The parent Product Group ID of this Product Group",
      "default": null
    },
    {
      "name": "preferred_media_type",
      "type": ["null", {
        "type": "enum",
        "name": "ProductGroupPromotion_preferredUnderscoremediaUnderscoretype",
        "symbols": [
          "VIDEO",
          "IMAGE"
        ]
      }],
      "doc": "Select whether to promote the image or video pin by default for items in the promoted product group. If selecting IMAGE, image will be promoted for all ads in the product group, and when selecting VIDEO, video will be promoted when present, otherwise fall back to image. This is applicable for standard shopping ads only.",
      "default": null
    },
    {
      "name": "relative_definition",
      "type": ["null", "string"],
      "doc": "The definition of the product group, relative to its parent - an attribute name/value pair",
      "default": null
    },
    {
      "name": "selected_image_tag",
      "type": ["null", "string"],
      "doc": "The ad image tag selected for the product group promotion.",
      "default": null
    },
    {
      "name": "selected_video_tag",
      "type": ["null", "string"],
      "doc": "The ad video tag selected for the product group promotion.",
      "default": null
    },
    {
      "name": "slideshow_collections_description",
      "type": ["null", "string"],
      "doc": "Slideshow Collections Description",
      "default": null
    },
    {
      "name": "slideshow_collections_title",
      "type": ["null", "string"],
      "doc": "Slideshow Collections Title",
      "default": null
    },
    {
      "name": "status",
      "type": ["null", "model.EntityStatus"],
      "doc": "",
      "default": null
    },
    {
      "name": "tracking_url",
      "type": ["null", "string"],
      "doc": "Tracking template for proudct group promotions. 4000 limit",
      "default": null
    }
  ]

}
