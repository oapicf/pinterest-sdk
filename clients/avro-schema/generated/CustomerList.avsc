{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "CustomerList",
  "fields": [
    {
      "name": "ad_account_id",
      "type": ["null", "string"],
      "doc": "Associated ad account ID.",
      "default": null
    },
    {
      "name": "created_time",
      "type": ["null", "double"],
      "doc": "Creation time. Unix timestamp in seconds.",
      "default": null
    },
    {
      "name": "exceptions",
      "type": ["null", "model.object"],
      "doc": "Customer list errors.",
      "default": null
    },
    {
      "name": "id",
      "type": "string",
      "doc": "Customer list ID."
    },
    {
      "name": "is_nca",
      "type": ["null", "boolean"],
      "doc": "Whether the list was uploaded for new customer acquisition (expanded matching). Immutable after creation.",
      "default": null
    },
    {
      "name": "name",
      "type": "string",
      "doc": "Customer list name."
    },
    {
      "name": "num_batches",
      "type": ["null", "double"],
      "doc": "Total number of list updates. List creation counts as one batch. Each [Append](/docs/redoc/#operation/ads_v3_customer_list_add_handler_PUT) or [Remove API](/docs/redoc/#operation/ads_v3_customer_list_remove_handler_PUT) call counts as another. List creation via the **Ads Manager** UI could result in more than one batch since the UI breaks up large lists.",
      "default": null
    },
    {
      "name": "num_removed_user_records",
      "type": ["null", "double"],
      "doc": "Number of removed user records. In a [Remove API](/docs/redoc/#operation/ads_v3_customer_list_remove_handler_PUT) call, this counter increases even if the user is not found in the list.",
      "default": null
    },
    {
      "name": "num_uploaded_user_records",
      "type": ["null", "double"],
      "doc": "Number of uploaded user records. In an [Append API](/docs/redoc/#operation/ads_v3_customer_list_add_handler_PUT) call, this counter increases even if the uploaded user is already in the list.",
      "default": null
    },
    {
      "name": "status",
      "type": ["null", "model.CustomerListStatus"],
      "doc": "Customer list status. `TOO_SMALL` means the list has fewer than 100 Pinterest users.",
      "default": null
    },
    {
      "name": "type",
      "type": ["null", "string"],
      "doc": "Always `customerlist`.",
      "default": null
    },
    {
      "name": "updated_time",
      "type": ["null", "double"],
      "doc": "Last update time. Unix timestamp in seconds.",
      "default": null
    }
  ]

}
