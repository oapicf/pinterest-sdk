      end if;
      if Value = "MOBILE" then
         return MOBILE;
      end if;
      if Value = "MOBILE_ANDROID" then
         return MOBILE_ANDROID;
      end if;
      if Value = "MOBILE_IOS" then
         return MOBILE_IOS;
      end if;
      if Value = "OFFLINE" then
         return OFFLINE;
      end if;
      if Value = "PINTEREST_WEB" then
         return PINTEREST_WEB;
      end if;
      if Value = "PINTEREST_ANDROID" then
         return PINTEREST_ANDROID;
      end if;
      if Value = "PINTEREST_IOS" then
         return PINTEREST_IOS;
      end if;
      if Value = "POINT_OF_SALE" then
         return POINT_OF_SALE;
      end if;
      raise Constraint_Error;
   end To_SourcePlatformOptions_Type;

   function To_String (Value : in .Models.SourcePlatformOptions_Type) return String is
   begin
      case Value is
         when WEB =>
            return "WEB";

         when MOBILE =>
            return "MOBILE";

         when MOBILE_ANDROID =>
            return "MOBILE_ANDROID";

         when MOBILE_IOS =>
