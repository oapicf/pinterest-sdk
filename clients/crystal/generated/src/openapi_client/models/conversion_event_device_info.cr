    # Returns the object in the form of hash
    # @return [Hash] Returns the object in the form of hash
    def to_h
      hash = NetboxClient::RecursiveHash.new
      hash["battery_level"] = _to_h(battery_level)
      hash["brand"] = _to_h(brand)
      hash["carrier"] = _to_h(carrier)
      hash["cpu_cores"] = _to_h(cpu_cores)
      hash["external_storage_free_space"] = _to_h(external_storage_free_space)
      hash["external_storage_size"] = _to_h(external_storage_size)
      hash["form_factor"] = _to_h(form_factor)
      hash["kernel_version"] = _to_h(kernel_version)
      hash["languages"] = _to_h(languages)
      hash["locale"] = _to_h(locale)
      hash["model"] = _to_h(model)
      hash["network_type"] = _to_h(network_type)
      hash["os_family"] = _to_h(os_family)
      hash["os_name"] = _to_h(os_name)
      hash["os_release_name"] = _to_h(os_release_name)
      hash["os_version"] = _to_h(os_version)
      hash["screen_density"] = _to_h(screen_density)
      hash["screen_height"] = _to_h(screen_height)
      hash["screen_width"] = _to_h(screen_width)
      hash["storage_free_space"] = _to_h(storage_free_space)
      hash["storage_size"] = _to_h(storage_size)
      hash["timezone"] = _to_h(timezone)
      hash["timezone_abbr"] = _to_h(timezone_abbr)
      hash["type"] = _to_h(_type)
      hash.to_h
    end

    # Outputs non-array value in the form of hash
    # For object, use to_h. Otherwise, just return the value
    # @param [Object] value Any valid value
    # @return [Hash] Returns the value in the form of hash
    private def _to_h(value)
      if value.is_a?(Hash)
        hash = NetboxClient::RecursiveHash.new
        value.each { |k, v| hash[k] = _to_h(v) }
        hash
      elsif value.is_a?(Array)
        value.compact.map { |v| _to_h(v) }
      elsif value.responds_to?(:to_h)
        value.to_h
      else
        value
      end
    end

