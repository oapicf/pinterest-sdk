    # @param [Object] storage_size Value to be assigned
    def storage_size=(storage_size)
      if !storage_size.nil? && storage_size > 1048576
        raise ArgumentError.new("invalid value for \"storage_size\", must be smaller than or equal to 1048576.")
      end

      if !storage_size.nil? && storage_size < 0
        raise ArgumentError.new("invalid value for \"storage_size\", must be greater than or equal to 0.")
      end

      @storage_size = storage_size
    end

    # Custom attribute writer method with validation
