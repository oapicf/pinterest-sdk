      hash["EXPIRATION_DATE_INVALID"] = _to_h(expiration_date_invalid)
      hash["AVAILABILITY_DATE_INVALID"] = _to_h(availability_date_invalid)
      hash["SALE_DATE_INVALID"] = _to_h(sale_date_invalid)
      hash["WEIGHT_UNIT_INVALID"] = _to_h(weight_unit_invalid)
      hash["IS_BUNDLE_INVALID"] = _to_h(is_bundle_invalid)
      hash["UPDATED_TIME_INVALID"] = _to_h(updated_time_invalid)
      hash["CUSTOM_LABEL_LENGTH_TOO_LONG"] = _to_h(custom_label_length_too_long)
      hash["PRODUCT_TYPE_LENGTH_TOO_LONG"] = _to_h(product_type_length_too_long)
      hash["TOO_MANY_ADDITIONAL_IMAGE_LINKS"] = _to_h(too_many_additional_image_links)
      hash["MULTIPACK_INVALID"] = _to_h(multipack_invalid)
      hash["INDEXED_PRODUCT_COUNT_LARGE_DELTA"] = _to_h(indexed_product_count_large_delta)
      hash["ITEM_ADDITIONAL_IMAGE_DOWNLOAD_FAILURE"] = _to_h(item_additional_image_download_failure)
      hash["OPTIONAL_PRODUCT_CATEGORY_MISSING"] = _to_h(optional_product_category_missing)
      hash["OPTIONAL_PRODUCT_CATEGORY_INVALID"] = _to_h(optional_product_category_invalid)
      hash["OPTIONAL_CONDITION_MISSING"] = _to_h(optional_condition_missing)
      hash["OPTIONAL_CONDITION_INVALID"] = _to_h(optional_condition_invalid)
      hash["IOS_DEEP_LINK_INVALID"] = _to_h(ios_deep_link_invalid)
      hash["ANDROID_DEEP_LINK_INVALID"] = _to_h(android_deep_link_invalid)
      hash["UTM_SOURCE_AUTO_CORRECTED"] = _to_h(utm_source_auto_corrected)
      hash["COUNTRY_DOES_NOT_MAP_TO_CURRENCY"] = _to_h(country_does_not_map_to_currency)
      hash["MIN_AD_PRICE_INVALID"] = _to_h(min_ad_price_invalid)
      hash["GTIN_INVALID"] = _to_h(gtin_invalid)
      hash["INCONSISTENT_CURRENCY_VALUES"] = _to_h(inconsistent_currency_values)
      hash["SALES_PRICE_TOO_LOW"] = _to_h(sales_price_too_low)
      hash["SHIPPING_WIDTH_INVALID"] = _to_h(shipping_width_invalid)
      hash["SHIPPING_HEIGHT_INVALID"] = _to_h(shipping_height_invalid)
      hash["SALES_PRICE_TOO_HIGH"] = _to_h(sales_price_too_high)
      hash["MPN_INVALID"] = _to_h(mpn_invalid)
      hash.to_h
    end

    # Outputs non-array value in the form of hash
    # For object, use to_h. Otherwise, just return the value
    # @param [Object] value Any valid value
    # @return [Hash] Returns the value in the form of hash
    private def _to_h(value)
      if value.is_a?(Hash)
        hash = NetboxClient::RecursiveHash.new
        value.each { |k, v| hash[k] = _to_h(v) }
        hash
      elsif value.is_a?(Array)
        value.compact.map { |v| _to_h(v) }
      elsif value.responds_to?(:to_h)
        value.to_h
      else
        value
      end
    end

  end

