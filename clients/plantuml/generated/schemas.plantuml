@startuml

title Pinterest REST API Schemas Diagram

entity Account {
    about: String
    account_type: UserAccountType
    board_count: Integer
    business_name: String
    follower_count: Integer
    following_count: Integer
    id: String
    monthly_views: Integer
    pin_count: Integer
    profile_image: String
    username: String
    website_url: String
}

entity AccountTemplate {
    ad_account_id: String
    ad_account_ids: List<String>
    ade_columns: List<String>
    attribution_type: OasAnyTypeNotMapped
    click_window_days: BigDecimal
    columns: List<ReportingColumn>
    conversion_report_time_type: ConversionReportTimeType
    creation_source: CreationSource
    custom_column_ids: List<String>
    display_metadata: String
    engagement_window_days: BigDecimal
    filters_json: String
    granularity: Granularity
    * id: String
    ingestion_sources: List<IngestionSource>
    is_default: Boolean
    is_deleted: Boolean
    is_owned_by_user: Boolean
    is_scheduled: Boolean
    name: String
    report_end_relative_days_in_past: BigDecimal
    report_format: DataOutputFormat
    report_level: MetricsReportingLevel
    report_start_relative_days_in_past: BigDecimal
    reporting_time_zone: ReportingTimeZone
    sort_by: OasAnyTypeNotMapped
    type: String
    updated_time: BigDecimal
    user_id: String
    view_window_days: BigDecimal
}

entity ActionType {
}

entity Ad {
    * ad_account_id: String
    * ad_group_id: String
    android_deep_link: String
    * campaign_id: String
    carousel_android_deep_links: List<String>
    carousel_destination_urls: List<String>
    carousel_ios_deep_links: List<String>
    carting_platform_type: Integer
    carting_products: List<CartingProduct>
    click_tracking_url: String
    collection_items_destination_url_template: String
    collections_header_type: AdCollectionsHeaderType
    created_time: Integer
    * creative_type: CreativeType
    customizable_cta_type: CustomizableCTAType
    destination_url: String
    disclosure_type: DisclosureType
    disclosure_url: String
    grid_click_type: GridClickType
    * id: String
    ios_deep_link: String
    is_carting: Boolean
    is_collage_accepted_terms: Boolean
    is_collage_single_destination: Boolean
    is_pin_deleted: Boolean
    is_removable: Boolean
    lead_form_id: String
    name: String
    * pin_id: String
    quiz_pin_data: QuizPinData
    * rejected_reasons: List<AdDisapprovalReasons>
    * rejection_labels: List<String>
    * review_status: AdReviewStatus
    status: EntityStatus
    * summary_status: PinPromotionSummaryStatus
    tracking_urls: TrackingUrls
    * type: String
    updated_time: Integer
    view_tracking_url: String
}

