    let
        pairs =
            [ maybeEncode "ad_account_id" Json.Encode.string model.adAccountId
            , maybeEncode "ad_account_ids" (Json.Encode.list Json.Encode.string) model.adAccountIds
            , maybeEncode "ade_columns" (Json.Encode.list Json.Encode.string) model.adeColumns
            , maybeEncodeNullable "attribution_type" encodeAnyType model.attributionType
            , maybeEncode "click_window_days" Json.Encode.float model.clickWindowDays
            , maybeEncode "columns" (Json.Encode.list encodeReportingColumn) model.columns
            , maybeEncode "conversion_report_time_type" encodeConversionReportTimeType model.conversionReportTimeType
