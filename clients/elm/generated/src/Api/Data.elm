encodeConversionTag : ConversionTag -> Json.Encode.Value
encodeConversionTag =
    encodeObject << encodeConversionTagPairs


encodeConversionTagWithTag : ( String, String ) -> ConversionTag -> Json.Encode.Value
encodeConversionTagWithTag (tagField, tag) model =
    encodeObject (encodeConversionTagPairs model ++ [ encode tagField Json.Encode.string tag ])


encodeConversionTagPairs : ConversionTag -> List EncodedField
encodeConversionTagPairs model =
    let
        pairs =
            [ maybeEncode "code_snippet" Json.Encode.string model.codeSnippet
            , maybeEncode "configs" encodeConversionTagConfigs model.configs
            , maybeEncodeNullable "enhanced_match_status" encodeEnhancedMatchStatusType model.enhancedMatchStatus
            , maybeEncode "id" Json.Encode.string model.id
            , maybeEncodeNullable "last_fired_time_ms" Json.Encode.float model.lastFiredTimeMs
            , encode "name" Json.Encode.string model.name
            , maybeEncode "version" Json.Encode.string model.version
            , encode "ad_account_id" Json.Encode.string model.adAccountId
            , maybeEncode "status" encodeEntityStatus model.status
            ]
    in
    pairs


