catalogsItemsDecoder : Json.Decode.Decoder CatalogsItems
catalogsItemsDecoder =
    Json.Decode.succeed CatalogsItems
        |> maybeDecode "items" (Json.Decode.list itemResponseDecoder) Nothing


catalogsItemsBatchDecoder : Json.Decode.Decoder CatalogsItemsBatch
catalogsItemsBatchDecoder =
    Json.Decode.field "catalogType" Json.Decode.string
        |> Json.Decode.andThen catalogsItemsBatchTagDecoder


catalogsItemsBatchTagDecoder : String -> Json.Decode.Decoder CatalogsItemsBatch
catalogsItemsBatchTagDecoder tag =
    case tag of
        "CREATIVE_ASSETS" ->
            Json.Decode.map CatalogsItemsBatchCatalogsCreativeAssetsItemsBatch catalogsCreativeAssetsItemsBatchDecoder

        "HOTEL" ->
            Json.Decode.map CatalogsItemsBatchCatalogsHotelItemsBatch catalogsHotelItemsBatchDecoder

        "RETAIL" ->
            Json.Decode.map CatalogsItemsBatchCatalogsRetailItemsBatch catalogsRetailItemsBatchDecoder

        _ ->
            Json.Decode.fail <| "Trying to decode CatalogsItemsBatch, but catalogType '" ++ tag ++ "' is not supported."



catalogsItemsBatchRequestDecoder : Json.Decode.Decoder CatalogsItemsBatchRequest
catalogsItemsBatchRequestDecoder =
    Json.Decode.field "operation" Json.Decode.string
        |> Json.Decode.andThen catalogsItemsBatchRequestTagDecoder


catalogsItemsBatchRequestTagDecoder : String -> Json.Decode.Decoder CatalogsItemsBatchRequest
catalogsItemsBatchRequestTagDecoder tag =
    case tag of
        "CREATE" ->
            Json.Decode.map CatalogsItemsBatchRequestCatalogsItemsCreateBatchRequest catalogsItemsCreateBatchRequestDecoder

        "DELETE" ->
            Json.Decode.map CatalogsItemsBatchRequestCatalogsItemsDeleteBatchRequest catalogsItemsDeleteBatchRequestDecoder

        "DELETE_DISCONTINUED" ->
            Json.Decode.map CatalogsItemsBatchRequestCatalogsItemsDeleteDiscontinuedBatchRequest catalogsItemsDeleteDiscontinuedBatchRequestDecoder

        "UPDATE" ->
            Json.Decode.map CatalogsItemsBatchRequestCatalogsItemsUpdateBatchRequest catalogsItemsUpdateBatchRequestDecoder

        "UPSERT" ->
            Json.Decode.map CatalogsItemsBatchRequestCatalogsItemsUpsertBatchRequest catalogsItemsUpsertBatchRequestDecoder

        _ ->
            Json.Decode.fail <| "Trying to decode CatalogsItemsBatchRequest, but operation '" ++ tag ++ "' is not supported."



