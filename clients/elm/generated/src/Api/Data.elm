    Json.Decode.int
        |> Json.Decode.andThen
            (\value ->
                case value of
                    "REGULAR" ->
                        Json.Decode.succeed AdGroupAudienceSizingRequestCreativeTypesREGULAR

                    "VIDEO" ->
                        Json.Decode.succeed AdGroupAudienceSizingRequestCreativeTypesVIDEO

                    "SHOPPING" ->
                        Json.Decode.succeed AdGroupAudienceSizingRequestCreativeTypesSHOPPING

                    "CAROUSEL" ->
                        Json.Decode.succeed AdGroupAudienceSizingRequestCreativeTypesCAROUSEL

                    "MAX_VIDEO" ->
                        Json.Decode.succeed AdGroupAudienceSizingRequestCreativeTypesMAXVIDEO

                    "SHOP_THE_PIN" ->
                        Json.Decode.succeed AdGroupAudienceSizingRequestCreativeTypesSHOPTHEPIN

                    "COLLECTION" ->
                        Json.Decode.succeed AdGroupAudienceSizingRequestCreativeTypesCOLLECTION

                    "IDEA" ->
                        Json.Decode.succeed AdGroupAudienceSizingRequestCreativeTypesIDEA

                    other ->
                        Json.Decode.fail <| "Unknown type: " ++ String.fromInt other
            )



