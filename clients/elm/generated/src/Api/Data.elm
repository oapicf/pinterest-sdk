            , maybeEncode "metrics_highlights" encodeProductCategoriesMetricsHighlights model.metricsHighlights
            , maybeEncode "predicted_time_series" (Json.Encode.dict identity Json.Encode.float) model.predictedTimeSeries
            , encode "product_category" encodeProductCategoryEnum model.productCategory
            , maybeEncode "related_searches" (Json.Encode.list Json.Encode.string) model.relatedSearches
            , maybeEncode "time_series" (Json.Encode.dict identity Json.Encode.float) model.timeSeries
            ]
    in
    pairs


