quizPinDataDecoder : Json.Decode.Decoder QuizPinData
quizPinDataDecoder =
    Json.Decode.succeed QuizPinData
        |> maybeDecode "questions" (Json.Decode.list quizPinQuestionDecoder) Nothing
        |> maybeDecode "results" (Json.Decode.list quizPinResultDecoder) Nothing
        |> maybeDecodeNullable "tie_breaker_custom_result" quizPinResultDecoder Nothing
        |> maybeDecode "tie_breaker_type" quizPinDataTieBreakerTypeDecoder Nothing


quizPinDataTieBreakerTypeDecoder : Json.Decode.Decoder QuizPinDataTieBreakerType
quizPinDataTieBreakerTypeDecoder =
    Json.Decode.string
        |> Json.Decode.andThen
            (\value ->
                case value of
                    "RANDOM" ->
                        Json.Decode.succeed QuizPinDataTieBreakerTypeRANDOM

                    "CUSTOM" ->
                        Json.Decode.succeed QuizPinDataTieBreakerTypeCUSTOM

                    other ->
                        Json.Decode.fail <| "Unknown type: " ++ other
            )



