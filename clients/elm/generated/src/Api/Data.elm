encodeMediaWithTag (tagField, tag) model =
    encodeObject (encodeMediaPairs model ++ [ encode tagField Json.Encode.string tag ])


encodeMediaPairs : Media -> List EncodedField
encodeMediaPairs model =
    let
        pairs =
            [ encode "media_id" Json.Encode.string model.mediaId
            , encode "media_type" encodeMediaUploadType model.mediaType
            , maybeEncode "status" encodeMediaUploadStatus model.status
