            , maybeEncode "display_metadata" Json.Encode.string model.displayMetadata
            , maybeEncode "engagement_window_days" Json.Encode.float model.engagementWindowDays
            , maybeEncodeNullable "filters_json" Json.Encode.string model.filtersJson
            , maybeEncode "granularity" encodeGranularity model.granularity
