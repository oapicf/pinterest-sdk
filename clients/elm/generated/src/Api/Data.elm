quizPinDataDecoder : Json.Decode.Decoder QuizPinData
quizPinDataDecoder =
    Json.Decode.succeed QuizPinData
        |> maybeDecode "questions" (Json.Decode.list quizPinQuestionDecoder) Nothing
        |> maybeDecode "results" (Json.Decode.list quizPinResultDecoder) Nothing
        |> maybeDecodeNullable "tie_breaker_custom_result" quizPinResultDecoder Nothing
        |> maybeDecode "tie_breaker_type" tieBreakerTypeDecoder Nothing


quizPinOptionDecoder : Json.Decode.Decoder QuizPinOption
quizPinOptionDecoder =
    Json.Decode.succeed QuizPinOption
        |> maybeDecode "id" Json.Decode.float Nothing
        |> maybeDecode "text" Json.Decode.string Nothing


quizPinQuestionDecoder : Json.Decode.Decoder QuizPinQuestion
quizPinQuestionDecoder =
    Json.Decode.succeed QuizPinQuestion
        |> maybeDecode "options" (Json.Decode.list quizPinOptionDecoder) Nothing
        |> maybeDecode "question_id" Json.Decode.float Nothing
        |> maybeDecode "question_text" Json.Decode.string Nothing


quizPinResultDecoder : Json.Decode.Decoder QuizPinResult
quizPinResultDecoder =
    Json.Decode.succeed QuizPinResult
        |> maybeDecode "android_deep_link" Json.Decode.string Nothing
        |> maybeDecode "destination_url" Json.Decode.string Nothing
        |> maybeDecode "ios_deep_link" Json.Decode.string Nothing
        |> maybeDecode "organic_pin_id" Json.Decode.string Nothing
        |> maybeDecode "result_id" Json.Decode.float Nothing


recordCountsDecoder : Json.Decode.Decoder RecordCounts
recordCountsDecoder =
    Json.Decode.succeed RecordCounts
        |> decode "invalid" Json.Decode.int 
        |> decode "processed" Json.Decode.int 
        |> decode "valid" Json.Decode.int 


relatedTermsDecoder : Json.Decode.Decoder RelatedTerms
relatedTermsDecoder =
    Json.Decode.succeed RelatedTerms
        |> maybeDecode "id" Json.Decode.string Nothing
        |> maybeDecode "related_term_count" Json.Decode.int Nothing
        |> maybeDecode "related_terms_list" (Json.Decode.list relatedTermsRelatedTermsListItemsDecoder) Nothing


relatedTermsRelatedTermsListItemsDecoder : Json.Decode.Decoder RelatedTermsRelatedTermsListItems
relatedTermsRelatedTermsListItemsDecoder =
    Json.Decode.succeed RelatedTermsRelatedTermsListItems
        |> maybeDecode "related_terms" (Json.Decode.list Json.Decode.string) Nothing
        |> maybeDecode "term" Json.Decode.string Nothing


reportTypeDecoder : Json.Decode.Decoder ReportType
reportTypeDecoder =
    Json.Decode.string
        |> Json.Decode.andThen
            (\value ->
                case value of
                    "SYNC" ->
                        Json.Decode.succeed ReportTypeSYNC

                    "ASYNC" ->
                        Json.Decode.succeed ReportTypeASYNC

                    other ->
                        Json.Decode.fail <| "Unknown type: " ++ other
            )


