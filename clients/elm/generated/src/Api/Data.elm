        "AGE_BUCKET" ->
            Json.Decode.map TargetingSpecOperationsTargetingSpecOperationAgeBucket targetingSpecOperationAgeBucketDecoder

        "APPTYPE" ->
            Json.Decode.map TargetingSpecOperationsTargetingSpecOperationAppType targetingSpecOperationAppTypeDecoder

