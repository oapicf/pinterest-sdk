            Json.Decode.map TargetingSpecOperationsTargetingSpecOperationAudienceExclude targetingSpecOperationAudienceExcludeDecoder

        "AUDIENCE_INCLUDE" ->
            Json.Decode.map TargetingSpecOperationsTargetingSpecOperationAudienceInclude targetingSpecOperationAudienceIncludeDecoder

        "GENDER" ->
            Json.Decode.map TargetingSpecOperationsTargetingSpecOperationGender targetingSpecOperationGenderDecoder

        "GEO" ->
            Json.Decode.map TargetingSpecOperationsTargetingSpecOperationGeo targetingSpecOperationGeoDecoder

        "GEO_EXCLUDE" ->
            Json.Decode.map TargetingSpecOperationsTargetingSpecOperationGeoExclude targetingSpecOperationGeoExcludeDecoder

        "INTEREST" ->
            Json.Decode.map TargetingSpecOperationsTargetingSpecOperationInterest targetingSpecOperationInterestDecoder

        "LOCALE" ->
            Json.Decode.map TargetingSpecOperationsTargetingSpecOperationLocale targetingSpecOperationLocaleDecoder

        "LOCATION" ->
            Json.Decode.map TargetingSpecOperationsTargetingSpecOperationLocation targetingSpecOperationLocationDecoder

        "LOCATION_EXCLUDE" ->
            Json.Decode.map TargetingSpecOperationsTargetingSpecOperationLocationExclude targetingSpecOperationLocationExcludeDecoder

        "MAXIMUM_AGE" ->
            Json.Decode.map TargetingSpecOperationsTargetingSpecOperationMaximumAge targetingSpecOperationMaximumAgeDecoder

        "MINIMUM_AGE" ->
            Json.Decode.map TargetingSpecOperationsTargetingSpecOperationMinimumAge targetingSpecOperationMinimumAgeDecoder

        "SHOPPING_RETARGETING" ->
            Json.Decode.map TargetingSpecOperationsTargetingSpecOperationShoppingRetargeting targetingSpecOperationShoppingRetargetingDecoder

        _ ->
            Json.Decode.fail <| "Trying to decode TargetingSpecOperations, but field '" ++ tag ++ "' is not supported."



